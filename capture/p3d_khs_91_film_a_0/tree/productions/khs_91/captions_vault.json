{
 "G_CAP_01": "\u05d5\u05d6\u05d4 \u05d4\u05e2\u05d5\u05e0\u05e9. \u05d5\u05d6\u05d4 \u05d1\u05d6\u05e2\u05ea \u05d0\u05e4\u05da \u05ea\u05d0\u05db\u05dc \u05dc\u05d7\u05dd. \u05d4\u05dc\u05db\u05ea \u05d1\u05d4\u05e1\u05ea\u05e8 \u05e4\u05e0\u05d9\u05dd,",
 "G_CAP_04": "\u05dc\u05d0 \u05e8\u05e6\u05d9\u05ea \u05e9\u05d4\u05de\u05dc\u05d0\u05db\u05d9\u05dd \u05d9\u05e6\u05dc\u05d5 \u05dc\u05da \u05d0\u05ea \u05d4\u05d1\u05e9\u05e8, \u05d1\u05d1\u05e7\u05e9\u05d4, \u05ea\u05ea\u05d7\u05d9\u05dc \u05dc\u05e2\u05d1\u05d5\u05d3.",
 "G_CAP_07": "\u05d6\u05d4 \u05de\u05e2\u05e0\u05d9\u05d9\u05df, \u05e9\u05d4\u05e4\u05e1\u05d5\u05e7 \u05d4\u05d6\u05d4, \u05d1\u05d6\u05e2\u05ea \u05d0\u05e4\u05da \u05ea\u05d0\u05db\u05dc \u05dc\u05d7\u05dd, \u05d6\u05d4 \u05d4\u05e0\u05d7\u05de\u05d4. \u05e9\u05dd \u05db\u05ea\u05d5\u05d1 \u05d1\u05d2\u05de\u05e8\u05d0 \u05d1\u05e4\u05e1\u05d7\u05d9\u05dd,",
 "G_CAP_12": "\u05d4\u05d5\u05d0 \u05d0\u05de\u05e8: \u05d0\u05e0\u05d9 \u05d5\u05d7\u05de\u05d5\u05e8\u05d9 \u05e0\u05d0\u05db\u05dc \u05d1\u05d0\u05d1\u05d5\u05e1? \u05d0\u05de\u05e8 \u05dc\u05d5: \u05d1\u05d6\u05e2\u05ea \u05d0\u05e4\u05da \u05ea\u05d0\u05db\u05dc \u05dc\u05d7\u05dd.",
 "G_CAP_16": "\u05d0\u05d4, \u05e0\u05e8\u05d2\u05e2. \u05de\u05d4 \u05d4\u05d5\u05d0 \u05e9\u05de\u05d7 \u05e2\u05dc \u05d6\u05d4? \u05d0\u05dd \u05d0\u05ea\u05d4 \u05d0\u05d5\u05de\u05e8 \u05dc\u05d9 \u05e9\u05d0\u05e0\u05d9",
 "G_CAP_19": "\u05e6\u05e8\u05d9\u05da \u05dc\u05d0\u05db\u05d5\u05dc \u05db\u05de\u05d5 \u05d1\u05d4\u05de\u05d4, \u05d1\u05d4\u05de\u05d4 \u05dc\u05d0 \u05e2\u05d5\u05e9\u05d4 \u05dc\u05d7\u05dd. \u05d0\u05d6 \u05d4\u05d5\u05d0 \u05e0\u05ea\u05df \u05dc\u05e0\u05d5 \u05d0\u05ea \u05d4\u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05dc\u05ea\u05e7\u05df,",
 "G_CAP_23": "\u05e2\u05dc \u05d9\u05d3\u05d9 \u05e9\u05d1\u05d6\u05e2\u05ea \u05d0\u05e4\u05da \u05ea\u05d0\u05db\u05dc \u05dc\u05d7\u05dd. \u05d6\u05d4 \u05de\u05d4 \u05e9\u05d3\u05d9\u05d1\u05e8\u05e0\u05d5, \u05e9\u05d4\u05e8\u05de\u05d7\"\u05dc \u05de\u05e1\u05d1\u05d9\u05e8, \u05e9\u05d4\u05ea\u05d9\u05e7\u05d5\u05df \u05e9\u05dc\u05e0\u05d5 \u05d6\u05d4 \u05d4\u05e4\u05d5\u05da:",
 "G_CAP_27": "\u05dc\u05d4\u05ea\u05e2\u05e1\u05e7 \u05e2\u05dd \u05d4\u05e2\u05d5\u05dc\u05dd \u05d4\u05d6\u05d4, \u05d0\u05d1\u05dc \u05dc\u05d4\u05ea\u05e2\u05e1\u05e7 \u05d0\u05d9\u05ea\u05d5 - \u05dc\u05e8\u05d5\u05de\u05dd \u05d0\u05d5\u05ea\u05d5. \u05dc\u05db\u05e1\u05d5\u05e1 \u05d7\u05d9\u05d8\u05d9\u05dd - \u05dc\u05db\u05df \u05d1\u05e8\u05db\u05ea\u05d5",
 "G_CAP_30": "\u05d0\u05d3\u05de\u05d4, \u05db\u05d9 \u05d6\u05d4 \u05de\u05d0\u05db\u05dc \u05d1\u05d4\u05de\u05d4. \u05d0\u05ea\u05d4 \u05e6\u05e8\u05d9\u05da \u05d0\u05ea \u05d4\u05d7\u05d9\u05d8\u05d9\u05dd \u05dc\u05e2\u05d1\u05d5\u05d3",
 "G_CAP_32": "\u05e2\u05dc\u05d9\u05d4, \u05dc\u05d8\u05d7\u05d5\u05df \u05d0\u05d5\u05ea\u05d4. \u05d0\u05d6 \u05d4\u05e4\u05ea \u05d6\u05d4 \u05db\u05d0\u05d9\u05dc\u05d5 \u05d4\u05e8\u05de\u05ea \u05d0\u05ea \u05d4\u05d7\u05d9\u05d8\u05d4 \u05e9\u05dc \u05d1\u05d4\u05de\u05d4 \u05dc\u05de\u05d0\u05db\u05dc \u05d0\u05d3\u05dd.",
 "G_CAP_35": "\u05d6\u05d0\u05ea \u05d0\u05d5\u05de\u05e8\u05ea, \u05d0\u05ea\u05d4 \u05ea\u05ea\u05e7\u05df \u05d0\u05ea \u05d4\u05e7\u05dc\u05e7\u05d5\u05dc \u05e9\u05dc\u05da, \u05e9\u05ea\u05ea\u05d0\u05de\u05e5 \u05d5\u05ea\u05d2\u05d9\u05e2 \u05dc\u05d3\u05e8\u05d2\u05d4 \u05e9\u05dc \u05dc\u05d7\u05dd. \u05d5\u05dc\u05d7\u05dd \u05d6\u05d4 \u05de\u05d0\u05db\u05dc \u05e9\u05dc \u05d0\u05d3\u05dd."
}
