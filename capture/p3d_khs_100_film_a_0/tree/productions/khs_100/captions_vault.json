{
 "G_CAP_01": "\u05d4\u05d5\u05d0 \u05de\u05dc\u05da, \u05dc\u05d0 \u05e6\u05e8\u05d9\u05da \u05d0\u05e3 \u05d0\u05d7\u05d3, \u05d0\u05e9\u05e8 \u05de\u05dc\u05da \u05d1\u05d8\u05e8\u05dd \u05db\u05dc \u05d9\u05e6\u05d9\u05e8 \u05e0\u05d1\u05e8\u05d0, \u05d0\u05d1\u05dc \u05d4\u05d5\u05d0 \u05d4\u05e2\u05de\u05d9\u05d3",
 "G_CAP_04": "\u05d0\u05ea \u05d4\u05d1\u05e8\u05d9\u05d0\u05d4 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05db\u05d6\u05d0\u05ea \u05e9\u05d4\u05d5\u05d0 \u05d6\u05e7\u05d5\u05e7 \u05dc\u05e0\u05d5. \u05d0\u05d9\u05df \u05de\u05dc\u05da \u05d1\u05dc\u05d0 \u05e2\u05dd.",
 "G_CAP_07": "\u05d0\u05e0\u05d9 \u05e8\u05d5\u05e6\u05d4 \u05d9\u05e6\u05d5\u05e8\u05d9\u05dd \u05d1\u05e2\u05dc\u05d9 \u05d1\u05d7\u05d9\u05e8\u05d4,",
 "G_CAP_08": "\u05d1\u05e2\u05dc\u05d9 \u05e6\u05d3 \u05de\u05e8\u05d9\u05d3\u05d4. \u05d0\u05dd \u05d4\u05dd \u05dc\u05d0 \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05de\u05e8\u05d5\u05d3 \u05d1\u05d9, \u05d0\u05d9\u05df \u05e9\u05d5\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea",
 "G_CAP_11": "\u05dc\u05d6\u05d4 \u05e9\u05de\u05de\u05dc\u05d9\u05db\u05d9\u05dd \u05d0\u05d5\u05ea\u05d5. \u05d0\u05dd \u05d4\u05dd \u05e8\u05d5\u05d1\u05d5\u05d8\u05d9\u05dd, \u05dc\u05d0 \u05e6\u05e8\u05d9\u05da \u05d0\u05d5\u05ea\u05dd. \u05db\u05dc \u05d4\u05d1\u05e2\u05dc\u05d9",
 "G_CAP_14": "\u05d7\u05d9\u05d9\u05dd \u05d5\u05db\u05dc \u05d4\u05d3\u05d5\u05de\u05dd, \u05d4\u05dd \u05dc\u05d0 \u05d6\u05d6\u05d9\u05dd \u05de\u05d9\u05dc\u05d9\u05de\u05d8\u05e8 \u05de\u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05e9\u05dc\u05d4\u05dd.",
 "G_CAP_17": "\u05d0\u05e0\u05d9 \u05e8\u05d5\u05e6\u05d4 \u05d9\u05e6\u05d5\u05e8 \u05e9\u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d9\u05d5\u05ea \u05e9\u05e7\u05e8\u05df. \u05e9\u05d0\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e1\u05d5\u05d1\u05d1 \u05d0\u05ea \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea",
 "G_CAP_20": "\u05dc\u05e4\u05d9 \u05de\u05d4 \u05e9\u05d0\u05e0\u05d9 \u05e8\u05d5\u05e6\u05d4 \u05e9\u05d6\u05d4 \u05d9\u05d4\u05d9\u05d4, \u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d6\u05d4 \u05dc\u05d0 \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05d4\u05d0\u05de\u05d9\u05ea\u05d9\u05ea.",
 "G_CAP_23": "\u05d0\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e8\u05d0\u05d5\u05ea \u05d0\u05ea \u05d4\u05e7\u05d3\u05d5\u05e9 \u05d1\u05e8\u05d5\u05da \u05d4\u05d5\u05d0 \u05d1\u05e2\u05d5\u05dc\u05dd, \u05d1\u05d1\u05e8\u05d9\u05d0\u05d4, \u05d0\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e8\u05d0\u05d5\u05ea \u05d8\u05d1\u05e2",
 "G_CAP_26": "\u05e0\u05e4\u05dc\u05d0, \u05d5\u05dc\u05d4\u05d2\u05d9\u05d3: \u05de\u05e7\u05e8\u05d4.",
 "CAP_01": "\u05d4\u05d5\u05d0 \u05de\u05dc\u05da, \u05dc\u05d0 \u05e6\u05e8\u05d9\u05da \u05d0\u05e3",
 "CAP_02": "\u05d0\u05d7\u05d3, \u05d0\u05e9\u05e8 \u05de\u05dc\u05da \u05d1\u05d8\u05e8\u05dd \u05db\u05dc",
 "CAP_03": "\u05d9\u05e6\u05d9\u05e8 \u05e0\u05d1\u05e8\u05d0, \u05d0\u05d1\u05dc \u05d4\u05d5\u05d0 \u05d4\u05e2\u05de\u05d9\u05d3",
 "CAP_04": "\u05d0\u05ea \u05d4\u05d1\u05e8\u05d9\u05d0\u05d4 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05db\u05d6\u05d0\u05ea",
 "CAP_05": "\u05e9\u05d4\u05d5\u05d0 \u05d6\u05e7\u05d5\u05e7 \u05dc\u05e0\u05d5.",
 "CAP_06": "\u05d0\u05d9\u05df \u05de\u05dc\u05da \u05d1\u05dc\u05d0 \u05e2\u05dd.",
 "CAP_07": "\u05d0\u05e0\u05d9 \u05e8\u05d5\u05e6\u05d4 \u05d9\u05e6\u05d5\u05e8\u05d9\u05dd \u05d1\u05e2\u05dc\u05d9 \u05d1\u05d7\u05d9\u05e8\u05d4,",
 "CAP_08": "\u05d1\u05e2\u05dc\u05d9 \u05e6\u05d3 \u05de\u05e8\u05d9\u05d3\u05d4. \u05d0\u05dd \u05d4\u05dd",
 "CAP_09": "\u05dc\u05d0 \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05de\u05e8\u05d5\u05d3 \u05d1\u05d9,",
 "CAP_10": "\u05d0\u05d9\u05df \u05e9\u05d5\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea",
 "CAP_11": "\u05dc\u05d6\u05d4 \u05e9\u05de\u05de\u05dc\u05d9\u05db\u05d9\u05dd \u05d0\u05d5\u05ea\u05d5.",
 "CAP_12": "\u05d0\u05dd \u05d4\u05dd \u05e8\u05d5\u05d1\u05d5\u05d8\u05d9\u05dd,",
 "CAP_13": "\u05dc\u05d0 \u05e6\u05e8\u05d9\u05da \u05d0\u05d5\u05ea\u05dd. \u05db\u05dc \u05d4\u05d1\u05e2\u05dc\u05d9",
 "CAP_14": "\u05d7\u05d9\u05d9\u05dd \u05d5\u05db\u05dc \u05d4\u05d3\u05d5\u05de\u05dd,",
 "CAP_15": "\u05d4\u05dd \u05dc\u05d0 \u05d6\u05d6\u05d9\u05dd",
 "CAP_16": "\u05de\u05d9\u05dc\u05d9\u05de\u05d8\u05e8 \u05de\u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05e9\u05dc\u05d4\u05dd.",
 "CAP_17": "\u05d0\u05e0\u05d9 \u05e8\u05d5\u05e6\u05d4 \u05d9\u05e6\u05d5\u05e8",
 "CAP_18": "\u05e9\u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d9\u05d5\u05ea \u05e9\u05e7\u05e8\u05df.",
 "CAP_19": "\u05e9\u05d0\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e1\u05d5\u05d1\u05d1 \u05d0\u05ea \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea",
 "CAP_20": "\u05dc\u05e4\u05d9 \u05de\u05d4 \u05e9\u05d0\u05e0\u05d9 \u05e8\u05d5\u05e6\u05d4 \u05e9\u05d6\u05d4",
 "CAP_21": "\u05d9\u05d4\u05d9\u05d4, \u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d6\u05d4",
 "CAP_22": "\u05dc\u05d0 \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05d4\u05d0\u05de\u05d9\u05ea\u05d9\u05ea.",
 "CAP_23": "\u05d0\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e8\u05d0\u05d5\u05ea \u05d0\u05ea \u05d4\u05e7\u05d3\u05d5\u05e9",
 "CAP_24": "\u05d1\u05e8\u05d5\u05da \u05d4\u05d5\u05d0 \u05d1\u05e2\u05d5\u05dc\u05dd, \u05d1\u05d1\u05e8\u05d9\u05d0\u05d4,",
 "CAP_25": "\u05d0\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e8\u05d0\u05d5\u05ea \u05d8\u05d1\u05e2",
 "CAP_26": "\u05e0\u05e4\u05dc\u05d0, \u05d5\u05dc\u05d4\u05d2\u05d9\u05d3: \u05de\u05e7\u05e8\u05d4.",
 "LBL_A": "\u05de\u05dc\u05da",
 "LBL_B": "\u05d0\u05d9\u05df \u05de\u05dc\u05da \u05d1\u05dc\u05d0 \u05e2\u05dd",
 "LBL_C": "\u05d1\u05d7\u05d9\u05e8\u05d4",
 "LBL_D": "\u05e8\u05d5\u05d1\u05d5\u05d8\u05d9\u05dd",
 "LBL_E": "\u05dc\u05d0 \u05d6\u05d6\u05d9\u05dd \u05de\u05d9\u05dc\u05d9\u05de\u05d8\u05e8",
 "LBL_F": "\u05d8\u05d1\u05e2 \u05e0\u05e4\u05dc\u05d0",
 "LBL_G": "\u05de\u05e7\u05e8\u05d4?",
 "LBL_H": "\u05e2\u05dd"
}