{
 "G_CAP_01": "\u05d0\u05ea\u05dd \u05e8\u05d5\u05d0\u05d9\u05dd \u05e4\u05d4, \u05e9\u05db\u05dc \u05de\u05e2\u05e9\u05d4 \u05e9\u05d0\u05ea\u05dd \u05e2\u05d5\u05e9\u05d9\u05dd, \u05d9\u05e9 \u05dc\u05d5 \u05d4\u05e9\u05e4\u05e2\u05d4 \u05e2\u05d5\u05dc\u05de\u05d9\u05ea. \u05d9\u05e9 \u05db\u05d5\u05d7 \u05d1\u05e2\u05d1\u05d9\u05e8\u05d4 \u05dc\u05d4\u05d7\u05e8\u05d9\u05d1 \u05e2\u05d5\u05dc\u05dd.",
 "G_CAP_05": "\u05d0\u05d6 \u05d1\u05d0\u05d5\u05ea\u05d5 \u05d3\u05d1\u05e8, \u05e6\u05d3 \u05e9\u05e0\u05d9: \u05d9\u05e9 \u05db\u05d5\u05d7 \u05d1\u05de\u05e6\u05d5\u05d5\u05d4 \u05dc\u05d4\u05d7\u05d9\u05d5\u05ea \u05d0\u05ea \u05d4\u05e2\u05d5\u05dc\u05dd.",
 "G_CAP_08": "\u05e9\u05dd \u05d0\u05d5\u05ea\u05e0\u05d5 \u05e9\u05d5\u05ea\u05e4\u05d9\u05dd \u05d0\u05d9\u05ea\u05d5, \u05de\u05de\u05e9, \u05d1\u05e7\u05d9\u05d5\u05dd \u05e9\u05dc \u05db\u05dc \u05d4\u05e2\u05d5\u05dc\u05dd \u05db\u05d5\u05dc\u05d5.",
 "G_CAP_10": "\u05d3\u05d1\u05e8 \u05de\u05d3\u05d4\u05d9\u05dd. \u05e6\u05e8\u05d9\u05da \u05dc\u05d7\u05d6\u05d5\u05e8 \u05e2\u05dc \u05d6\u05d4 \u05d4\u05e8\u05d1\u05d4 \u05d4\u05e8\u05d1\u05d4, \u05d1\u05e9\u05d1\u05d9\u05dc \u05e9\u05e0\u05e8\u05d2\u05d9\u05e9 \u05d0\u05d7\u05e8\u05d9\u05d5\u05ea."
}
