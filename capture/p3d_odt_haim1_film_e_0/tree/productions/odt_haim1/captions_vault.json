{
 "TITLE_A": "\u05e1\u05d3\u05e0\u05d4 \u05e9\u05de\u05d5\u05e9\u05db\u05ea",
 "KICKER_A": "\u05e7\u05d5\u05e8\u05e1 ODT \u00b7 \u05d4\u05de\u05e4\u05d2\u05e9 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df",
 "CAP_A_01": "\u05e7\u05d5\u05e8\u05e1 ODT, \u05d4\u05de\u05e4\u05d2\u05e9 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df: \u05d0\u05d9\u05da \u05d1\u05d5\u05e0\u05d9\u05dd \u05e1\u05d3\u05e0\u05d4.",
 "CAP_A_02": "\u05d4\u05de\u05e0\u05d7\u05d4: \u05d7\u05d9\u05d9\u05dd \u05db\u05e5, \u05de\u05e8\u05db\u05d6 \u05d2\u05d9\u05e9\u05d4.",
 "CAP_A_03": "\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d3\u05d7\u05d5\u05e3 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e7\u05d3\u05d9\u05de\u05d4 \u2014",
 "CAP_A_04": "\u05d5\u05d0\u05d6 \u05d4\u05dd \u05e0\u05e2\u05e6\u05e8\u05d9\u05dd, \u05d5\u05de\u05ea\u05e0\u05d2\u05d3\u05d9\u05dd.",
 "CAP_A_05": "\u05d5\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05d6\u05de\u05d9\u05df: \u05dc\u05d1\u05e0\u05d5\u05ea \u05d3\u05e8\u05da \u05d1\u05d8\u05d5\u05d7\u05d4 \u05d5\u05de\u05e1\u05e7\u05e8\u05e0\u05ea,",
 "CAP_A_06": "\u05e9\u05d4\u05e7\u05d1\u05d5\u05e6\u05d4 \u05e8\u05d5\u05e6\u05d4 \u05dc\u05dc\u05db\u05ea \u05d1\u05d4 \u05de\u05e2\u05e6\u05de\u05d4.",
 "TITLE_B": "\u05e9\u05de\u05d5\u05e0\u05ea \u05d4\u05e9\u05dc\u05d1\u05d9\u05dd",
 "KICKER_B": "\u05d7\u05dc\u05e7 \u05d0'",
 "CAP_B_01": "\u05db\u05dc \u05e1\u05d3\u05e0\u05d4 \u05d8\u05d5\u05d1\u05d4 \u05e2\u05d5\u05d1\u05e8\u05ea \u05d1\u05e9\u05de\u05d5\u05e0\u05d4 \u05ea\u05d7\u05e0\u05d5\u05ea.",
 "CAP_B_02": "\u05dc\u05db\u05dc \u05ea\u05d7\u05e0\u05d4 \u05d9\u05e9 \u05ea\u05e4\u05e7\u05d9\u05d3.",
 "CAP_B_03": "1. \u05d7\u05d9\u05d1\u05d5\u05e8: \u05d0\u05de\u05d5\u05df \u05d1\u05de\u05e0\u05d7\u05d4, \u05d4\u05d9\u05db\u05e8\u05d5\u05ea, \u05d5\u05dc\u05e1\u05e4\u05e8 \u05de\u05d4 \u05d9\u05e7\u05e8\u05d4 \u05d4\u05d9\u05d5\u05dd.",
 "CAP_B_04": "2. \u05d4\u05e4\u05e9\u05e8\u05ea \u05e7\u05e8\u05d7: \u05dc\u05d4\u05d5\u05e8\u05d9\u05d3 \u05de\u05ea\u05d7. \u05e2\u05d3 \u05e9\u05d1\u05e2 \u05d3\u05e7\u05d5\u05ea \u2014 \u05d5\u05d0\u05dd \u05dc\u05d0 \u05e2\u05d5\u05d1\u05d3, \u05e2\u05d5\u05d1\u05e8\u05d9\u05dd \u05d4\u05dc\u05d0\u05d4.",
 "CAP_B_05": "3. \u05de\u05de\u05dc\u05d0 \u05d0\u05e0\u05e8\u05d2\u05d9\u05d4: \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05d0\u05ea \u05d4\u05e7\u05e6\u05d1.",
 "CAP_B_06": "4. \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d8\u05e8\u05d5\u05dd\u05be\u05de\u05e8\u05db\u05d6\u05d9\u05ea: \u05dc\u05e8\u05d0\u05d5\u05ea \u05de\u05d9 \u05de\u05d5\u05d1\u05d9\u05dc, \u05de\u05d9 \u05de\u05e9\u05ea\u05ea\u05e3, \u05d5\u05d0\u05d9\u05da \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4 \u05e2\u05d5\u05d1\u05d3\u05ea.",
 "CAP_B_07": "5. \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea: \u05dc\u05d1 \u05d4\u05e1\u05d3\u05e0\u05d4, \u05db\u05e2\u05e9\u05e8\u05d9\u05dd \u05d3\u05e7\u05d5\u05ea.",
 "CAP_B_08": "6. \u05de\u05e9\u05d7\u05e7 \u05e1\u05d9\u05d5\u05dd: \u05db\u05d9\u05e3 \u05d5\u05d7\u05d9\u05d1\u05d5\u05e8 \u2014 \u05d1\u05dc\u05d9 \u05de\u05e4\u05e1\u05d9\u05d3\u05d9\u05dd.",
 "CAP_B_09": "7. \u05e2\u05d9\u05d1\u05d5\u05d3: \u05de\u05d4 \u05e7\u05e8\u05d4 \u05db\u05d0\u05df, \u05d5\u05de\u05d4 \u05dc\u05de\u05d3\u05e0\u05d5.",
 "CAP_B_10": "8. \u05e1\u05d2\u05d9\u05e8\u05d4: \u05dc\u05e1\u05d9\u05d9\u05dd \u05d9\u05d7\u05d3, \u05d1\u05e8\u05d2\u05e2 \u05de\u05e9\u05d5\u05ea\u05e3.",
 "CAP_B_11": "\u05d5\u05d1\u05db\u05dc \u05ea\u05d7\u05e0\u05d4 \u2014 \u05dc\u05e9\u05d0\u05d5\u05dc: \u05de\u05d4 \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05e9\u05dc\u05d4 \u05d1\u05e8\u05e6\u05e3?",
 "TITLE_C": "\u05de\u05e9\u05d7\u05e7\u05d9\u05dd \u05de\u05d4\u05e9\u05d9\u05e2\u05d5\u05e8",
 "KICKER_C": "\u05d7\u05dc\u05e7 \u05d1'",
 "CAP_C_01": "\u05de\u05e2\u05d2\u05dc \u05d4\u05d3\u05d9\u05dc\u05d5\u05d2: \u05de\u05d7\u05d6\u05d9\u05e7\u05d9\u05dd \u05d9\u05d3\u05d9\u05d9\u05dd, \u05d5\u05de\u05d3\u05dc\u05d2\u05d9\u05dd \u2014 \u05d0\u05d7\u05d3, \u05e9\u05e0\u05d9\u05d9\u05dd, \u05e9\u05dc\u05d5\u05e9\u05d4, \u05d0\u05e8\u05d1\u05e2\u05d4.",
 "CAP_C_02": "\u05db\u05dc \u05e1\u05d1\u05d1 \u05e7\u05e6\u05ea \u05d9\u05d5\u05ea\u05e8 \u05e7\u05e9\u05d4. \u05de\u05d5\u05e9\u05dc\u05dd \u05dc\u05d4\u05e4\u05e9\u05e8\u05ea \u05e7\u05e8\u05d7.",
 "CAP_C_03": "\u05de\u05e7\u05dc \u05d4\u05dc\u05d9\u05d5\u05dd: \u05db\u05d5\u05dc\u05dd \u05ea\u05d5\u05de\u05db\u05d9\u05dd \u05d1\u05de\u05e7\u05dc \u05d1\u05d0\u05e6\u05d1\u05e2 \u05d0\u05d7\u05ea, \u05d5\u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05dc\u05d4\u05d5\u05e8\u05d9\u05d3 \u05d0\u05d5\u05ea\u05d5 \u05d9\u05d7\u05d3 \u05dc\u05e8\u05e6\u05e4\u05d4.",
 "CAP_C_04": "\u05e0\u05e9\u05de\u05e2 \u05e7\u05dc. \u05d1\u05e4\u05d5\u05e2\u05dc \u05d4\u05de\u05e7\u05dc \u05e2\u05d5\u05dc\u05d4 \u05dc\u05de\u05e2\u05dc\u05d4.",
 "CAP_C_05": "\u05db\u05d0\u05df \u05e8\u05d5\u05d0\u05d9\u05dd \u05d0\u05ea \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4: \u05de\u05d9 \u05de\u05d5\u05d1\u05d9\u05dc, \u05de\u05d9 \u05e9\u05d5\u05ea\u05e7, \u05de\u05d9 \u05de\u05e9\u05d7\u05e8\u05e8.",
 "CAP_C_06": "\u05de\u05ea\u05d7\u05dc\u05e7\u05d9\u05dd \u05dc\u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05dc\u05e4\u05d9 \u05de\u05e1\u05e4\u05e8 \u05e9\u05db\u05dc \u05d0\u05d7\u05d3 \u05d1\u05d7\u05e8. \u05d1\u05e4\u05e2\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u2014 \u05d1\u05dc\u05d2\u05df.",
 "CAP_C_07": "\u05e2\u05e6\u05e8\u05e0\u05d5 \u05d5\u05e9\u05d0\u05dc\u05e0\u05d5: \u05de\u05d4 \u05dc\u05d0 \u05e2\u05d1\u05d3?",
 "CAP_C_08": "\u05de\u05e9\u05ea\u05ea\u05e3 \u05d4\u05e6\u05d9\u05e2: \u05d0\u05e8\u05d1\u05e2 \u05e4\u05d9\u05e0\u05d5\u05ea \u05dc\u05d0\u05e8\u05d1\u05e2\u05d4 \u05de\u05e1\u05e4\u05e8\u05d9\u05dd. \u05d4\u05d9\u05d5 \u05d5\u05d9\u05db\u05d5\u05d7\u05d9\u05dd \u2014 \u05d5\u05d0\u05d6 \u05d6\u05d4 \u05e2\u05d1\u05d3 \u05de\u05d4\u05e8.",
 "CAP_C_09": "\u05d5\u05d0\u05d6 \u05e9\u05d0\u05dc\u05d4 \u05d0\u05d7\u05ea: \u05dc\u05de\u05d4 \u05d1\u05d7\u05e8\u05ea \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d0\u05ea \u05d4\u05de\u05e1\u05e4\u05e8 \u05d4\u05d6\u05d4?",
 "CAP_C_10": "\u05de\u05e9\u05d7\u05e7 \u05d7\u05dc\u05d5\u05e7\u05d4 \u05d4\u05e4\u05da \u05dc\u05e9\u05d9\u05d7\u05d4 \u05d0\u05d9\u05e9\u05d9\u05ea.",
 "CAP_C_11": "\u05de\u05d7\u05d9\u05d0\u05ea \u05db\u05e3: \u05de\u05d5\u05d7\u05d0\u05d9\u05dd \u05e8\u05e7 \u05db\u05e9\u05d4\u05de\u05e0\u05d7\u05d4 \u05d1\u05d0\u05de\u05ea \u05de\u05d5\u05d7\u05d0.",
 "CAP_C_12": "\u05e8\u05d2\u05e2 \u05e9\u05dc \u05e6\u05d7\u05d5\u05e7 \u05de\u05e9\u05d5\u05ea\u05e3, \u05d5\u05e1\u05d5\u05e3 \u05d1\u05d9\u05d7\u05d3.",
 "CAP_C_13": "\u05d5\u05db\u05dc \u05de\u05e9\u05d7\u05e7 \u05db\u05d6\u05d4 \u05d9\u05db\u05d5\u05dc \u05dc\u05e9\u05de\u05e9 \u05d1\u05db\u05de\u05d4 \u05ea\u05d7\u05e0\u05d5\u05ea \u05e9\u05d5\u05e0\u05d5\u05ea.",
 "TITLE_D": "\u05d0\u05d9\u05da \u05de\u05e0\u05d7\u05d9\u05dd \u05de\u05e9\u05d7\u05e7",
 "KICKER_D": "\u05d7\u05dc\u05e7 \u05d2'",
 "CAP_D_01": "\u05db\u05dc \u05de\u05e9\u05d7\u05e7 \u05e2\u05d5\u05d1\u05e8 \u05de\u05d7\u05d6\u05d5\u05e8: \u05de\u05e9\u05d7\u05e7\u05d9\u05dd, \u05d1\u05d5\u05d3\u05e7\u05d9\u05dd, \u05dc\u05d5\u05de\u05d3\u05d9\u05dd \u2014",
 "CAP_D_02": "\u05d5\u05de\u05e0\u05e1\u05d9\u05dd \u05e9\u05d5\u05d1.",
 "CAP_D_03": "\u05de\u05e6\u05d9\u05d2\u05d9\u05dd \u05de\u05e9\u05d7\u05e7 \u05d1\u05e9\u05dc\u05d5\u05e9\u05d4 \u05d3\u05d1\u05e8\u05d9\u05dd: \u05e9\u05dd, \u05de\u05d8\u05e8\u05d4, \u05d5\u05ea\u05d5\u05db\u05df.",
 "CAP_D_04": "\u05de\u05e2\u05d1\u05e8 \u05d1\u05d9\u05df \u05de\u05e9\u05d7\u05e7\u05d9\u05dd \u2014 \u05db\u05de\u05d5 \u05d4\u05d6\u05de\u05e0\u05d4, \u05dc\u05d0 \u05db\u05de\u05d5 \u05e4\u05e7\u05d5\u05d3\u05d4.",
 "CAP_D_05": "\"\u05de\u05d9 \u05e8\u05d5\u05e6\u05d4 \u05dc\u05e8\u05d0\u05d5\u05ea \u05d0\u05dd \u05e0\u05e6\u05dc\u05d9\u05d7 \u05d2\u05dd \u05e2\u05dd \u05e2\u05d9\u05e0\u05d9\u05d9\u05dd \u05e2\u05e6\u05d5\u05de\u05d5\u05ea?\"",
 "CAP_D_06": "\u05de\u05e9\u05d4\u05d5 \u05dc\u05d0 \u05e2\u05d5\u05d1\u05d3? \u05dc\u05d0 \u05e0\u05d0\u05d1\u05e7\u05d9\u05dd. \u05e2\u05d5\u05d1\u05e8\u05d9\u05dd \u05d4\u05dc\u05d0\u05d4.",
 "CAP_D_07": "\u05d2\u05dd \u05de\u05d9 \u05e9\u05d4\u05e4\u05e1\u05d9\u05d3 \u05e0\u05e9\u05d0\u05e8 \u05d1\u05e4\u05e0\u05d9\u05dd: \u05d4\u05d5\u05d0 \u05d4\u05d5\u05e4\u05da \u05dc\u05de\u05e2\u05d5\u05d3\u05d3.",
 "CAP_D_08": "\u05de\u05e9\u05d7\u05e7 \u05d0\u05d7\u05d3, \u05db\u05de\u05d4 \u05ea\u05d7\u05e0\u05d5\u05ea: \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05e0\u05e7\u05d1\u05e2 \u05dc\u05e4\u05d9 \u05d4\u05d6\u05de\u05df \u05d5\u05dc\u05e4\u05d9 \u05de\u05d4 \u05e9\u05d1\u05d0 \u05d0\u05d7\u05e8\u05d9\u05d5.",
 "TITLE_E": "\u05e2\u05d3 \u05d4\u05de\u05e4\u05d2\u05e9 \u05d4\u05d1\u05d0",
 "KICKER_E": "\u05d7\u05dc\u05e7 \u05d3'",
 "RECAP_E_1": "\u05e1\u05d3\u05e0\u05d4 \u05d8\u05d5\u05d1\u05d4 \u05de\u05d5\u05e9\u05db\u05ea, \u05dc\u05d0 \u05d3\u05d5\u05d7\u05e4\u05ea.",
 "RECAP_E_2": "\u05e9\u05de\u05d5\u05e0\u05d4 \u05ea\u05d7\u05e0\u05d5\u05ea, \u05d5\u05dc\u05db\u05dc \u05d0\u05d7\u05ea \u05ea\u05e4\u05e7\u05d9\u05d3.",
 "RECAP_E_3": "\u05de\u05e9\u05d7\u05e7\u05d9\u05dd, \u05d1\u05d5\u05d3\u05e7\u05d9\u05dd, \u05dc\u05d5\u05de\u05d3\u05d9\u05dd \u2014 \u05d5\u05de\u05e0\u05e1\u05d9\u05dd \u05e9\u05d5\u05d1.",
 "CAP_E_01": "\u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05e9\u05dc \u05d7\u05d9\u05d9\u05dd: \u05dc\u05e0\u05e1\u05d5\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea \u05d3\u05d1\u05e8 \u05d0\u05d7\u05d3 \u05de\u05db\u05dc \u05de\u05d4 \u05e9\u05e2\u05e9\u05d9\u05e0\u05d5 \u2014",
 "CAP_E_02": "\u05d5\u05dc\u05d4\u05e8\u05d2\u05d9\u05e9 \u05d0\u05ea \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05e9\u05dc\u05e0\u05d5 \u05de\u05d5\u05dc \u05e7\u05d1\u05d5\u05e6\u05d4.",
 "CAP_E_03": "\u05d4\u05de\u05e4\u05d2\u05e9 \u05d4\u05d1\u05d0: \u05d1\u05d7\u05d5\u05d5\u05ea \u05e9\u05de\u05e9\u05d5\u05df. ODT \u05d1\u05e9\u05d8\u05d7."
}
