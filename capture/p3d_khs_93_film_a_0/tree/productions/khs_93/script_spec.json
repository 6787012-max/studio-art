 "production": "khs_93",
 "films": [
  {
   "id": "film_a",
   "title": "",
   "kicker": "",
   "recap": [],
   "shots": [
    {
     "id": "s01",
     "dur": 4.08,
     "captions": [
      {
       "id": "G_CAP_01",
       "text": "לא מדברים על שכר ועונש. שכר ועונש זה ההסבר הפשוט למה עובדים את הקדוש ברוך"
      }
     ]
    },
    {
     "id": "s02",
     "dur": 3.86,
     "captions": [
      {
       "id": "G_CAP_04",
       "text": "הוא. פה יש ממד הרבה יותר גבוה. כל תנועה שלך,"
      }
     ]
    },
    {
     "id": "s03",
     "dur": 4.84,
     "captions": [
      {
       "id": "G_CAP_07",
       "text": "אתה לוחץ על כפתורים בשמיים. כל העולם כולו זז, איך שאתה מזיז את היד."
      }
     ]
    },
    {
     "id": "s04",
     "dur": 6.05,
     "captions": [
      {
       "id": "G_CAP_10",
       "text": "אתה קושר את הנעליים. קודם כל שם ימין, שם שמאל, קושר שמאל, ואחרי זה קושר ימין."
      }
     ]
    },
    {
     "id": "s05",
     "dur": 3.54,
     "captions": [
      {
       "id": "G_CAP_15",
       "text": "מסבירים את זה בפנימיות: אתה שם את הימין, כי ימין זה חסד."
      }
     ]
    },
    {
     "id": "s06",
     "dur": 5.39,
     "captions": [
      {
       "id": "G_CAP_18",
       "text": "אתה מגביר את הימין בעולם, אתה מגביר את החסד בעולם."
      }
     ]
    },
    {
     "id": "s07",
     "dur": 3.91,
     "captions": [
      {
       "id": "G_CAP_20",
       "text": "לכן אתה קושר את השמאל ראשון, כי אתה רוצה לכבול את מידת הדין."
      }
     ]
    },
    {
     "id": "s08",
     "dur": 3.68,
     "captions": [
      {
       "id": "G_CAP_23",
       "text": "אתה אדם. אדם צלם אלוקים, כל תנועה שלו היא משמעותית."
      }
     ]
    },
    {
     "id": "s09",
     "dur": 4.63,
     "captions": [
      {
       "id": "G_CAP_26",
       "text": "אתה שם יד ימין על שמאל, או שמאל על ימין - משמעותי."
      }
     ]
    }
   ]
  }
 ]
}