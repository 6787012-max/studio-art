{
 "TITLE": "\u05de\u05d1\u05d7\u05df \u05d4\u05de\u05de\u05d5\u05df",
 "KICKER": "\u05de\u05d1\u05d7\u05df \u05d4\u05de\u05de\u05d5\u05df",
 "RECAP_1": "\u05d4\u05e8\u05d2\u05dc \u05e7\u05d8\u05df \u05e9\u05d7\u05d5\u05d6\u05e8 \u05e2\u05dc \u05e2\u05e6\u05de\u05d5 \u05d1\u05d5\u05e0\u05d4 \u05d0\u05ea \u05d4\u05e0\u05e4\u05e9",
 "RECAP_2": "\u05d0\u05dc\u05e3 \u05e4\u05e2\u05de\u05d9\u05dd \u05e9\u05dc \u05e0\u05ea\u05d9\u05e0\u05d4 \u05de\u05e8\u05d2\u05d9\u05dc\u05d9\u05dd \u05d0\u05ea \u05d4\u05dc\u05d1 \u05dc\u05e8\u05d7\u05de\u05d9\u05dd",
 "RECAP_3": "\u05d0\u05d9\u05d6\u05d5 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05e7\u05d8\u05e0\u05d4 \u05e9\u05dc \u05d7\u05e1\u05d3 \u05ea\u05e2\u05e9\u05d4 \u05e9\u05d5\u05d1 \u05d5\u05e9\u05d5\u05d1?",
 "CAP_S_01": "\u05e2\u05de\u05dc\u05ea \u05d1\u05d1\u05d9\u05df \u05d4\u05d6\u05de\u05e0\u05d9\u05dd, \u05d5\u05d4\u05e9\u05db\u05e8 \u05d4\u05d5\u05d0 \u05d0\u05d5\u05ea \u05dc\u05d4\u05ea\u05de\u05d3\u05d4",
 "CAP_S_02": "\u05d1\u05d1\u05ea \u05d0\u05d7\u05ea, \u05d0\u05d5 \u05d1\u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd?",
 "CAP_S_03": "\u05d3\u05d1\u05e8 \u05d2\u05d3\u05d5\u05dc \u05db\u05d0\u05df \u05d5\u05e2\u05db\u05e9\u05d9\u05d5, \u05d0\u05d1\u05dc \u05d9\u05e9 \u05e4\u05d9\u05ea\u05d5\u05d9 \u05dc\u05d1\u05d6\u05d1\u05d6 \u05d4\u05db\u05dc \u05de\u05d4\u05e8 \u05de\u05d3\u05d9",
 "CAP_S_04": "\u05dc\u05d5\u05de\u05d3\u05d9\u05dd \u05dc\u05d3\u05d7\u05d5\u05ea \u05e1\u05d9\u05e4\u05d5\u05e7\u05d9\u05dd \u05d5\u05dc\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc \u05d4\u05db\u05e1\u05e3 \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df",
 "CAP_S_05": "\u05d0\u05d1\u05dc \u05e6\u05e8\u05d9\u05da \u05e1\u05d1\u05dc\u05e0\u05d5\u05ea",
 "CAP_S_06": "\u05d5\u05d4\u05db\u05e8\u05d9\u05e2 \u05d4\u05e8\u05de\u05d1\u05f4\u05dd \u05d1\u05e4\u05d9\u05e8\u05d5\u05e9 \u05d4\u05de\u05e9\u05e0\u05d9\u05d5\u05ea \u05dc\u05de\u05e1\u05db\u05ea \u05d0\u05d1\u05d5\u05ea",
 "CAP_S_07": "\u05d0\u05dc\u05e3 \u05e9\u05e7\u05dc\u05d9\u05dd \u05dc\u05e6\u05d3\u05e7\u05d4: \u05e2\u05d3\u05d9\u05e3 \u05e9\u05e7\u05dc \u05dc\u05d0\u05dc\u05e3 \u05e2\u05e0\u05d9\u05d9\u05dd",
 "CAP_S_08": "\u05de\u05d0\u05e9\u05e8 \u05d4\u05db\u05dc \u05dc\u05e2\u05e0\u05d9 \u05d0\u05d7\u05d3",
 "CAP_S_09": "\u05e4\u05e2\u05dd \u05d0\u05d7\u05ea, \u05de\u05e2\u05e9\u05d4 \u05d7\u05e1\u05d3 \u05d0\u05d7\u05d3",
 "CAP_S_10": "\u05d0\u05dc\u05e3 \u05e4\u05e2\u05de\u05d9\u05dd, \u05de\u05e8\u05d2\u05d9\u05dc\u05d9\u05dd \u05d0\u05ea \u05d4\u05dc\u05d1 \u05dc\u05d4\u05d9\u05d5\u05ea \u05e8\u05d7\u05de\u05df \u05d5\u05e0\u05d3\u05d1\u05df",
 "CAP_S_11": "\u05d4\u05d4\u05e8\u05d2\u05dc \u05e9\u05d7\u05d5\u05d6\u05e8 \u05e2\u05dc \u05e2\u05e6\u05de\u05d5 \u05d4\u05d5\u05d0 \u05e9\u05d1\u05d5\u05e0\u05d4 \u05d0\u05ea \u05d4\u05e0\u05e4\u05e9",
 "CAP_S_12": "\u05d5\u05dc\u05e9\u05d5\u05dc\u05d7\u05df \u05d4\u05e9\u05d1\u05ea: \u05d0\u05d9\u05d6\u05d5 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05e7\u05d8\u05e0\u05d4 \u05e9\u05dc \u05d7\u05e1\u05d3 \u05d0\u05e4\u05e9\u05e8 \u05dc\u05e2\u05e9\u05d5\u05ea \u05e9\u05d5\u05d1 \u05d5\u05e9\u05d5\u05d1, \u05d1\u05db\u05dc \u05d9\u05d5\u05dd?",
 "LBL_TXT_01": "\u05e9\u05d9\u05d7 \u05de\u05e2\u05d5\u05e8\u05e8",
 "LBL_TXT_02": "\u05e4\u05e8\u05e9\u05ea \u05e0\u05d7"
}
