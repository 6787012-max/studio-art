{
 "TITLE": "\u05d4\u05e9\u05d1 \u05ea\u05e9\u05d9\u05d1\u05dd",
 "KICKER": "\u05d0\u05e4\u05d9\u05dc\u05d5 \u05de\u05d0\u05d4 \u05e4\u05e2\u05de\u05d9\u05dd \u2014 \u05d1\u05d1\u05d0 \u05de\u05e6\u05d9\u05e2\u05d0 \u05dc\u2013\u05dc\u05d0",
 "CAP_s02_1": "\u05dc\u05b9\u05d0 \u05ea\u05b4\u05e8\u05b0\u05d0\u05b6\u05d4 \u05d0\u05b6\u05ea \u05e9\u05c1\u05d5\u05b9\u05e8 \u05d0\u05b8\u05d7\u05b4\u05d9\u05da\u05b8 \u05d0\u05d5\u05b9 \u05d0\u05b6\u05ea \u05e9\u05b5\u05c2\u05d9\u05d5\u05b9 \u05e0\u05b4\u05d3\u05b8\u05bc\u05d7\u05b4\u05d9\u05dd \u05d5\u05b0\u05d4\u05b4\u05ea\u05b0\u05e2\u05b7\u05dc\u05b7\u05bc\u05de\u05b0\u05ea\u05b8\u05bc \u05de\u05b5\u05d4\u05b6\u05dd, \u05d4\u05b8\u05e9\u05b5\u05c1\u05d1 \u05ea\u05b0\u05bc\u05e9\u05b4\u05c1\u05d9\u05d1\u05b5\u05dd \u05dc\u05b0\u05d0\u05b8\u05d7\u05b4\u05d9\u05da\u05b8 (\u05d3\u05d1\u05e8\u05d9\u05dd \u05db\u05d1, \u05d0)",
 "CAP_s03_1": "\u05d4\u05de\u05e6\u05d5\u05d5\u05d4: \u05dc\u05d4\u05d7\u05d6\u05d9\u05e8 \u05d0\u05ea \u05d4\u05ea\u05d5\u05e2\u05d4",
 "CAP_s03_2": "\u05de\u05d9 \u05e9\u05e8\u05d5\u05d0\u05d4 \u05e9\u05d5\u05e8 \u05d0\u05d5 \u05e9\u05d4 \u05e9\u05dc \u05d7\u05d1\u05e8\u05d5 \u05ea\u05d5\u05e2\u05d9\u05dd \u2014 \u05dc\u05d0 \u05d9\u05e2\u05d1\u05d5\u05e8 \u05d5\u05d9\u05ea\u05e2\u05dc\u05dd, \u05d0\u05dc\u05d0 \u05d9\u05d7\u05d6\u05d9\u05e8 \u05d0\u05d5\u05ea\u05dd \u05dc\u05d1\u05e2\u05dc\u05d9\u05dd.",
 "CAP_s04_1": "\u05d5\u05de\u05d4 \u05d0\u05dd \u05d4\u05d9\u05d0 \u05d1\u05d5\u05e8\u05d7\u05ea \u05e9\u05d5\u05d1?: \u05d4\u05e9\u05d1 \u2014 \u05ea\u05e9\u05d9\u05d1\u05dd",
 "CAP_s04_2": "\u05d4\u05ea\u05d5\u05e8\u05d4 \u05db\u05e4\u05dc\u05d4 \u05d0\u05ea \u05d4\u05de\u05d9\u05dc\u05d4: \"\u05d4\u05e9\u05d1\" \u05d5\u05d2\u05dd \"\u05ea\u05e9\u05d9\u05d1\u05dd\". \u05de\u05db\u05d0\u05df \u05dc\u05d5\u05de\u05d3\u05d9\u05dd: \u05d4\u05d7\u05d6\u05e8\u05ea \u05d5\u05d4\u05d9\u05d0 \u05d1\u05e8\u05d7\u05d4 \u05e9\u05d5\u05d1 \u2014 \u05de\u05d7\u05d6\u05d9\u05e8\u05d9\u05dd \u05e9\u05d5\u05d1.",
 "CAP_s05_1": "\u05d4\u05e9\u05e2\u05e8 \u05e0\u05e1\u05d2\u05e8 \u2014 \u05d5\u05d4\u05d7\u05d9\u05d4 \u05e4\u05d5\u05ea\u05d7\u05ea \u05d0\u05ea \u05d4\u05d1\u05e8\u05d9\u05d7",
 "CAP_s05_2": "\u05d5\u05d9\u05d5\u05e6\u05d0\u05ea \u05d4\u05d7\u05d5\u05e6\u05d4",
 "CAP_s06_1": "\u05e9\u05d5\u05d1 \u05d1\u05d5\u05e8\u05d7\u05ea \u2014 \u05d1\u05e2\u05d6\u05e8\u05ea \u05de\u05d2\u05e8\u05e4\u05d4",
 "CAP_s06_2": "\u05d5\u05e9\u05d5\u05d1 \u2014 \u05de\u05d8\u05e4\u05e1\u05ea \u05de\u05e2\u05dc \u05d4\u05e7\u05d9\u05e8",
 "CAP_s07_1": "\u05d4\u05de\u05e9\u05e0\u05d4: \u05d0\u05e8\u05d1\u05e2 \u05d5\u05d7\u05de\u05e9 \u05e4\u05e2\u05de\u05d9\u05dd",
 "CAP_s07_2": "\u05d4\u05d7\u05d6\u05d9\u05e8\u05d4 \u05d5\u05d1\u05e8\u05d7\u05d4, \u05d4\u05d7\u05d6\u05d9\u05e8\u05d4 \u05d5\u05d1\u05e8\u05d7\u05d4 \u2014 \u05d0\u05e4\u05d9\u05dc\u05d5 \u05d0\u05e8\u05d1\u05e2 \u05d5\u05d7\u05de\u05e9 \u05e4\u05e2\u05de\u05d9\u05dd, \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d4\u05d7\u05d6\u05d9\u05e8\u05d4.",
 "CAP_s08_1": "\u05d4\u05db\u05d1\u05e9\u05d4 \u05e7\u05d5\u05e4\u05e6\u05ea \u05de\u05e2\u05dc \u05d4\u05d2\u05d3\u05e8",
 "CAP_s08_2": "\u05d5\u05e9\u05d5\u05d1 \u05d5\u05e9\u05d5\u05d1 \u05e6\u05e8\u05d9\u05da \u05dc\u05d4\u05d7\u05d6\u05d9\u05e8 \u05d0\u05d5\u05ea\u05d4",
 "CAP_s09_1": "\u05e8\u05d1\u05d0: \u05d0\u05e4\u05d9\u05dc\u05d5 \u05de\u05d0\u05d4 \u05e4\u05e2\u05de\u05d9\u05dd!",
 "CAP_s09_2": "\"\u05d4\u05e9\u05d1\" \u2014 \u05d0\u05e4\u05d9\u05dc\u05d5 \u05de\u05d0\u05d4 \u05e4\u05e2\u05de\u05d9\u05dd. \u05d1\u05db\u05dc \u05e4\u05e2\u05dd \u05e9\u05d4\u05d1\u05d4\u05de\u05d4 \u05d1\u05e8\u05d7\u05d4 \u05d5\u05e0\u05de\u05e6\u05d0\u05d4 \u2014 \u05d7\u05d5\u05d6\u05e8\u05ea \u05d4\u05de\u05e6\u05d5\u05d5\u05d4 \u05dc\u05d4\u05d7\u05d6\u05d9\u05e8 \u05d0\u05d5\u05ea\u05d4.",
 "CAP_s10_1": "\u05e4\u05e8\u05d4 \u05d1\u05e8\u05d7\u05d4 \u05d0\u05dc \u05d4\u05db\u05d1\u05d9\u05e9",
 "CAP_s10_2": "\u05d0\u05e0\u05e9\u05d9\u05dd \u05e8\u05e6\u05d9\u05dd \u05dc\u05ea\u05e4\u05d5\u05e1 \u05d0\u05d5\u05ea\u05d4",
 "CAP_s10_3": "\u05d5\u05d4\u05d9\u05d0 \u05d1\u05d5\u05e8\u05d7\u05ea \u05e9\u05d5\u05d1",
 "CAP_s11_1": "\u05d4\u05d7\u05d6\u05e8\u05ea \u05e4\u05e8\u05d4 \u05dc\u05d1\u05e2\u05dc\u05d9\u05d4, \u05d5\u05dc\u05de\u05d7\u05e8\u05ea \u05de\u05e6\u05d0\u05ea \u05d0\u05d5\u05ea\u05d4 \u05e9\u05d5\u05d1 \u05ea\u05d5\u05e2\u05d4 \u05d1\u05e9\u05d3\u05d4. \u05de\u05d4 \u05e2\u05dc\u05d9\u05da \u05dc\u05e2\u05e9\u05d5\u05ea?",
 "CAP_s11_2": "\u05dc\u05d4\u05d7\u05d6\u05d9\u05e8 \u05d0\u05d5\u05ea\u05d4 \u05e9\u05d5\u05d1 \u2014 \"\u05d4\u05e9\u05d1 \u05ea\u05e9\u05d9\u05d1\u05dd\", \u05d0\u05e4\u05d9\u05dc\u05d5 \u05de\u05d0\u05d4 \u05e4\u05e2\u05de\u05d9\u05dd.",
 "CAP_s12_1": "\u05dc\u05de\u05d4 \u05db\u05ea\u05d5\u05d1 \u05d1\u05ea\u05d5\u05e8\u05d4 \u05e4\u05e2\u05de\u05d9\u05d9\u05dd: \"\u05d4\u05e9\u05d1\" \u05d5\u05d2\u05dd \"\u05ea\u05e9\u05d9\u05d1\u05dd\"?",
 "CAP_s12_2": "\u05dc\u05dc\u05de\u05d3 \u05e9\u05d4\u05d4\u05d7\u05d6\u05e8\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05e8\u05e7 \u05e4\u05e2\u05dd \u05d0\u05d7\u05ea: \u05d1\u05e8\u05d7\u05d4 \u05e9\u05d5\u05d1 \u2014 \u05de\u05d7\u05d6\u05d9\u05e8\u05d9\u05dd \u05e9\u05d5\u05d1.",
 "CAP_s13_1": "\u05e8\u05d5\u05d0\u05d9\u05dd \u05d1\u05d4\u05de\u05d4 \u05ea\u05d5\u05e2\u05d4 \u2014 \u05de\u05d7\u05d6\u05d9\u05e8\u05d9\u05dd \u00b7 \u05d1\u05e8\u05d7\u05d4 \u05e9\u05d5\u05d1 \u2014 \u05de\u05d7\u05d6\u05d9\u05e8\u05d9\u05dd \u05e9\u05d5\u05d1",
 "CAP_s13_2": "\u05d4\u05de\u05e9\u05e0\u05d4: \u05d0\u05e4\u05d9\u05dc\u05d5 \u05d0\u05e8\u05d1\u05e2 \u05d5\u05d7\u05de\u05e9 \u05e4\u05e2\u05de\u05d9\u05dd \u00b7 \u05e8\u05d1\u05d0: \u05d0\u05e4\u05d9\u05dc\u05d5 \u05de\u05d0\u05d4 \u05e4\u05e2\u05de\u05d9\u05dd",
 "CAP_s14_1": "\u05e7\u05d8\u05e2\u05d9 \u05d4\u05d4\u05e0\u05e4\u05e9\u05d4: \u05e8\u05f3 \u05d0\u05dc\u05d9 \u05e1\u05d8\u05e4\u05e0\u05e1\u05e7\u05d9 | \u05de\u05e8\u05db\u05d6 \u05d3\u05e3 \u05d9\u05d5\u05de\u05d9 \u00b7 MDY | \u05de\u05e0\u05d2\u05d9\u05e0\u05d4 \u05de\u05e7\u05d5\u05e8\u05d9\u05ea \u00b7 \u05e2\u05e8\u05d9\u05db\u05d4: \u05de\u05db\u05d9\u05e0\u05ea \u05d1\u05d9\u05ea \u05d4\u05ea\u05dc\u05de\u05d5\u05d3"
}