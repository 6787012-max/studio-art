{
 "TITLE": "\u05d6\u05d4 \u05d4\u05e4\u05dc\u05d0 \u05e9\u05d1\u05db\u05dc\u05dc \u05d9\u05e9 \u05e9\u05db\u05e8 \u05d1\u05e2\u05d5\u05dc\u05dd!",
 "CAP_A_01": "\u05db\u05dc \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd \u05e9\u05d5\u05d0\u05dc\u05d9\u05dd: \u05dc\u05de\u05d4 \u05dc\u05d0 \u05e0\u05d6\u05db\u05e8 \u05d4\u05e9\u05db\u05e8 \u05e2\u05d5\u05dc\u05dd \u05d4\u05d1\u05d0 \u05d1\u05ea\u05d5\u05e8\u05d4? \u05d0\u05d6 \u05d4\u05e8\u05de\u05d1\"\u05df \u05d0\u05d5\u05de\u05e8 \u05d6\u05d4 \u05d3\u05d1\u05e8 \u05e4\u05e9\u05d5\u05d8, \u05dc\u05d0 \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05dc\u05db\u05ea\u05d5\u05d1 \u05d0\u05ea \u05d6\u05d4 \u05d1\u05ea\u05d5\u05e8\u05d4.",
 "CAP_A_02": "\u05d4\u05e0\u05d1\u05d9\u05d0\u05d9\u05dd \u05e8\u05e6\u05d5 \u05dc\u05e2\u05d5\u05e8\u05e8 \u05d0\u05d5\u05ea\u05e0\u05d5 \u05dc\u05ea\u05db\u05dc\u05d9\u05ea\u05e0\u05d5, \u05d0\u05d1\u05dc \u05d4\u05ea\u05d5\u05e8\u05d4 \u05dc\u05d0 \u05e6\u05e8\u05d9\u05db\u05d4 \u05dc\u05d3\u05d1\u05e8 \u05e2\u05dc \u05d6\u05d4.",
 "CAP_A_03": "\u05d4\u05ea\u05d5\u05e8\u05d4 \u05de\u05d3\u05d1\u05e8\u05ea \u05e2\u05dc \u05d4\u05d3\u05d1\u05e8\u05d9\u05dd, \u05e2\u05dc \u05d4\u05e6\u05d9\u05d5\u05d5\u05d9\u05d9\u05dd \u05dc\u05e2\u05e9\u05d5\u05ea \u05d1\u05e2\u05d5\u05dc\u05dd \u05d4\u05d6\u05d4. \u05d5\u05d0\u05d5\u05de\u05e8 \u05d4\u05e8\u05de\u05d1\"\u05df \u05d9\u05d5\u05ea\u05e8 \u05de\u05d6\u05d4:",
 "CAP_A_04": "\u05de\u05d4 \u05e9\u05db\u05ea\u05d1\u05d4 \u05e9\u05d9\u05d4\u05d9\u05d4 \u05e9\u05db\u05e8 \u05d1\u05e2\u05d5\u05dc\u05dd \u05d4\u05d6\u05d4 \u05d6\u05d4 \u05d4\u05d7\u05d9\u05d3\u05d5\u05e9! \u05e9\u05d1\u05e2\u05d5\u05dc\u05dd \u05d4\u05d2\u05e9\u05de\u05d9 \u05d9\u05d4\u05d9\u05d4 \u05e9\u05db\u05e8 \u05de\u05d4 \u05e4\u05ea\u05d0\u05d5\u05dd?",
 "CAP_A_05": "\u05db\u05df, \u05d5\u05e0\u05ea\u05ea\u05d9 \u05d2\u05e9\u05de\u05d9\u05db\u05dd \u05d1\u05e2\u05ea\u05dd. \u05db\u05dc \u05e4\u05e8\u05e9\u05ea \u05d1\u05d7\u05d5\u05e7\u05d5\u05ea\u05d9 \u05d6\u05d4 \u05d4\u05db\u05dc \u05d7\u05d9\u05d3\u05d5\u05e9.",
 "CAP_A_06": "\u05d6\u05d4 \u05d4\u05e4\u05dc\u05d0 \u05e9\u05d1\u05db\u05dc\u05dc \u05d9\u05e9 \u05e9\u05db\u05e8 \u05d1\u05e2\u05d5\u05dc\u05dd! \u05de\u05d4 \u05d4\u05e7\u05e9\u05e8 \u05e9\u05d1\u05e2\u05d5\u05dc\u05dd \u05d4\u05d6\u05d4 \u05d0\u05e0\u05d7\u05e0\u05d5 \u05e0\u05e8\u05d0\u05d4 \u05d0\u05ea \u05d4\u05e4\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05e2\u05e9\u05d9\u05dd \u05d4\u05d8\u05d5\u05d1\u05d9\u05dd \u05e9\u05dc\u05e0\u05d5?",
 "CAP_A_07": "\u05d6\u05d4 \u05d0\u05de\u05d5\u05e8 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05e2\u05d5\u05dc\u05dd \u05d4\u05d1\u05d0! \u05dc\u05de\u05d4 \u05e9\u05d9\u05ea\u05e8\u05d2\u05dd \u05d0\u05ea \u05d6\u05d4 \u05dc\u05e4\u05e8\u05d5\u05d8\u05d5\u05ea \u05d1\u05e2\u05d5\u05dc\u05dd \u05e9\u05dc\u05e0\u05d5? \u05d0\u05d1\u05dc \u05d6\u05d4 \u05d7\u05d9\u05d3\u05d5\u05e9 \u05e9\u05d4\u05e2\u05d5\u05dc\u05dd \u05d4\u05d2\u05e9\u05de\u05d9 \u05d9\u05ea\u05e0\u05d4\u05dc \u05e2\u05dc \u05e4\u05d9 \u05d7\u05d5\u05e7\u05d9\u05dd \u05e8\u05d5\u05d7\u05e0\u05d9\u05d9\u05dd."
}
