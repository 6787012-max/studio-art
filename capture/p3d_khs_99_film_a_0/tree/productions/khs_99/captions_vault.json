{
 "G_CAP_01": "\u05db\u05e9\u05d0\u05ea\u05d4 \u05de\u05d1\u05e8\u05e8 \u05e9\u05d4\u05e8\u05e2 \u05d4\u05d5\u05d0 \u05e8\u05e2, \u05d0\u05d6 \u05d0\u05ea\u05d4 \u05d1\u05e2\u05e6\u05de\u05d5, \u05d0\u05ea\u05d4 \u05de\u05d1\u05d8\u05dc \u05db\u05d1\u05e8 \u05d0\u05ea \u05db\u05dc \u05d4\u05db\u05d5\u05d7 \u05e9\u05dc\u05d5.",
 "G_CAP_04": "\u05d4\u05e2\u05e5 \u05d4\u05d6\u05d4, \u05d4\u05e7\u05d3\u05d5\u05e9 \u05d1\u05e8\u05d5\u05da \u05d4\u05d5\u05d0 \u05d0\u05d5\u05de\u05e8 \u05e9\u05dc\u05d0 \u05db\u05d3\u05d0\u05d9, \u05d0\u05e0\u05d9 \u05d7\u05d5\u05e9\u05d1 \u05e9\u05db\u05df \u05db\u05d3\u05d0\u05d9.",
 "G_CAP_07": "\u05db\u05d3\u05d0\u05d9, \u05ea\u05d4\u05e0\u05d4. \u05d0\u05ea\u05d4 \u05de\u05e0\u05ea\u05e7 \u05d0\u05ea \u05d4\u05e2\u05e5 \u05de\u05d4\u05de\u05e7\u05d5\u05e8 \u05e9\u05dc\u05d5, \u05db\u05df?",
 "G_CAP_10": "\u05d4\u05d5\u05d0 \u05d4\u05e8\u05d9 \u05e0\u05d1\u05e8\u05d0 \u05de\u05d4\u05e7\u05d3\u05d5\u05e9 \u05d1\u05e8\u05d5\u05da \u05d4\u05d5\u05d0 \u05e9\u05dc\u05d0 \u05ea\u05d8\u05e2\u05dd \u05d0\u05d5\u05ea\u05d5. \u05db\u05e9\u05d4\u05d5\u05d0 \u05de\u05e4\u05ea\u05d4 \u05d0\u05d5\u05ea\u05da \u05dc\u05d8\u05e2\u05d5\u05dd \u05d0\u05d5\u05ea\u05d5, \u05d0\u05d6 \u05d4\u05d5\u05d0 \u05e0\u05e7\u05e8\u05d0",
 "G_CAP_14": "\u05d4\u05d5\u05d0 \u05e8\u05e2, \u05db\u05d0\u05d9\u05dc\u05d5 \u05d4\u05d5\u05d0 \u05dc\u05d0 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05de\u05e7\u05d5\u05e8 \u05e9\u05dc\u05d5. \u05ea\u05e4\u05e7\u05d9\u05d3 \u05e9\u05dc\u05da \u05dc\u05d4\u05d2\u05d9\u05d3: \u05dc\u05d0! \u05d0\u05ea\u05d4 \u05e0\u05d1\u05e8\u05d0 \u05e2\u05dc \u05d9\u05d3\u05d9",
 "G_CAP_18": "\u05d4\u05e7\u05d3\u05d5\u05e9 \u05d1\u05e8\u05d5\u05da \u05d4\u05d5\u05d0. \u05d5\u05d1\u05d6\u05d4 \u05d6\u05d4 \u05e0\u05d2\u05de\u05e8. \u05d0\u05d9\u05df \u05dc\u05da \u05e9\u05d5\u05dd \u05e6\u05d3 \u05d1\u05db\u05dc\u05dc \u05dc\u05d4\u05d2\u05d9\u05d3 \u05de\u05e9\u05d4\u05d5 \u05d0\u05d7\u05e8.",
 "G_CAP_22": "\u05d5\u05db\u05dc \u05d4\u05e4\u05d9\u05ea\u05d5\u05d9\u05d9\u05dd \u05e9\u05d9\u05e9 \u05dc\u05e0\u05d5 \u05d1\u05de\u05e9\u05da \u05db\u05dc \u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4, \u05d6\u05d4 \u05d1\u05d3\u05d9\u05d5\u05e7 \u05d4\u05e1\u05d5\u05d2 \u05d4\u05d6\u05d4 \u05e9\u05dc \u05e4\u05d9\u05ea\u05d5\u05d9\u05d9\u05dd.",
 "LBL_A": "\u05e8\u05e2",
 "LBL_B": "\u05de\u05e7\u05d5\u05e8",
 "LBL_C": "\u05e9\u05d5\u05e8\u05e9",
 "LBL_D": "\u05dc\u05d0 \u05db\u05d3\u05d0\u05d9",
 "LBL_E": "\u05ea\u05d4\u05e0\u05d4",
 "LBL_F": "\u05de\u05e0\u05d5\u05ea\u05e7",
 "LBL_G": "\u05dc\u05d0!",
 "LBL_H": "\u05e4\u05d9\u05ea\u05d5\u05d9\u05d9\u05dd"
}