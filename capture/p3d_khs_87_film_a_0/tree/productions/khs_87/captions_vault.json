{
 "CAP_A_01": "\u05d0\u05d9\u05da \u05de\u05e8\u05d2\u05d9\u05e9\u05d9\u05dd \u05e0\u05d5\u05e8\u05de\u05dc\u05d9? \u05d6\u05d4 \u05d4\u05d1\u05e2\u05d9\u05d4 \u05e9\u05dc\u05e0\u05d5. \u05e9\u05d0\u05e0\u05d7\u05e0\u05d5 \u05de\u05e8\u05d2\u05d9\u05e9\u05d9\u05dd \u05e0\u05d5\u05e8\u05de\u05dc\u05d9. \u05db\u05e9\u05d9\u05e9 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e4\u05d5\u05e8",
 "CAP_A_02": "\u05d4\u05de\u05e4\u05d5\u05e8\u05e1\u05dd \u05db\u05db\u05d4 \u05de\u05e1\u05e4\u05e8\u05d9\u05dd \u05e9\u05e0\u05e4\u05d5\u05dc\u05d0\u05d5\u05df \u05e9\u05d4\u05d5\u05d0 \u05d0\u05ea \u05d0\u05d9\u05e8\u05d5\u05e4\u05d4 \u05d0\u05d6",
 "CAP_A_03": "\u05d4\u05d5\u05d0 \u05d4\u05d2\u05d9\u05e2 \u05dc\u05d0\u05d9\u05d6\u05d4 \u05de\u05e7\u05d5\u05dd \u05d5\u05d4\u05d5\u05d0 \u05e8\u05d5\u05d0\u05d4 \u05e9\u05de\u05d4 \u05d9\u05d4\u05d5\u05d3\u05d9\u05dd \u05d9\u05d5\u05e9\u05d1\u05d9\u05dd \u05d5\u05d1\u05d5\u05db\u05d9\u05dd \u05e9\u05de\u05d4 \u05d5\u05d4\u05d5\u05d0 \u05e9\u05d0\u05dc \u05d4\u05d5\u05d0 \u05e9\u05de\u05e2",
 "CAP_A_04": "\u05d0\u05ea \u05d4\u05d1\u05d7\u05d9\u05d5\u05ea \u05d1\u05d7\u05d5\u05e5 \u05dc\u05e4\u05e0\u05d9 200 \u05d5\u05de\u05e9\u05d4\u05d5 \u05e9\u05e0\u05d9\u05dd \u05e9\u05d5\u05de\u05e2 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e9\u05de\u05d4 \u05d1\u05d5\u05db\u05d9\u05dd \u05d1\u05d7\u05d5\u05e5",
 "CAP_A_05": "\u05d0\u05d6 \u05d4\u05d5\u05d0 \u05d1\u05d9\u05e8\u05e8 \u05de\u05d4 \u05d4\u05d5\u05dc\u05da \u05e9\u05de\u05d4 \u05d1\u05d5\u05db\u05d4 \u05e9\u05de\u05d4 \u05d0\u05d6",
 "CAP_A_06": "\u05e8\u05d0\u05d5 \u05e9\u05de\u05d4 \u05d1\u05d7\u05d9\u05d5\u05ea \u05d0\u05d9 \u05d0\u05e4\u05e9\u05e8 \u05dc\u05e9\u05de\u05d5\u05e2 \u05db\u05dc\u05d5\u05dd \u05db\u05d5\u05dc\u05dd \u05d9\u05d5\u05e9\u05d1\u05d9\u05dd \u05d5\u05d1\u05d5\u05db\u05d9\u05dd \u05d0\u05d6 \u05d4\u05de\u05e9\u05d0\u05dc \u05e9\u05de\u05d4 \u05d0\u05ea",
 "CAP_A_07": "\u05d4\u05d9\u05d4\u05d5\u05d3\u05d9\u05dd \u05d5\u05e8\u05d0\u05d5 \u05d0\u05ea \u05e0\u05e4\u05d5\u05dc\u05d0\u05d5\u05df \u05e0\u05db\u05e0\u05e1 \u05d1\u05db\u05dc \u05d0\u05d5\u05e4\u05df \u05d0\u05d6 \u05d4\u05d5\u05d0 \u05d0\u05d6 \u05d0\u05de\u05e8\u05d5 \u05dc\u05d5 \u05d0\u05e0\u05d7\u05e0\u05d5 \u05d1\u05d5\u05db\u05d9\u05dd \u05e0\u05d7\u05e8\u05d1",
 "CAP_A_08": "\u05d1\u05d9\u05ea \u05d4\u05de\u05e7\u05d3\u05e9 \u05d4\u05d5\u05d0 \u05dc\u05d0 \u05d9\u05d3\u05e2 \u05de\u05d4 \u05d6\u05d4 \u05d1\u05d9\u05ea \u05d4\u05de\u05e7\u05d3\u05e9 \u05d0\u05d6 \u05d4\u05d5\u05d0 \u05e9\u05d0\u05dc \u05d0\u05ea \u05d4\u05d9\u05d5\u05e2\u05e6\u05d9\u05dd \u05e9\u05dc\u05d5 \u05de\u05ea\u05d9",
 "CAP_A_09": "\u05d4\u05d9\u05d4 \u05e4\u05d4 \u05d4\u05d9\u05d4 \u05d0\u05d9\u05d6\u05d4 \u05de\u05dc\u05d7\u05de\u05d4 \u05dc\u05d0 \u05d9\u05d3\u05e2\u05ea\u05d9 \u05d7\u05e9\u05d1\u05ea\u05d9 \u05dc\u05d0 \u05dc\u05d0 \u05d6\u05d4 \u05dc\u05e4\u05e0\u05d9 1700 \u05e9\u05e0\u05d4 \u05d1\u05e2\u05e8\u05da",
 "CAP_A_10": "\u05de\u05d4 \u05dc\u05e4\u05e0\u05d9 1700 \u05e9\u05e0\u05d4 \u05d0\u05ea\u05dd \u05d1\u05d5\u05db\u05d9\u05dd \u05e2\u05dc \u05d6\u05d4 \u05e2\u05db\u05e9\u05d9\u05d5",
 "CAP_A_11": "\u05d0\u05d6 \u05d0\u05de\u05e8\u05ea \u05d4\u05de\u05e9\u05e4\u05d8 \u05d4\u05de\u05e4\u05d5\u05e8\u05e1\u05dd \u05e9\u05dc\u05d5 \u05e9\u05e2\u05dd \u05e9\u05d9\u05e9 \u05dc\u05d5 \u05e2\u05d1\u05e8 \u05d9\u05e9 \u05dc\u05d5 \u05e2\u05ea\u05d9\u05d3",
 "CAP_A_12": "\u05e9\u05e2\u05dd \u05e9\u05d7\u05d9 \u05db\u05dc \u05db\u05da \u05d7\u05d9\u05d1\u05d5\u05e8 \u05dc\u05e2\u05d1\u05e8 \u05d4\u05db\u05d6\u05d4 \u05e8\u05d7\u05d5\u05e7 \u05e9\u05dc\u05d5 \u05d6\u05d4 \u05e2\u05dd \u05e9\u05d9\u05e9 \u05dc\u05d5 \u05e2\u05ea\u05d9\u05d3 \u05db\u05df \u05d0\u05e0\u05d7\u05e0\u05d5 \u05dc\u05d0 \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05d4\u05e1\u05db\u05de\u05d5\u05ea",
 "CAP_A_13": "\u05de\u05d4 \u05de\u05d4\u05e8\u05e9\u05e2 \u05d4\u05d6\u05d4 \u05d0\u05d1\u05dc \u05d1\u05db\u05dc \u05d0\u05d5\u05e4\u05df \u05de\u05e9\u05e4\u05d8 \u05e9\u05dc \u05e8\u05d1\u05d5\u05ea\u05d9\u05e0\u05d5 \u05de\u05d1\u05d9\u05d0\u05d9\u05dd \u05d0\u05ea \u05d4\u05de\u05e9\u05e4\u05d8 \u05e9\u05dc\u05d5 \u05d0\u05d1\u05dc",
 "CAP_A_14": "\u05e8\u05d5\u05d0\u05d9\u05dd \u05e9\u05d4\u05d9\u05d4 \u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05e9\u05d0\u05e0\u05e9\u05d9\u05dd \u05d9\u05d5\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e8\u05e6\u05e4\u05d4 \u05d5\u05d1\u05d7\u05d5 \u05d1\u05d7\u05d5 \u05db\u05e4\u05e9\u05d5\u05d8\u05d5",
 "CAP_A_15": "\u05d5\u05d4\u05d9\u05d5\u05dd \u05d0\u05e0\u05d7\u05e0\u05d5 \u05de\u05ea\u05d0\u05de\u05e6\u05d9\u05dd \u05de\u05ea\u05d0\u05de\u05e6\u05d9\u05dd \u05de\u05d0\u05d5\u05d3"
}
