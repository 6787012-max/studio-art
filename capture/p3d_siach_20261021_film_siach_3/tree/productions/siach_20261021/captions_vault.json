{
 "TITLE": "\u05e7\u05d3\u05d5\u05e9\u05d4 \u05e9\u05e0\u05e9\u05d0\u05e8\u05ea",
 "KICKER": "\u05e9\u05d9\u05d7 \u05d4\u05d1\u05d5\u05e7\u05e8 \u05d1\u05d1\u05d9\u05ea \u05d4\u05de\u05d3\u05e8\u05e9 \u00b7 \u05e4\u05e8\u05e9\u05ea \u05dc\u05da \u05dc\u05da \u05ea\u05e9\u05e4\u05f4\u05d6",
 "RECAP_1": "\u05de\u05e7\u05d5\u05dd \u05d6\u05d5\u05db\u05e8 \u05d0\u05ea \u05de\u05d4 \u05e9\u05e0\u05e2\u05e9\u05d4 \u05d1\u05d5",
 "RECAP_2": "\u05d0\u05d1\u05e8\u05d4\u05dd \u05d4\u05dc\u05da \u05d1\u05d0\u05e8\u05e5 \u05d5\u05e7\u05d9\u05d3\u05e9 \u05d0\u05d5\u05ea\u05d4",
 "RECAP_3": "\u05db\u05dc \u05e6\u05e2\u05d3 \u05e9\u05dc\u05e0\u05d5 \u05d1\u05d4 \u05d4\u05d5\u05d0 \u05e6\u05e2\u05d3 \u05d1\u05d0\u05e8\u05de\u05d5\u05df \u05d4\u05de\u05dc\u05da",
 "CAP_S_01": "\u05e1\u05e4\u05e1\u05dc \u05e2\u05e5 \u05e4\u05e9\u05d5\u05d8 \u05d1\u05d1\u05d9\u05ea \u05db\u05e0\u05e1\u05ea \u05d9\u05e9\u05df",
 "CAP_S_02": "\u05dc\u05e4\u05e0\u05d9 140 \u05e9\u05e0\u05d4 \u05d9\u05e9\u05d1 \u05e2\u05dc\u05d9\u05d5 \u05e6\u05d3\u05d9\u05e7 \u05d5\u05d4\u05ea\u05e4\u05dc\u05dc",
 "CAP_S_03": "\u05db\u05dc \u05ea\u05e4\u05d9\u05dc\u05d4 \u05e9\u05dc\u05d5 \u05d4\u05e9\u05d0\u05d9\u05e8\u05d4 \u05e9\u05dd \u05de\u05e9\u05d4\u05d5",
 "CAP_S_04": "\u05e2\u05d5\u05d3 \u05d5\u05e2\u05d5\u05d3, \u05d9\u05d5\u05dd \u05d0\u05d7\u05e8\u05d9 \u05d9\u05d5\u05dd",
 "CAP_S_05": "\u05e9\u05e0\u05d9\u05dd \u05e8\u05d1\u05d5\u05ea \u05e2\u05d1\u05e8\u05d5",
 "CAP_S_06": "\u05d0\u05d1\u05dc \u05de\u05e9\u05d4\u05d5 \u05e0\u05e9\u05d0\u05e8 \u05d1\u05e1\u05e4\u05e1\u05dc",
 "CAP_S_07": "\u05e0\u05db\u05d3\u05d5 \u05de\u05ea\u05d9\u05d9\u05e9\u05d1 \u05e2\u05dc \u05d0\u05d5\u05ea\u05d5 \u05e1\u05e4\u05e1\u05dc",
 "CAP_S_08": "\u05d5\u05de\u05e8\u05d2\u05d9\u05e9: \u05d9\u05e9 \u05db\u05d0\u05df \u05e7\u05d3\u05d5\u05e9\u05d4",
 "CAP_S_09": "\u05e4\u05e2\u05dd, \u05d1\u05d1\u05e0\u05d9 \u05d1\u05e8\u05e7, \u05d4\u05d9\u05d4 \u05e4\u05e8\u05d3\u05e1 \u05d2\u05d3\u05d5\u05dc",
 "CAP_S_10": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05d9\u05d7\u05e7\u05d5 \u05d1\u05d5 \u05d5\u05e2\u05d1\u05e8\u05d5 \u05d1\u05d5 \u05db\u05dc \u05d9\u05d5\u05dd",
 "CAP_S_11": "\u05d2\u05d3\u05d5\u05dc \u05d4\u05d3\u05d5\u05e8 \u05d8\u05d9\u05d9\u05dc \u05e9\u05dd \u05e2\u05dd \u05d1\u05d7\u05d5\u05e8",
 "CAP_S_12": "\u05d5\u05d4\u05dd \u05d3\u05d9\u05d1\u05e8\u05d5 \u05d1\u05d3\u05d1\u05e8\u05d9 \u05ea\u05d5\u05e8\u05d4",
 "CAP_S_13": "\u05e4\u05ea\u05d0\u05d5\u05dd \u05d4\u05d5\u05d0 \u05e0\u05e2\u05e6\u05e8",
 "CAP_S_14": "\u05d4\u05de\u05e7\u05d5\u05dd \u05d4\u05d6\u05d4 \u05de\u05e8\u05d2\u05d9\u05e9 \u05d0\u05d7\u05e8\u05ea",
 "CAP_S_15": "\u05d0\u05d5\u05dc\u05d9 \u05e6\u05d3\u05d9\u05e7 \u05e2\u05d1\u05d3 \u05db\u05d0\u05df \u05d0\u05ea \u05d4' \u05e4\u05e2\u05dd",
 "CAP_S_16": "\u05de\u05e7\u05d5\u05dd \u05d6\u05d5\u05db\u05e8 \u05d0\u05ea \u05de\u05d4 \u05e9\u05e0\u05e2\u05e9\u05d4 \u05d1\u05d5",
 "CAP_S_17": "\u05d2\u05dd \u05d4\u05e7\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc \u05d4\u05d1\u05d9\u05ea \u05e8\u05d5\u05d0\u05d9\u05dd \u05d4\u05db\u05d5\u05dc",
 "CAP_S_18": "\u05d4\u05d0\u05d1\u05e0\u05d9\u05dd \u05d5\u05d4\u05e2\u05e5 \u05de\u05e2\u05d9\u05d3\u05d9\u05dd \u05e2\u05dc \u05de\u05d4 \u05e9\u05e0\u05e2\u05e9\u05d4",
 "CAP_S_19": "\u05de\u05e7\u05dc \u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05e7\u05d8\u05df \u05de\u05d7\u05d6\u05d9\u05e7 \u05d0\u05dc\u05e4\u05d9 \u05ea\u05de\u05d5\u05e0\u05d5\u05ea",
 "CAP_S_20": "\u05d4\u05db\u05d5\u05dc \u05e9\u05de\u05d5\u05e8 \u05d1\u05ea\u05d5\u05db\u05d5",
 "CAP_S_21": "\u05d0\u05dd \u05d0\u05d3\u05dd \u05d9\u05db\u05d5\u05dc \u05dc\u05d1\u05e0\u05d5\u05ea \u05d3\u05d1\u05e8 \u05db\u05d6\u05d4",
 "CAP_S_22": "\u05de\u05d9 \u05e9\u05d1\u05e8\u05d0 \u05d0\u05ea \u05d4\u05db\u05d5\u05d7 \u05d4\u05d6\u05d4 \u05e8\u05d5\u05d0\u05d4 \u05d4\u05db\u05d5\u05dc",
 "CAP_S_23": "\u05db\u05dc \u05de\u05e2\u05e9\u05d4 \u05e0\u05e9\u05de\u05e8",
 "CAP_S_24": "\u05d2\u05dd \u05de\u05d4 \u05e9\u05d0\u05e3 \u05d0\u05d7\u05d3 \u05dc\u05d0 \u05e8\u05d0\u05d4",
 "CAP_S_25": "\u05d1\u05e4\u05e8\u05e9\u05ea \u05d4\u05e9\u05d1\u05d5\u05e2 \u05d4' \u05d0\u05d5\u05de\u05e8 \u05dc\u05d0\u05d1\u05e8\u05d4\u05dd",
 "CAP_S_26": "\u05e7\u05d5\u05dd, \u05d4\u05ea\u05d4\u05dc\u05da \u05d1\u05d0\u05e8\u05e5",
 "CAP_S_27": "\u05dc\u05d0\u05d5\u05e8\u05db\u05d4 \u05d5\u05dc\u05e8\u05d5\u05d7\u05d1\u05d4",
 "CAP_S_28": "\u05d5\u05d1\u05db\u05dc \u05e6\u05e2\u05d3 \u05d4\u05d5\u05d0 \u05de\u05db\u05e0\u05d9\u05e1 \u05e7\u05d3\u05d5\u05e9\u05d4",
 "CAP_S_29": "\u05de\u05de\u05e7\u05d5\u05dd \u05dc\u05de\u05e7\u05d5\u05dd, \u05d1\u05db\u05dc \u05d4\u05d0\u05e8\u05e5",
 "CAP_S_30": "\u05db\u05d3\u05d9 \u05e9\u05d4\u05d0\u05e8\u05e5 \u05ea\u05d4\u05d9\u05d4 \u05de\u05d5\u05db\u05e0\u05d4 \u05dc\u05d1\u05e0\u05d9\u05dd",
 "CAP_S_31": "\u05dc\u05da \u05d5\u05dc\u05d6\u05e8\u05e2\u05da \u05d0\u05ea\u05e0\u05e0\u05d4",
 "CAP_S_32": "\u05dc\u05da \u05d5\u05dc\u05db\u05dc \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05dc\u05da",
 "CAP_S_33": "\u05d1\u05d0\u05e8\u05e5 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d9\u05e9 \u05e7\u05d3\u05d5\u05e9\u05d4 \u05de\u05d9\u05d5\u05d7\u05d3\u05ea",
 "CAP_S_34": "\u05d5\u05d1\u05d4 \u05d4\u05dc\u05d9\u05de\u05d5\u05d3 \u05de\u05e6\u05dc\u05d9\u05d7 \u05d9\u05d5\u05ea\u05e8",
 "CAP_S_35": "\u05e8\u05d7\u05d5\u05e7 \u05de\u05db\u05d0\u05df, \u05d9\u05d4\u05d5\u05d3\u05d9\u05dd \u05e7\u05d5\u05e0\u05d9\u05dd \u05e2\u05e4\u05e8 \u05de\u05d0\u05e8\u05e5 \u05d9\u05e9\u05e8\u05d0\u05dc",
 "CAP_S_36": "\u05d5\u05e9\u05d5\u05de\u05e8\u05d9\u05dd \u05d0\u05d5\u05ea\u05d5 \u05db\u05de\u05d5 \u05d0\u05d5\u05e6\u05e8",
 "CAP_S_37": "\u05d5\u05d0\u05e0\u05d7\u05e0\u05d5 \u05d3\u05d5\u05e8\u05db\u05d9\u05dd \u05e2\u05dc\u05d9\u05d5 \u05db\u05dc \u05d9\u05d5\u05dd",
 "CAP_S_38": "\u05d6\u05d4 \u05d4\u05d0\u05e8\u05de\u05d5\u05df \u05e9\u05dc \u05d4\u05de\u05dc\u05da, \u05e9\u05d5\u05de\u05e8\u05d9\u05dd \u05e2\u05dc\u05d9\u05d5",
 "CAP_S_39": "\u05d4\u05d8\u05d9\u05d5\u05dc \u05d4\u05e7\u05e8\u05d5\u05d1 \u05d0\u05d9\u05e0\u05e0\u05d5 \u05e1\u05ea\u05dd \u05d8\u05d9\u05d5\u05dc",
 "CAP_S_40": "\u05db\u05dc \u05d0\u05e8\u05d1\u05e2 \u05d0\u05de\u05d5\u05ea \u05d1\u05d0\u05e8\u05e5 \u05d9\u05e9\u05e8\u05d0\u05dc",
 "CAP_S_41": "\u05d4\u05dc\u05d9\u05db\u05d4 \u05d1\u05de\u05e7\u05d5\u05dd \u05de\u05d9\u05d5\u05d7\u05d3",
 "CAP_S_42": "\u05d5\u05de\u05ea\u05e0\u05d4\u05d2\u05d9\u05dd \u05d1\u05d4\u05ea\u05d0\u05dd"
}
