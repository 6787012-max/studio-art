{
 "TITLE": "\u05de\u05dc\u05e7\u05d5\u05ea",
 "KICKER": "\u05d0\u05dc\u05d5 \u05d4\u05df \u05d4\u05dc\u05d5\u05e7\u05d9\u05df \u2014 \u05de\u05e1\u05db\u05ea \u05de\u05db\u05d5\u05ea \u05d3\u05e3 \u05d9\u05d2",
 "CAP_s02_1": "\u05de\u05d4 \u05d6\u05d4 \u05de\u05dc\u05e7\u05d5\u05ea?: \u05e2\u05d5\u05e0\u05e9 \u05d1\u05d1\u05d9\u05ea \u05d3\u05d9\u05df",
 "CAP_s02_2": "\u05de\u05d9 \u05e9\u05e2\u05d1\u05e8 \u05e2\u05dc \u05d0\u05d9\u05e1\u05d5\u05e8 \u05e9\u05dc \u05dc\u05d0 \u05ea\u05e2\u05e9\u05d4 \u05d1\u05de\u05e2\u05e9\u05d4, \u05dc\u05e4\u05e0\u05d9 \u05e2\u05d3\u05d9\u05dd, \u05d5\u05d0\u05d7\u05e8\u05d9 \u05e9\u05d4\u05d6\u05d4\u05d9\u05e8\u05d5 \u05d0\u05d5\u05ea\u05d5 \u2014 \u05d1\u05d9\u05ea \u05d4\u05d3\u05d9\u05df \u05de\u05dc\u05e7\u05d4 \u05d0\u05d5\u05ea\u05d5.",
 "CAP_s03_1": "\u05d0\u05b7\u05e8\u05b0\u05d1\u05b8\u05bc\u05e2\u05b4\u05d9\u05dd \u05d9\u05b7\u05db\u05b6\u05bc\u05e0\u05bc\u05d5\u05bc \u05dc\u05b9\u05d0 \u05d9\u05b9\u05e1\u05b4\u05d9\u05e3 (\u05d3\u05d1\u05e8\u05d9\u05dd \u05db\u05d4, \u05d2)",
 "CAP_s04_1": "\u05db\u05de\u05d4 \u05de\u05db\u05d5\u05ea?: 39",
 "CAP_s04_2": "\u05d7\u05db\u05de\u05d9\u05dd \u05dc\u05de\u05d3\u05d5: \"\u05d0\u05e8\u05d1\u05e2\u05d9\u05dd\" \u2014 \u05d4\u05db\u05d5\u05d5\u05e0\u05d4 \u05d0\u05e8\u05d1\u05e2\u05d9\u05dd \u05d7\u05e1\u05e8 \u05d0\u05d7\u05ea. \u05db\u05dc\u05d5\u05de\u05e8 \u05e9\u05dc\u05d5\u05e9\u05d9\u05dd \u05d5\u05ea\u05e9\u05e2 \u05de\u05db\u05d5\u05ea.",
 "CAP_s05_1": "\u05d4\u05de\u05e9\u05e0\u05d4: \u05d0\u05dc\u05d5 \u05d4\u05df \u05d4\u05dc\u05d5\u05e7\u05d9\u05df",
 "CAP_s05_2": "\u05d4\u05de\u05e9\u05e0\u05d4 \u05de\u05d5\u05e0\u05d4 \u05e8\u05e9\u05d9\u05de\u05d4 \u05d0\u05e8\u05d5\u05db\u05d4 \u05e9\u05dc \u05d0\u05d9\u05e1\u05d5\u05e8\u05d9\u05dd \u2014 \u05d5\u05d4\u05e8\u05d1\u05d4 \u05de\u05d4\u05dd \u05e2\u05dc \u05d0\u05d5\u05db\u05dc \u05d0\u05e1\u05d5\u05e8. \u05e0\u05db\u05d9\u05e8 \u05d0\u05e8\u05d1\u05e2\u05d4.",
 "CAP_s06_1": "\u05d0\u05d5\u05db\u05dc \u05d0\u05e1\u05d5\u05e8 1: \u05d7\u05b5\u05dc\u05b6\u05d1",
 "CAP_s06_2": "\u05e9\u05d5\u05de\u05df \u05de\u05e1\u05d5\u05d9\u05dd \u05e9\u05dc \u05e9\u05d5\u05e8, \u05db\u05d1\u05e9 \u05d5\u05e2\u05d6. \u05d4\u05ea\u05d5\u05e8\u05d4 \u05d0\u05e1\u05e8\u05d4 \u05dc\u05d0\u05db\u05d5\u05dc \u05d0\u05d5\u05ea\u05d5 \u2014 \u05d6\u05d4 \u05dc\u05d0 \u05d7\u05b8\u05dc\u05b8\u05d1!",
 "CAP_s07_1": "\u05d7\u05d5\u05ea\u05db\u05d9\u05dd \u05e9\u05d5\u05de\u05df \u05e9\u05dc \u05d1\u05d4\u05de\u05d4",
 "CAP_s07_2": "\u05d5\u05de\u05d1\u05e9\u05dc\u05d9\u05dd \u05d0\u05d5\u05ea\u05d5 \u05d1\u05e1\u05d9\u05e8",
 "CAP_s08_1": "\u05de\u05e1\u05e2\u05d3\u05ea \"\u05d7\u05b5\u05dc\u05b6\u05d1 \u05d1\u05d5\u05e8\u05d2\u05e8\"",
 "CAP_s08_2": "\u05d4\u05d0\u05dd \u05de\u05d9 \u05e9\u05d7\u05d9\u05d9\u05d1 \u05db\u05e8\u05ea \u05d2\u05dd \u05dc\u05d5\u05e7\u05d4?",
 "CAP_s08_3": "\u05d4\u05ea\u05e0\u05d0\u05d9\u05dd \u05e0\u05d7\u05dc\u05e7\u05d5 \u05d1\u05d6\u05d4",
 "CAP_s08_4": "\u05d7\u05b5\u05dc\u05b6\u05d1 \u2014 \u05e2\u05d5\u05e0\u05e9\u05d5 \u05db\u05e8\u05ea",
 "CAP_s09_1": "\u05d0\u05d5\u05db\u05dc \u05d0\u05e1\u05d5\u05e8 2: \u05d3\u05dd",
 "CAP_s09_2": "\u05d4\u05ea\u05d5\u05e8\u05d4 \u05d0\u05e1\u05e8\u05d4 \u05dc\u05d0\u05db\u05d5\u05dc \u05d3\u05dd \u05e9\u05dc \u05d1\u05d4\u05de\u05d4, \u05d7\u05d9\u05d4 \u05d5\u05e2\u05d5\u05e3. \u05de\u05d9 \u05e9\u05d0\u05d5\u05db\u05dc \u05d3\u05dd \u05e2\u05d5\u05d1\u05e8 \u05e2\u05dc \u05d0\u05d9\u05e1\u05d5\u05e8 \u05d7\u05de\u05d5\u05e8 \u05de\u05d0\u05d5\u05d3.",
 "CAP_s10_1": "\u05d9\u05e9 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e9\u05d0\u05d5\u05e1\u05e4\u05d9\u05dd \u05d3\u05dd \u05de\u05e4\u05e8\u05d4 \u05d7\u05d9\u05d4",
 "CAP_s10_2": "\u05d4\u05d3\u05dd \u05e0\u05d0\u05e1\u05e3 \u05dc\u05ea\u05d5\u05da \u05db\u05dc\u05d9",
 "CAP_s10_3": "\u05d5\u05e9\u05d5\u05ea\u05d9\u05dd \u2014 \u05d0\u05e6\u05dc\u05e0\u05d5 \u05d6\u05d4 \u05d0\u05e1\u05d5\u05e8!",
 "CAP_s11_1": "\u05d0\u05d5\u05db\u05dc \u05d0\u05e1\u05d5\u05e8 3: \u05e9\u05e7\u05e6\u05d9\u05dd \u05d5\u05e8\u05de\u05e9\u05d9\u05dd",
 "CAP_s11_2": "\u05d7\u05e8\u05e7\u05d9\u05dd \u05d5\u05e9\u05e8\u05e6\u05d9\u05dd \u05e7\u05d8\u05e0\u05d9\u05dd. \u05d0\u05e1\u05d5\u05e8 \u05dc\u05d0\u05db\u05d5\u05dc \u05d0\u05d5\u05ea\u05dd \u2014 \u05d2\u05dd \u05d7\u05e8\u05e7 \u05d0\u05d7\u05d3 \u05e7\u05d8\u05df.",
 "CAP_s12_1": "\u05d1\u05e1\u05dc\u05d8 \u05d6\u05d5\u05d7\u05dc\u05d9\u05dd \u05d7\u05e8\u05e7\u05d9\u05dd",
 "CAP_s13_1": "\u05e0\u05de\u05dc\u05d4 \u05e2\u05dc \u05d4\u05db\u05e4\u05d9\u05ea!",
 "CAP_s14_1": "\u05de\u05d4 \u05e2\u05d5\u05e9\u05d9\u05dd?: \u05d1\u05d5\u05d3\u05e7\u05d9\u05dd \u05d9\u05e8\u05e7\u05d5\u05ea",
 "CAP_s14_2": "\u05dc\u05db\u05df \u05d1\u05d5\u05d3\u05e7\u05d9\u05dd \u05d4\u05d9\u05d8\u05d1 \u05d7\u05e1\u05d4 \u05d5\u05d9\u05e8\u05e7\u05d5\u05ea \u05e2\u05dc\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d0\u05d5\u05db\u05dc\u05d9\u05dd \u05d0\u05d5\u05ea\u05dd.",
 "CAP_s15_1": "\u05d0\u05d5\u05db\u05dc \u05d0\u05e1\u05d5\u05e8 4: \u05d8\u05d1\u05dc",
 "CAP_s15_2": "\u05e4\u05d9\u05e8\u05d5\u05ea \u05e9\u05e2\u05d5\u05d3 \u05dc\u05d0 \u05d4\u05e4\u05e8\u05d9\u05e9\u05d5 \u05de\u05d4\u05dd \u05ea\u05e8\u05d5\u05de\u05d5\u05ea \u05d5\u05de\u05e2\u05e9\u05e8\u05d5\u05ea. \u05d0\u05e1\u05d5\u05e8 \u05dc\u05d0\u05db\u05d5\u05dc \u05d0\u05d5\u05ea\u05dd \u05e2\u05d3 \u05e9\u05de\u05e4\u05e8\u05d9\u05e9\u05d9\u05dd.",
 "CAP_s16_1": "\u05d4\u05d7\u05e7\u05dc\u05d0\u05d9 \u05e0\u05d5\u05ea\u05df \u05de\u05e2\u05e9\u05e8 \u05dc\u05dc\u05d5\u05d9",
 "CAP_s17_1": "\u05d4\u05dc\u05d5\u05d9 \u05e0\u05d5\u05ea\u05df \u05e2\u05e9\u05d9\u05e8\u05d9\u05ea \u05dc\u05db\u05d4\u05df",
 "CAP_s18_1": "\u05d2\u05dd \u05d4\u05dc\u05d5\u05d9: \u05ea\u05e8\u05d5\u05de\u05ea \u05de\u05e2\u05e9\u05e8",
 "CAP_s18_2": "\u05dc\u05d5\u05d9 \u05e9\u05d0\u05db\u05dc \u05de\u05de\u05e2\u05e9\u05e8 \u05e9\u05e7\u05d9\u05d1\u05dc, \u05dc\u05e4\u05e0\u05d9 \u05e9\u05e0\u05ea\u05df \u05de\u05de\u05e0\u05d5 \u05e2\u05e9\u05d9\u05e8\u05d9\u05ea \u05dc\u05db\u05d4\u05df \u2014 \u05d2\u05dd \u05d4\u05d5\u05d0 \u05dc\u05d5\u05e7\u05d4.",
 "CAP_s19_1": "\u05db\u05de\u05d4 \u05e6\u05e8\u05d9\u05da \u05dc\u05d0\u05db\u05d5\u05dc?: \u05db\u05d6\u05d9\u05ea",
 "CAP_s19_2": "\u05dc\u05e4\u05d9 \u05d7\u05db\u05de\u05d9\u05dd, \u05dc\u05d5\u05e7\u05d9\u05dd \u05e2\u05dc \u05d0\u05db\u05d9\u05dc\u05d4 \u05e9\u05dc \u05db\u05d6\u05d9\u05ea. \u05d7\u05e8\u05e7 \u05e9\u05dc\u05dd \u05d0\u05e1\u05d5\u05e8 \u05d2\u05dd \u05db\u05e9\u05d4\u05d5\u05d0 \u05e7\u05d8\u05df \u05de\u05d0\u05d5\u05d3.",
 "CAP_s20_1": "\u05dc\u05de\u05d4 \u05d1\u05d5\u05d3\u05e7\u05d9\u05dd \u05d7\u05e1\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d0\u05d5\u05db\u05dc\u05d9\u05dd \u05d0\u05d5\u05ea\u05d4?",
 "CAP_s20_2": "\u05db\u05d9 \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05d4 \u05d7\u05e8\u05e7\u05d9\u05dd \u2014 \u05d5\u05d0\u05e1\u05d5\u05e8 \u05dc\u05d0\u05db\u05d5\u05dc \u05d0\u05e4\u05d9\u05dc\u05d5 \u05d7\u05e8\u05e7 \u05d0\u05d7\u05d3",
 "CAP_s21_1": "\u05dc\u05d5\u05d9 \u05e7\u05d9\u05d1\u05dc \u05de\u05e2\u05e9\u05e8. \u05de\u05d4 \u05e2\u05dc\u05d9\u05d5 \u05dc\u05e2\u05e9\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05d5\u05d0 \u05d0\u05d5\u05db\u05dc?",
 "CAP_s21_2": "\u05dc\u05d4\u05e4\u05e8\u05d9\u05e9 \u05e2\u05e9\u05d9\u05e8\u05d9\u05ea \u05de\u05de\u05e0\u05d5 \u2014 \u05ea\u05e8\u05d5\u05de\u05ea \u05de\u05e2\u05e9\u05e8 \u2014 \u05d5\u05dc\u05ea\u05ea \u05dc\u05db\u05d4\u05df",
 "CAP_s22_1": "\u05de\u05dc\u05e7\u05d5\u05ea \u2014 39 \u05de\u05db\u05d5\u05ea \u05d1\u05d1\u05d9\u05ea \u05d3\u05d9\u05df \u00b7 \u05d7\u05b5\u05dc\u05b6\u05d1 \u05d5\u05d3\u05dd \u2014 \u05d0\u05e1\u05d5\u05e8 \u05dc\u05d0\u05db\u05d5\u05dc",
 "CAP_s22_2": "\u05d7\u05e8\u05e7\u05d9\u05dd \u2014 \u05d2\u05dd \u05d0\u05d7\u05d3 \u05e7\u05d8\u05df \u00b7 \u05d8\u05d1\u05dc \u2014 \u05e7\u05d5\u05d3\u05dd \u05de\u05e4\u05e8\u05d9\u05e9\u05d9\u05dd \u05ea\u05e8\u05d5\u05de\u05d5\u05ea \u05d5\u05de\u05e2\u05e9\u05e8\u05d5\u05ea",
 "CAP_s23_1": "\u05e7\u05d8\u05e2\u05d9 \u05d4\u05d4\u05e0\u05e4\u05e9\u05d4: \u05e8\u05f3 \u05d0\u05dc\u05d9 \u05e1\u05d8\u05e4\u05e0\u05e1\u05e7\u05d9 | \u05de\u05e8\u05db\u05d6 \u05d3\u05e3 \u05d9\u05d5\u05de\u05d9 \u00b7 MDY | \u05de\u05e0\u05d2\u05d9\u05e0\u05d4 \u05de\u05e7\u05d5\u05e8\u05d9\u05ea \u00b7 \u05e2\u05e8\u05d9\u05db\u05d4: \u05de\u05db\u05d9\u05e0\u05ea \u05d1\u05d9\u05ea \u05d4\u05ea\u05dc\u05de\u05d5\u05d3"
}