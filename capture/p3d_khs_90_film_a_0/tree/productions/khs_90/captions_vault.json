{
 "G_CAP_01": "\u05e8\u05e9\"\u05d9 \u05d0\u05d5\u05de\u05e8 \u05e9\u05dc\u05e2\u05ea\u05d9\u05d3 \u05dc\u05d1\u05d5\u05d0 \u05d4\u05de\u05dc\u05d0\u05db\u05d9\u05dd \u05d9\u05d4\u05d9\u05d5 \u05d1\u05d7\u05d5\u05e5 \u05d5\u05d9\u05e9\u05e8\u05d0\u05dc \u05d9\u05d4\u05d9\u05d5 \u05dc\u05e4\u05e0\u05d9\u05dd",
 "G_CAP_05": "\u05de\u05df \u05d4\u05de\u05d7\u05d9\u05e6\u05d4 \u05d4\u05de\u05dc\u05d0\u05db\u05d9\u05dd \u05d9\u05e9\u05d0\u05dc\u05d5 \u05de\u05d4 \u05e4\u05e2\u05dc \u05d0\u05dc? \u05de\u05d4 \u05d6\u05d4?",
 "G_CAP_09": "\u05de\u05d4 \u05d4\u05e4\u05d9\u05e8\u05d5\u05e9? \u05d5\u05dc\u05de\u05d4 \u05d4\u05de\u05dc\u05d0\u05db\u05d9\u05dd \u05dc\u05d0 \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d9\u05db\u05e0\u05e1? \u05d0\u05d6 \u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05e0\u05e4\u05dc\u05d0\u05d4 \u05dc\u05e4\u05d9 \u05de\u05d4 \u05e9\u05d3\u05d9\u05d1\u05e8\u05e0\u05d5 \u05dc\u05e2\u05ea\u05d9\u05d3 \u05dc\u05d1\u05d5\u05d0",
 "G_CAP_14": "\u05d9\u05e9 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d2\u05d9\u05dc\u05d5\u05d9 \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3, \u05d6\u05d4 \u05d4\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05db\u05dc\u05dc\u05d9 \u05d4\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05d6\u05d4, \u05de\u05d9 \u05e0\u05db\u05e0\u05e1 \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8? \u05e8\u05e7 \u05de\u05d9 \u05e9\u05d9\u05e9 \u05dc\u05d5 \u05e7\u05d5\u05e9\u05d9\u05d5\u05ea",
 "G_CAP_18": "\u05de\u05dc\u05d0\u05da \u05e9\u05e2\u05d5\u05e9\u05d4 \u05d0\u05ea \u05e8\u05e6\u05d5\u05df \u05d4\u05e9\u05dd \u05d4\u05d5\u05d0 \u05de\u05e8\u05d2\u05d9\u05e9 \u05e9\u05d9\u05e9 \u05e4\u05d4 \u05d0\u05d9\u05d6\u05d5 \u05e7\u05d5\u05e9\u05d9\u05d4? \u05de\u05dc\u05d0\u05da \u05e2\u05d5\u05e9\u05d4",
 "G_CAP_22": "\u05de\u05d4 \u05e9\u05d4\u05e9\u05dd \u05e6\u05d9\u05d5\u05d5\u05d4 \u05d0\u05d5\u05ea\u05d5 \u05dc\u05d0 \u05de\u05e8\u05d2\u05d9\u05e9 \u05e4\u05d4 \u05d0\u05d9\u05d6\u05d5 \u05d1\u05e2\u05d9\u05d4 \u05d0\u05d9\u05d6\u05d5 \u05e7\u05d5\u05e9\u05d9\u05d4 \u05d0\u05d9\u05d6\u05d5 \u05e1\u05ea\u05d9\u05e8\u05d4",
 "G_CAP_27": "\u05d4\u05d5\u05d0 \u05dc\u05d0 \u05e8\u05d5\u05d0\u05d4 \u05d0\u05ea \u05db\u05dc \u05d4\u05ea\u05de\u05d5\u05e0\u05d4 \u05d4\u05d5\u05d0 \u05e9\u05dc\u05d9\u05d7 \u05d4\u05de\u05dc\u05d0\u05da \u05d1\u05db\u05dc\u05dc \u05dc\u05d0 \u05d7\u05d5\u05e9\u05d1 \u05e9\u05d9\u05e9 \u05e4\u05d4 \u05d1\u05e2\u05d9\u05d5\u05ea \u05dc\u05e2\u05ea\u05d9\u05d3 \u05dc\u05d1\u05d5\u05d0 \u05d4\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05db\u05dc\u05dc\u05d9",
 "G_CAP_33": "\u05d6\u05d4 \u05dc\u05d4\u05d1\u05d9\u05df \u05de\u05d4 \u05d4\u05de\u05dc\u05d0\u05da \u05e2\u05e9\u05d4 \u05dc\u05e2\u05ea\u05d9\u05d3 \u05dc\u05d1\u05d5\u05d0 \u05d1\u05ea\u05d5\u05da \u05d4\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d5\u05d1\u05e9\u05d1\u05d9\u05dc \u05e9\u05d4\u05d9\u05d5 \u05dc\u05d4\u05dd \u05e7\u05d5\u05e9\u05d9\u05d5\u05ea",
 "G_CAP_37": "\u05d0\u05d6 \u05d0\u05e0\u05d7\u05e0\u05d5, \u05e9\u05d4\u05e1\u05ea\u05e7\u05e8\u05e0\u05d5 \u05e0\u05d4\u05d9\u05d4 \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8",
 "G_CAP_40": "\u05d0\u05e0\u05d7\u05e0\u05d5 \u05e0\u05d4\u05e0\u05d4 \u05db\u05de\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05e2\u05d5\u05e8\u05e8 \u05d0\u05ea \u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05dc\u05dc\u05d5 \u05dc\u05d0 \u05d7\u05dc\u05d9\u05dc\u05d4 \u05d1\u05ea\u05d5\u05e8 \u05d4\u05ea\u05e8\u05e1\u05d5\u05ea",
 "G_CAP_44": "\u05d0\u05dc\u05d0 \u05d1\u05ea\u05d5\u05e8 \u05e1\u05e7\u05e8\u05e0\u05d5\u05ea \u05d0\u05d6 \u05d4\u05d5\u05d0 \u05d9\u05d5\u05ea\u05e8 \u05e0\u05d4\u05e0\u05d4 \u05de\u05d9 \u05e9\u05d0\u05e4\u05ea\u05d9 \u05d4\u05d5\u05d0 \u05dc\u05d0 \u05d9\u05d4\u05e0\u05d4 \u05d1\u05e1\u05d3\u05e8, \u05d4\u05db\u05dc \u05d8\u05d5\u05d1"
}