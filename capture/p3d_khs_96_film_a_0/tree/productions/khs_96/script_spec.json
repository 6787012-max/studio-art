   "shots": [
    {
     "id": "s01",
     "dur": 3.6,
     "captions": [
      {
       "id": "G_CAP_01",
       "text": "שהרע יהיה לו כוח. אם היית בורא אותו לכתחילה"
      }
     ]
    },
    {
     "id": "s02",
     "dur": 3.5,
     "captions": [
      {
       "id": "G_CAP_03",
       "text": "בכלוב, אז הוא מראש מוגבל,"
      }
     ]
    },
    {
     "id": "s03",
     "dur": 3.59,
     "captions": [
      {
       "id": "G_CAP_04",
       "text": "כמו כלב מאולף. אנחנו רוצים שהוא לא יהיה כלב מאולף, רוצים שיהיה כלב משוחרר."
      }
     ]
    },
    {
     "id": "s04",
     "dur": 4.87,
     "captions": [
      {
       "id": "G_CAP_08",
       "text": "תופסים אותו בחגורה. אחרי זה סוגרים אותו, אבל הוא עדיין משתולל,"
      }
     ]
    },
    {
     "id": "s05",
     "dur": 3.91,
     "captions": [
      {
       "id": "G_CAP_11",
       "text": "עדיין הוא רוצה להשתלט על כל העולם. אתה מבין למה צריכים שלבים?"
      }
     ]
    },
    {
     "id": "s06",
     "dur": 3.99,
     "captions": [
      {
       "id": "G_CAP_14",
       "text": "אם לכתחילה נברא מוגבל, אז הוא לא היה לו שום כוח לפתות אותך."
      }
     ]
    },
    {
     "id": "s07",
     "dur": 3.72,
     "captions": [
      {
       "id": "G_CAP_17",
       "text": "איזה כלב בתוך כלוב, אתה לא מתרגש ממנו."
      }
     ]
    },
    {
     "id": "s08",
     "dur": 5.8,
     "captions": [
      {
       "id": "G_CAP_19",
       "text": "אבל כלב שהיה משוחרר, עכשיו הוא עם חגורה. זו הסיבה שעשו את זה בשני השלבים."
      }
     ]
    }
   ]
  }
