{
 "G_CAP_01": "\u05e9\u05db\u05dc \u05d0\u05d5\u05e8 \u05d7\u05d9\u05d9\u05d1 \u05e9\u05d9\u05d4\u05d9\u05d4 \u05dc\u05d5 \u05db\u05dc\u05d9. \u05d4\u05d0\u05d5\u05e8 \u05d6\u05d4 \u05e0\u05e9\u05de\u05d4.",
 "G_CAP_04": "\u05d5\u05d0\u05d5\u05e8 \u05e9\u05d1\u05dc\u05d9 \u05db\u05dc\u05d9, \u05d0\u05d6 \u05d4\u05d5\u05d0 \u05de\u05ea\u05e4\u05d6\u05e8, \u05d6\u05d4 \u05db\u05d1\u05e8 \u05dc\u05d0 \u05d0\u05ea \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05d5\u05ea \u05e9\u05dc\u05d5.",
 "G_CAP_08": "\u05dc\u05db\u05df \u05d4\u05d2\u05d5\u05e3, \u05d2\u05dd \u05db\u05e9\u05d4\u05d5\u05d0 \u05d9\u05d6\u05d3\u05db\u05da \u05de\u05d0\u05d5\u05d3 \u05de\u05d0\u05d5\u05d3, \u05d4\u05d5\u05d0 \u05d9\u05d9\u05e9\u05d0\u05e8 \u05ea\u05de\u05d9\u05d3 \u05d7\u05e9\u05d5\u05da \u05dc\u05e2\u05d5\u05de\u05ea \u05d4\u05e0\u05e9\u05de\u05d4.",
 "G_CAP_13": "\u05e9\u05d4\u05e0\u05e9\u05de\u05d4 \u05d4\u05d9\u05d0 \u05ea\u05de\u05d9\u05d3 \u05ea\u05d9\u05e9\u05d0\u05e8 \u05d4\u05d3\u05d1\u05e8 \u05e9\u05de\u05d0\u05d9\u05e8,",
 "G_CAP_15": "\u05d5\u05d4\u05d2\u05d5\u05e3 \u05d6\u05d4 \u05d4\u05d1\u05d9\u05ea \u05e7\u05d9\u05d1\u05d5\u05dc \u05e9\u05de\u05ea\u05d7\u05dd \u05d0\u05d5\u05ea\u05d4,",
 "G_CAP_17": "\u05dc\u05d0 \u05de\u05e6\u05de\u05e6\u05dd \u05d0\u05d5\u05ea\u05d4, \u05d0\u05d1\u05dc \u05de\u05ea\u05d7\u05dd \u05d0\u05d5\u05ea\u05d4, \u05de\u05d2\u05d3\u05d9\u05e8 \u05d0\u05d5\u05ea\u05d4.",
 "LBL_A": "\u05d0\u05d5\u05e8",
 "LBL_B": "\u05db\u05dc\u05d9",
 "LBL_C": "\u05e0\u05e9\u05de\u05d4",
 "LBL_D": "\u05d2\u05d5\u05e3",
 "LBL_E": "\u05de\u05ea\u05e4\u05d6\u05e8",
 "LBL_F": "\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05d5\u05ea",
 "LBL_G": "\u05de\u05d0\u05d9\u05e8",
 "LBL_H": "\u05de\u05d2\u05d3\u05d9\u05e8"
