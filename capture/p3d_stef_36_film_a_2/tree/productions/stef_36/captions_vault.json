{
 "TITLE": "\u05e6\u05d0\u05df \u05d1\u05e8\u05d6\u05dc",
 "KICKER": "\u05d4\u05d2\u05d5\u05d9 \u05e2\u05d3\u05d9\u05d9\u05df \u05d9\u05db\u05d5\u05dc \u05dc\u05ea\u05e4\u05d5\u05e1 \u2014 \u05d4\u05d0\u05dd \u05d4\u05d1\u05db\u05d5\u05e8 \u05e7\u05d3\u05d5\u05e9?",
 "CAP_s02_1": "\u05de\u05d4 \u05d6\u05d4 \u05e6\u05d0\u05df \u05d1\u05e8\u05d6\u05dc?: \u05e2\u05e1\u05e7\u05d4 \u05e2\u05dd \u05e2\u05e8\u05d1\u05d5\u05ea",
 "CAP_s02_2": "\u05d9\u05d4\u05d5\u05d3\u05d9 \u05de\u05e7\u05d1\u05dc \u05e6\u05d0\u05df \u05de\u05d2\u05d5\u05d9 \u05db\u05d3\u05d9 \u05dc\u05d2\u05d3\u05dc \u05d5\u05dc\u05d4\u05e8\u05d5\u05d5\u05d9\u05d7. \u05d0\u05dd \u05d1\u05d4\u05de\u05d4 \u05de\u05ea\u05d4 \u2014 \u05d4\u05d9\u05d4\u05d5\u05d3\u05d9 \u05de\u05e9\u05dc\u05dd \u05d0\u05ea \u05e9\u05d5\u05d5\u05d9\u05d4. \u05d4\u05e7\u05e8\u05df \u05dc\u05d0 \u05e0\u05e9\u05d1\u05e8\u05ea, \u05db\u05de\u05d5 \u05d1\u05e8\u05d6\u05dc.",
 "CAP_s03_1": "\u05d1\u05db\u05d5\u05e8 \u05d1\u05d4\u05de\u05d4: \u05e8\u05e7 \u05db\u05e9\u05d0\u05d9\u05df \u05dc\u05d2\u05d5\u05d9 \u05d7\u05dc\u05e7",
 "CAP_s03_2": "\u05d1\u05db\u05d5\u05e8 \u05e9\u05dc \u05d1\u05d4\u05de\u05d4 \u05e9\u05d9\u05e9 \u05dc\u05d2\u05d5\u05d9 \u05e9\u05d5\u05ea\u05e4\u05d5\u05ea \u05d1\u05d4 \u2014 \u05d0\u05d9\u05e0\u05d5 \u05e7\u05d3\u05d5\u05e9 \u05d1\u05e7\u05d3\u05d5\u05e9\u05ea \u05d1\u05db\u05d5\u05e8.",
 "CAP_s04_1": "\u05d4\u05de\u05d9\u05dc\u05d4 \u05d4\u05d7\u05e9\u05d5\u05d1\u05d4: \u05ea\u05e4\u05d9\u05e1\u05d4",
 "CAP_s04_2": "\u05d0\u05dd \u05d4\u05d9\u05d4\u05d5\u05d3\u05d9 \u05dc\u05d0 \u05d9\u05e9\u05dc\u05dd \u2014 \u05d4\u05d2\u05d5\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05d1\u05d5\u05d0 \u05d5\u05dc\u05ea\u05e4\u05d5\u05e1 \u05d0\u05ea \u05d4\u05d1\u05d4\u05de\u05d5\u05ea. \u05db\u05dc \u05e2\u05d5\u05d3 \u05d4\u05d2\u05d5\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05ea\u05e4\u05d5\u05e1 \u2014 \u05d9\u05e9 \u05dc\u05d5 \u05d1\u05d4\u05df \u05d7\u05dc\u05e7.",
 "CAP_s05_1": "\u05d4\u05de\u05e7\u05d1\u05dc \u05e6\u05d0\u05df \u05d1\u05e8\u05d6\u05dc \u05de\u05df \u05d4\u05e0\u05db\u05e8\u05d9 \u2014 \u05d5\u05dc\u05d3\u05d5\u05ea \u05e4\u05d8\u05d5\u05e8\u05d9\u05df, \u05d5\u05d5\u05dc\u05d3\u05d9 \u05d5\u05dc\u05d3\u05d5\u05ea \u05d7\u05d9\u05d9\u05d1\u05d9\u05df (\u05de\u05e9\u05e0\u05d4 \u05d1\u05db\u05d5\u05e8\u05d5\u05ea \u05d1, \u05d3)",
 "CAP_s06_1": "\u05d4\u05e9\u05d0\u05dc\u05d4: \u05e2\u05d3 \u05d0\u05d9\u05d6\u05d4 \u05d3\u05d5\u05e8?",
 "CAP_s06_2": "\u05d4\u05d2\u05d5\u05d9 \u05ea\u05d5\u05e4\u05e1 \u05d0\u05ea \u05d4\u05d0\u05dd. \u05d0\u05d5\u05dc\u05d9 \u05d2\u05dd \u05d0\u05ea \u05d4\u05d5\u05d5\u05dc\u05d3 \u05e9\u05dc\u05d4? \u05d5\u05d0\u05ea \u05d4\u05e0\u05db\u05d3? \u05e0\u05e8\u05d0\u05d4 \u05d0\u05ea \u05d6\u05d4 \u05e2\u05dc \u05d4\u05dc\u05d5\u05d7\u05d5\u05ea.",
 "CAP_s07_1": "\u05d3\u05d5\u05e8 1: \u05e6\u05d0\u05df \u05d1\u05e8\u05d6\u05dc \u05e9\u05dc \u05d4\u05d2\u05d5\u05d9",
 "CAP_s07_2": "\u05d3\u05d5\u05e8 2 \u05e7\u05e9\u05d5\u05e8 \u05d1\u05e9\u05e8\u05e9\u05e8\u05ea \u05dc\u05d2\u05d5\u05d9",
 "CAP_s07_3": "\u05d3\u05d5\u05e8 3 \u05e0\u05d5\u05dc\u05d3 \u2014 \u05e2\u05d3\u05d9\u05d9\u05df \u05dc\u05d0 \u05d1\u05db\u05d5\u05e8",
 "CAP_s07_4": "\u05d3\u05d5\u05e8 4 \u2014 \u05db\u05d1\u05e8 \u05d1\u05db\u05d5\u05e8!",
 "CAP_s08_1": "\u05de\u05d4 \u05e8\u05d0\u05d9\u05e0\u05d5: \u05d4\u05e9\u05e8\u05e9\u05e8\u05ea \u05e0\u05d2\u05de\u05e8\u05ea",
 "CAP_s08_2": "\u05dc\u05e4\u05d9 \u05e8\u05d1 \u05d4\u05d5\u05e0\u05d0: \u05d3\u05d5\u05e8 1 \u05d5\u05d3\u05d5\u05e8 2 \u05ea\u05e4\u05d5\u05e1\u05d9\u05dd \u05d1\u05d9\u05d3 \u05d4\u05d2\u05d5\u05d9. \u05d3\u05d5\u05e8 3 \u05db\u05d1\u05e8 \u05de\u05e9\u05d5\u05d7\u05e8\u05e8 \u2014 \u05d5\u05dc\u05db\u05df \u05d4\u05d1\u05db\u05d5\u05e8 \u05e9\u05dc\u05d5, \u05d3\u05d5\u05e8 4, \u05e7\u05d3\u05d5\u05e9.",
 "CAP_s09_1": "\u05ea\u05e8\u05d2\u05d9\u05dc \u05d7\u05db\u05dd: \u05d5\u05dc\u05d3 \u05d1\u05de\u05e7\u05d5\u05dd \u05d4\u05d0\u05dd",
 "CAP_s09_2": "\u05d0\u05e4\u05e9\u05e8 \u05dc\u05ea\u05ea \u05dc\u05d2\u05d5\u05d9 \u05d0\u05ea \u05d4\u05d5\u05d5\u05dc\u05d3\u05d5\u05ea \u05d1\u05de\u05e7\u05d5\u05dd \u05d4\u05d0\u05de\u05d4\u05d5\u05ea. \u05d0\u05d6 \u05d4\u05d0\u05de\u05d4\u05d5\u05ea \u05de\u05e9\u05ea\u05d7\u05e8\u05e8\u05d5\u05ea \u2014 \u05d5\u05d4\u05d5\u05d5\u05dc\u05d3\u05d5\u05ea \u05e0\u05db\u05e0\u05e1\u05d9\u05dd \u05dc\u05e9\u05e8\u05e9\u05e8\u05ea.",
 "CAP_s10_1": "\u05d4\u05e2\u05de\u05d9\u05d3 \u05d5\u05dc\u05d3\u05d5\u05ea \u05ea\u05d7\u05ea \u05d0\u05de\u05d5\u05ea\u05d9\u05d4\u05df",
 "CAP_s10_2": "\u05d4\u05d2\u05d5\u05d9 \u05de\u05e7\u05d1\u05dc \u05d5\u05dc\u05d3 \u05d1\u05de\u05e7\u05d5\u05dd \u05d4\u05d0\u05dd",
 "CAP_s10_3": "\u05d4\u05e9\u05e8\u05e9\u05e8\u05ea \u05d6\u05d6\u05d4 \u05d3\u05d5\u05e8 \u05d0\u05d7\u05d3 \u05d4\u05dc\u05d0\u05d4",
 "CAP_s10_4": "\u05d3\u05d5\u05e8 4 \u2014 \u05e2\u05d3\u05d9\u05d9\u05df \u05dc\u05d0 \u05d1\u05db\u05d5\u05e8",
 "CAP_s10_5": "\u05d3\u05d5\u05e8 5 \u2014 \u05d1\u05db\u05d5\u05e8!",
 "CAP_s11_1": "\u05de\u05d7\u05dc\u05d5\u05e7\u05ea: \u05e8\u05d1 \u05d4\u05d5\u05e0\u05d0 \u05d5\u05e8\u05d1 \u05d9\u05d4\u05d5\u05d3\u05d4",
 "CAP_s11_2": "\u05dc\u05e8\u05d1 \u05d9\u05d4\u05d5\u05d3\u05d4, \u05d4\u05d2\u05d5\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05ea\u05e4\u05d5\u05e1 \u05d2\u05dd \u05d0\u05ea \u05d4\u05d1\u05df \u05e9\u05dc \u05d4\u05d1\u05d4\u05de\u05d4 \u2014 \u05d5\u05dc\u05db\u05df \u05d4\u05e9\u05e8\u05e9\u05e8\u05ea \u05d0\u05e8\u05d5\u05db\u05d4 \u05d9\u05d5\u05ea\u05e8. \u05d1\u05d3\u05d5\u05e8 4 \u05d4\u05dd \u05d7\u05dc\u05d5\u05e7\u05d9\u05dd.",
 "CAP_s12_1": "\u05d3\u05d5\u05e8 1 \u2014 \u05d1\u05d9\u05d3 \u05d4\u05d2\u05d5\u05d9 \u05db\u05de\u05e9\u05db\u05d5\u05df",
 "CAP_s12_2": "\u05d3\u05d5\u05e8 2 \u2014 \u05d0\u05d9\u05e0\u05d5 \u05e7\u05d3\u05d5\u05e9",
 "CAP_s12_3": "\u05d3\u05d5\u05e8 3 \u2014 \u05d2\u05dd \u05d0\u05d9\u05e0\u05d5 \u05e7\u05d3\u05d5\u05e9",
 "CAP_s12_4": "\u05d3\u05d5\u05e8\u05d5\u05ea 1 \u05e2\u05d3 3: \u05dc\u05d0 \u05e7\u05d3\u05d5\u05e9\u05d9\u05dd",
 "CAP_s12_5": "\u05d3\u05d5\u05e8 4 \u2014 \u05de\u05d7\u05dc\u05d5\u05e7\u05ea \u05d0\u05de\u05d5\u05e8\u05d0\u05d9\u05dd",
 "CAP_s13_1": "\u05d4\u05d9\u05d4\u05d5\u05d3\u05d9 \u05de\u05d2\u05d3\u05dc \u05d0\u05ea \u05d4\u05e6\u05d0\u05df \u05d5\u05d3\u05d5\u05d0\u05d2 \u05dc\u05d4\u05df. \u05dc\u05de\u05d4 \u05d4\u05d1\u05db\u05d5\u05e8 \u05e9\u05dc\u05d4\u05df \u05dc\u05d0 \u05e7\u05d3\u05d5\u05e9?",
 "CAP_s13_2": "\u05db\u05d9 \u05d4\u05d2\u05d5\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05ea\u05e4\u05d5\u05e1 \u05d0\u05d5\u05ea\u05df \u2014 \u05d5\u05d9\u05e9 \u05dc\u05d5 \u05d1\u05d4\u05df \u05d7\u05dc\u05e7",
 "CAP_s14_1": "\u05de\u05d4 \u05de\u05e9\u05ea\u05e0\u05d4 \u05db\u05e9\u05e0\u05d5\u05ea\u05e0\u05d9\u05dd \u05dc\u05d2\u05d5\u05d9 \u05d0\u05ea \u05d4\u05d5\u05d5\u05dc\u05d3\u05d5\u05ea \u05d1\u05de\u05e7\u05d5\u05dd \u05d4\u05d0\u05de\u05d4\u05d5\u05ea?",
 "CAP_s14_2": "\u05d4\u05e9\u05e8\u05e9\u05e8\u05ea \u05d6\u05d6\u05d4 \u05d3\u05d5\u05e8 \u05d0\u05d7\u05d3 \u05d4\u05dc\u05d0\u05d4: \u05d4\u05d0\u05de\u05d4\u05d5\u05ea \u05de\u05e9\u05ea\u05d7\u05e8\u05e8\u05d5\u05ea \u05d5\u05d4\u05d5\u05d5\u05dc\u05d3\u05d5\u05ea \u05e0\u05ea\u05e4\u05e1\u05d9\u05dd",
 "CAP_s15_1": "\u05e6\u05d0\u05df \u05d1\u05e8\u05d6\u05dc \u2014 \u05d4\u05d2\u05d5\u05d9 \u05d9\u05db\u05d5\u05dc \u05ea\u05de\u05d9\u05d3 \u05dc\u05ea\u05e4\u05d5\u05e1 \u05d0\u05ea \u05d4\u05d1\u05d4\u05de\u05d5\u05ea \u00b7 \u05d1\u05d4\u05de\u05d4 \u05e9\u05d4\u05d2\u05d5\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05ea\u05e4\u05d5\u05e1 \u2014 \u05d4\u05d1\u05db\u05d5\u05e8 \u05e9\u05dc\u05d4 \u05dc\u05d0 \u05e7\u05d3\u05d5\u05e9",
 "CAP_s15_2": "\u05d4\u05e9\u05e8\u05e9\u05e8\u05ea \u05e2\u05d5\u05d1\u05e8\u05ea \u05d3\u05d5\u05e8 \u05d0\u05d7\u05e8\u05d9 \u05d3\u05d5\u05e8 \u2014 \u05d5\u05e0\u05d2\u05de\u05e8\u05ea \u00b7 \u05e2\u05d3 \u05d0\u05d9\u05d6\u05d4 \u05d3\u05d5\u05e8? \u05e2\u05dc \u05d6\u05d4 \u05e0\u05d7\u05dc\u05e7\u05d5 \u05e8\u05d1 \u05d4\u05d5\u05e0\u05d0 \u05d5\u05e8\u05d1 \u05d9\u05d4\u05d5\u05d3\u05d4",
 "CAP_s16_1": "\u05e7\u05d8\u05e2\u05d9 \u05d4\u05d4\u05e0\u05e4\u05e9\u05d4: \u05e8\u05f3 \u05d0\u05dc\u05d9 \u05e1\u05d8\u05e4\u05e0\u05e1\u05e7\u05d9 | \u05de\u05e8\u05db\u05d6 \u05d3\u05e3 \u05d9\u05d5\u05de\u05d9 \u00b7 MDY | \u05de\u05e0\u05d2\u05d9\u05e0\u05d4 \u05de\u05e7\u05d5\u05e8\u05d9\u05ea \u00b7 \u05e2\u05e8\u05d9\u05db\u05d4: \u05de\u05db\u05d9\u05e0\u05ea \u05d1\u05d9\u05ea \u05d4\u05ea\u05dc\u05de\u05d5\u05d3"
}