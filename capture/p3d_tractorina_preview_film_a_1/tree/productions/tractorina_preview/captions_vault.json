{
 "TITLE": "\u05d0\u05e0\u05d9 \u05d9\u05dc\u05d3 \u05d8\u05e8\u05e7\u05d8\u05d5\u05e8\u05d9\u05e0\u05d4",
 "KICKER": "\u05ea\u05e6\u05d5\u05d2\u05d4 \u05de\u05e7\u05d3\u05d9\u05de\u05d4",
 "CAP_01": "\u05d0\u05b2\u05e0\u05b4\u05d9 \u05dc\u05b9\u05d0 \u05e8\u05b6\u05db\u05b6\u05d1 \u05e9\u05b6\u05c1\u05e0\u05bc\u05d5\u05b9\u05e1\u05b5\u05e2\u05b7 \u05d7\u05b8\u05dc\u05b8\u05e7",
 "CAP_02": "\u05d3\u05b6\u05bc\u05e8\u05b6\u05da\u05b0 \u05e2\u05b8\u05e4\u05b8\u05e8 \u05d0\u05b7\u05d7\u05b2\u05e8\u05b5\u05d9 \u05d4\u05b7\u05d2\u05b6\u05bc\u05e9\u05b6\u05c1\u05dd",
 "LBL_02a": "\u05d3\u05e8\u05da \u05e2\u05e4\u05e8",
 "CAP_03": "\u05d4\u05b7\u05de\u05b0\u05bc\u05db\u05d5\u05b9\u05e0\u05b4\u05d9\u05ea \u05d4\u05b7\u05de\u05b7\u05bc\u05d1\u05b0\u05e8\u05b4\u05d9\u05e7\u05b8\u05d4 \u05ea\u05b0\u05bc\u05e7\u05d5\u05bc\u05e2\u05b8\u05d4 \u05d1\u05b7\u05bc\u05d1\u05bc\u05d5\u05b9\u05e5",
 "CAP_04": "\u05d0\u05b7\u05e8\u05b0\u05d1\u05b8\u05bc\u05e2\u05b8\u05d4 \u05d2\u05b7\u05bc\u05dc\u05b0\u05d2\u05b7\u05bc\u05dc\u05b4\u05bc\u05d9\u05dd \u05d1\u05b8\u05bc\u05d0\u05b4\u05d9\u05dd",
 "CAP_05": "\u05d2\u05b7\u05bc\u05dc\u05b0\u05d2\u05b7\u05bc\u05dc \u05d0\u05b6\u05d7\u05b8\u05d3 \u05e8\u05d5\u05b9\u05d0\u05b6\u05d4 \u05de\u05b7\u05d4 \u05e9\u05b6\u05bc\u05c1\u05dc\u05b9\u05bc\u05d0 \u05e8\u05d5\u05b9\u05d0\u05b4\u05d9\u05dd",
 "LBL_05a": "\u05d0\u05d1\u05df",
 "CAP_06": "\u05d2\u05b7\u05bc\u05dc\u05b0\u05d2\u05b7\u05bc\u05dc \u05e9\u05b5\u05c1\u05e0\u05b4\u05d9 \u05e7\u05d5\u05b9\u05e9\u05b5\u05c1\u05e8 \u05d5\u05b0\u05dc\u05b9\u05d0 \u05de\u05b7\u05d0\u05b2\u05e9\u05b4\u05c1\u05d9\u05dd: \u05d4\u05b7\u05d8\u05b8\u05bc\u05e2\u05d5\u05bc\u05ea \u05e9\u05b6\u05c1\u05dc\u05b4\u05bc\u05d9",
 "LBL_06a": "\u05de\u05d4\u05d3\u05e7 \u05e4\u05e2\u05de\u05d9\u05d9\u05dd",
 "CAP_07": "\u05d2\u05b7\u05bc\u05dc\u05b0\u05d2\u05b7\u05bc\u05dc \u05e9\u05b0\u05c1\u05dc\u05b4\u05d9\u05e9\u05b4\u05c1\u05d9 \u05de\u05b7\u05de\u05b0\u05ea\u05b4\u05bc\u05d9\u05df \u05dc\u05b7\u05e9\u05b0\u05bc\u05c1\u05e8\u05b4\u05d9\u05e7\u05b8\u05d4: \u05e2\u05b7\u05db\u05b0\u05e9\u05b8\u05c1\u05d9\u05d5",
 "LBL_07a": "\u05de\u05d7\u05db\u05d9\u05dd \u05dc\u05e1\u05d9\u05de\u05df",
 "CAP_08": "\u05d2\u05b7\u05bc\u05dc\u05b0\u05d2\u05b7\u05bc\u05dc \u05e8\u05b0\u05d1\u05b4\u05d9\u05e2\u05b4\u05d9: \u05e2\u05d5\u05b9\u05d3 \u05e4\u05b7\u05bc\u05e2\u05b7\u05dd, \u05e2\u05d5\u05b9\u05d3 \u05e4\u05b7\u05bc\u05e2\u05b7\u05dd",
 "LBL_08a": "\u05e0\u05d9\u05e1\u05d9\u05d5\u05df 1",
 "LBL_08b": "\u05e0\u05d9\u05e1\u05d9\u05d5\u05df 2",
 "LBL_08c": "\u05e0\u05d9\u05e1\u05d9\u05d5\u05df 3",
 "CAP_09": "\u05d0\u05b2\u05e0\u05b4\u05d9 \u05d9\u05b6\u05dc\u05b6\u05d3 \u05d8\u05b0\u05e8\u05b7\u05e7\u05b0\u05d8\u05d5\u05b9\u05e8\u05b4\u05d9\u05e0\u05b8\u05d4",
 "LBL_09a": "\u05de\u05db\u05d9\u05e0\u05ea \u05d1\u05d9\u05ea \u05d4\u05ea\u05dc\u05de\u05d5\u05d3 \u00b7 \u05d1\u05d9\u05ea \u05e9\u05de\u05e9"
}
