# -*- coding: utf-8 -*-
"""Render lobby-halacha episodes on the remote servers, one after another, with automatic retry of failed parts.
    python template/render_all.py <episode> [<episode> ...] [--part 50]
For each episode: read the real length (window.__dur) in a headless browser, render_parts.py, then retry_part.py (split in two)
for any part that failed, up to 2 rounds.  Output: episodes/<ep>/render/out.mp4   Log: episodes/<ep>/render/render_all.log
(Adapted from azamra342/render_all.py. Do not run it casually: it uses the remote render quota.)"""
import io, json, os, re, subprocess, sys, time

try:
    import psutil
    psutil.Process().nice(psutil.IDLE_PRIORITY_CLASS)
except Exception:
    pass
HERE = os.path.dirname(os.path.abspath(__file__)).replace(os.sep, '/'); BASE = os.path.dirname(HERE)
NOWIN = getattr(subprocess, 'CREATE_NO_WINDOW', 0)
PART = sys.argv[sys.argv.index('--part') + 1] if '--part' in sys.argv else '50'
args = [x for x in sys.argv[1:] if not x.startswith('--') and x != PART]


def epdir(ep):
    return os.path.abspath(ep if os.path.isdir(ep) else os.path.join(BASE, 'episodes', ep)).replace(os.sep, '/')


def film_dur(d):
    from playwright.sync_api import sync_playwright
    url = 'file:///' + HERE + '/film.html?ep=' + os.path.relpath(d + '/episode.js', HERE).replace(os.sep, '/')
    with sync_playwright() as p:
        b = p.chromium.launch(channel='msedge', headless=True, args=['--use-angle=swiftshader', '--enable-unsafe-swiftshader', '--allow-file-access-from-files', '--ignore-gpu-blocklist'])
        try:
            pg = b.new_page(viewport={'width': 640, 'height': 360})
            pg.goto(url, wait_until='load')
            pg.wait_for_function('window.__ready === true', timeout=600000)
            return float(pg.evaluate('window.__dur'))
        finally:
            b.close()


def probe(f):
    r = subprocess.run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'csv=p=0', f], capture_output=True, text=True, creationflags=NOWIN)
    return float(r.stdout.strip() or 0)


summary = {}
for ep in args:
    d = epdir(ep); name = os.path.basename(d); os.makedirs(d + '/render', exist_ok=True); LOG = d + '/render/render_all.log'

    def log(s):
        line = time.strftime('%H:%M:%S ') + s
        io.open(LOG, 'a', encoding='utf-8').write(line + '\n'); print(line, flush=True)
    try:
        dur = round(film_dur(d), 3)
    except Exception as e:
        log('%s: could not read length: %s' % (name, e)); summary[name] = 'no length'; continue
    log('%s: length %.1fs, rendering (part %s s)' % (name, dur, PART))
    r = subprocess.run([sys.executable, HERE + '/render_parts.py', d, str(dur), '--part', PART], capture_output=True, text=True, encoding='utf-8', errors='replace', creationflags=NOWIN)
    out = (r.stdout or '') + (r.stderr or '')
    for rnd in range(2):
        bad = sorted(set(int(x) for x in re.findall(r'FAILED part (\d+)', out)))
        if r.returncode == 0 and not bad:
            break
        log('%s: failed parts %s, retry round %d' % (name, bad or '?', rnd + 1))
        out = ''
        for i in bad:
            r = subprocess.run([sys.executable, HERE + '/retry_part.py', d, str(dur), str(i), '--split', '2', '--part', PART], capture_output=True, text=True, encoding='utf-8', errors='replace', creationflags=NOWIN)
            out += (r.stdout or '') + (r.stderr or '')
            if r.returncode:
                out += '\nFAILED part %d\n' % i
    f = d + '/render/out.mp4'
    got = probe(f) if os.path.exists(f) else 0
    summary[name] = 'ok %.1fs' % got if got and abs(got - dur) < 1.0 else 'BAD (%.1fs of %.1fs)' % (got, dur)
    log('%s: %s' % (name, summary[name]))
print('DONE ' + json.dumps(summary, ensure_ascii=False))
