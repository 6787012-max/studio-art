{
 "TITLE": "\u05db\u05d3\u05d9 \u05e9\u05e0\u05d4\u05d9\u05d4 \u05d1\u05e7\u05e9\u05e8",
 "KICKER": "\u05e9\u05d9\u05d7 \u05d4\u05d1\u05d5\u05e7\u05e8 \u05d1\u05d1\u05d9\u05ea \u05d4\u05de\u05d3\u05e8\u05e9 \u00b7 \u05e4\u05e8\u05e9\u05ea \u05dc\u05da \u05dc\u05da \u05ea\u05e9\u05e4\u05f4\u05d6",
 "RECAP_1": "\u05d9\u05e9 \u05de\u05d9 \u05e9\u05de\u05d1\u05e8\u05da \u05db\u05d3\u05d9 \u05dc\u05d0\u05db\u05d5\u05dc, \u05d5\u05d9\u05e9 \u05de\u05d9 \u05e9\u05d0\u05d5\u05db\u05dc \u05db\u05d3\u05d9 \u05dc\u05d1\u05e8\u05da",
 "RECAP_2": "\u05d4\u05e7\u05d5\u05e9\u05d9 \u05d1\u05d0 \u05de\u05d0\u05d4\u05d1\u05d4, \u05db\u05d3\u05d9 \u05e9\u05e0\u05d4\u05d9\u05d4 \u05d1\u05e7\u05e9\u05e8",
 "RECAP_3": "\u05d0\u05e3 \u05ea\u05e4\u05d9\u05dc\u05d4 \u05dc\u05d0 \u05d4\u05d5\u05dc\u05db\u05ea \u05dc\u05d0\u05d9\u05d1\u05d5\u05d3",
 "CAP_S_01": "\u05de\u05e9\u05dc: \u05e8\u05d1\u05d9 \u05d5\u05ea\u05dc\u05de\u05d9\u05d3\u05d5, \u05d5\u05e7\u05e2\u05e8\u05ea \u05ea\u05e4\u05d5\u05d7\u05d9\u05dd \u05e2\u05dc \u05d4\u05e9\u05d5\u05dc\u05d7\u05df",
 "CAP_S_02": "\u05d4\u05ea\u05dc\u05de\u05d9\u05d3 \u05de\u05e1\u05ea\u05db\u05dc \u05e2\u05dc \u05d4\u05ea\u05e4\u05d5\u05d7\u05d9\u05dd, \u05d4\u05d5\u05d0 \u05d0\u05d5\u05d4\u05d1 \u05ea\u05e4\u05d5\u05d7\u05d9\u05dd",
 "CAP_S_03": "\u05d4\u05ea\u05dc\u05de\u05d9\u05d3 \u05de\u05d1\u05e8\u05da, \u05db\u05d3\u05d9 \u05e9\u05d9\u05d5\u05db\u05dc \u05dc\u05d0\u05db\u05d5\u05dc",
 "CAP_S_04": "\u05d4\u05d1\u05e8\u05db\u05d4 \u05d1\u05d0\u05d4 \u05d1\u05e9\u05d1\u05d9\u05dc \u05d4\u05ea\u05e4\u05d5\u05d7",
 "CAP_S_05": "\u05d4\u05e8\u05d1\u05d9 \u05d0\u05d5\u05db\u05dc, \u05db\u05d3\u05d9 \u05e9\u05d9\u05d5\u05db\u05dc \u05dc\u05d1\u05e8\u05da",
 "CAP_S_06": "\u05d4\u05ea\u05e4\u05d5\u05d7 \u05d4\u05d5\u05d0 \u05d4\u05d3\u05e8\u05da \u05d0\u05dc \u05d4\u05d1\u05e8\u05db\u05d4",
 "CAP_S_07": "\u05d0\u05d5\u05ea\u05d5 \u05de\u05e2\u05e9\u05d4 \u05d1\u05d3\u05d9\u05d5\u05e7, \u05d1\u05e9\u05e0\u05d9 \u05db\u05d9\u05d5\u05d5\u05e0\u05d9\u05dd \u05d4\u05e4\u05d5\u05db\u05d9\u05dd",
 "CAP_S_08": "\u05d4\u05e9\u05d0\u05dc\u05d4 \u05d4\u05d9\u05d0: \u05d1\u05e9\u05d1\u05d9\u05dc \u05de\u05d4?",
 "CAP_S_09": "\u05db\u05e9\u05d4\u05db\u05d5\u05dc \u05d8\u05d5\u05d1 \u05d5\u05de\u05e1\u05d5\u05d3\u05e8",
 "CAP_S_10": "\u05e0\u05d3\u05de\u05d4 \u05e9\u05dc\u05d0 \u05d7\u05e1\u05e8 \u05dc\u05e0\u05d5 \u05db\u05dc\u05d5\u05dd",
 "CAP_S_11": "\u05d1\u05dc\u05d9 \u05dc\u05e9\u05d9\u05dd \u05dc\u05d1, \u05de\u05ea\u05e8\u05d7\u05e7\u05d9\u05dd",
 "CAP_S_12": "\u05d5\u05e9\u05d5\u05db\u05d7\u05d9\u05dd \u05dc\u05e4\u05e0\u05d5\u05ea \u05d0\u05dc \u05d4\u05f3",
 "CAP_S_13": "\u05d5\u05d0\u05d6 \u05de\u05d2\u05d9\u05e2 \u05e7\u05d5\u05e9\u05d9",
 "CAP_S_14": "\u05d4\u05d5\u05d0 \u05dc\u05d0 \u05d1\u05d0 \u05de\u05e9\u05e0\u05d0\u05d4, \u05d0\u05dc\u05d0 \u05de\u05d0\u05d4\u05d1\u05d4",
 "CAP_S_15": "\u05db\u05d3\u05d9 \u05e9\u05e0\u05d7\u05d6\u05d5\u05e8 \u05d5\u05e0\u05d4\u05d9\u05d4 \u05d1\u05e7\u05e9\u05e8",
 "CAP_S_16": "\u05db\u05dc \u05ea\u05e4\u05d9\u05dc\u05d4 \u05e2\u05d5\u05dc\u05d4 \u05dc\u05de\u05e2\u05dc\u05d4",
 "CAP_S_17": "\u05d0\u05e3 \u05ea\u05e4\u05d9\u05dc\u05d4 \u05dc\u05d0 \u05d7\u05d5\u05d6\u05e8\u05ea \u05e8\u05d9\u05e7\u05dd",
 "CAP_S_18": "\u05d4\u05f3 \u05e9\u05d5\u05de\u05e8 \u05d0\u05ea \u05d4\u05ea\u05e4\u05d9\u05dc\u05d5\u05ea \u05d1\u05d0\u05d5\u05e6\u05e8",
 "CAP_S_19": "\u05dc\u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05de\u05e9\u05da \u05e9\u05e0\u05d9\u05dd \u05e8\u05d1\u05d5\u05ea",
 "CAP_S_20": "\u05d9\u05dc\u05d3 \u05d7\u05d5\u05e6\u05d4 \u05d0\u05ea \u05d4\u05db\u05d1\u05d9\u05e9",
 "CAP_S_21": "\u05d5\u05e8\u05db\u05d1 \u05de\u05ea\u05e7\u05e8\u05d1 \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea",
 "CAP_S_22": "\u05d1\u05e8\u05d2\u05e2 \u05d4\u05d0\u05d7\u05e8\u05d5\u05df, \u05d4\u05e8\u05db\u05d1 \u05e0\u05e2\u05e6\u05e8",
 "CAP_S_23": "\u05de\u05d4 \u05d4\u05e6\u05d9\u05dc \u05d0\u05d5\u05ea\u05d5?",
 "CAP_S_24": "\u05ea\u05e4\u05d9\u05dc\u05d5\u05ea \u05e9\u05d4\u05ea\u05e4\u05dc\u05dc\u05d5 \u05e4\u05e2\u05dd, \u05e2\u05dc \u05d3\u05d1\u05e8\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd",
 "CAP_S_25": "\u05d4\u05f3 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05d5\u05ea\u05df \u05d1\u05d3\u05d9\u05d5\u05e7 \u05dc\u05e8\u05d2\u05e2 \u05d4\u05d6\u05d4",
 "CAP_S_26": "\u05dc\u05d0 \u05dc\u05e4\u05d7\u05d3 \u05dc\u05d4\u05e6\u05dc\u05d9\u05d7",
 "CAP_S_27": "\u05dc\u05e7\u05d5\u05dd \u05d1\u05d6\u05de\u05df, \u05dc\u05d4\u05d2\u05d9\u05e2 \u05d1\u05d6\u05de\u05df",
 "CAP_S_28": "\u05d0\u05d9\u05df \u05d1\u05e2\u05d5\u05dc\u05dd \u05ea\u05e4\u05d9\u05dc\u05d4 \u05db\u05de\u05d5 \u05e9\u05dc\u05da",
 "CAP_S_29": "\u05db\u05d9 \u05d0\u05d9\u05df \u05e2\u05d5\u05d3 \u05d0\u05d7\u05d3 \u05db\u05de\u05d5\u05da"
}
