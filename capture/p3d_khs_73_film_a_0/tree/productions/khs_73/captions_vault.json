{
 "CAP_A_01": "\u05d0\u05d5\u05de\u05e8 \u05e9\u05de\u05d4 \u05d4\u05e9\u05d5\u05dc\u05d7\u05df \u05e2\u05e8\u05d5\u05da \u05d4\u05e8\u05d1 \u05d3\u05d1\u05e8 \u05e0\u05e4\u05dc\u05d0 \u05d1\u05e1\u05e4\u05e8 \u05d4\u05ea\u05e0\u05d9\u05d0 \u05e9\u05dc\u05d5",
 "CAP_A_02": "\u05e9\u05dc\u05db\u05df \u05d4\u05e7\u05d3\u05d5\u05e9 \u05d1\u05e8\u05d5\u05da \u05d4\u05d5\u05d0 \u05d2\u05dd \u05e0\u05ea\u05df \u05dc\u05e0\u05d5 \u05d1\u05ea\u05d5\u05e8\u05d4 \u05d4\u05de\u05d5\u05df \u05d4\u05dc\u05db\u05d5\u05ea \u05de\u05ea\u05d9 \u05d6\u05d4 \u05e7\u05e8\u05d4 \u05d3\u05d1\u05e8 \u05db\u05d6\u05d4",
 "CAP_A_03": "\u05d0\u05e3 \u05e4\u05e2\u05dd \u05dc\u05d0 \u05e7\u05e8\u05d4 \u05d5\u05dc\u05d0 \u05d9\u05e7\u05e8\u05d4 \u05db\u05e0\u05e8\u05d0\u05d4 \u05dc\u05de\u05d4 \u05d4\u05e7\u05d3\u05d5\u05e9 \u05d1\u05e8\u05d5\u05da \u05d4\u05d5\u05d0 \u05de\u05dc\u05de\u05d3 \u05db\u05d9 \u05d4\u05d9\u05d5\u05ea \u05d1\u05e8\u05e6\u05d5\u05e0\u05d5 \u05d9\u05ea\u05d1\u05e8\u05da",
 "CAP_A_04": "\u05e9\u05d1\u05db\u05d6\u05d4 \u05de\u05e6\u05d1 \u05db\u05db\u05d4 \u05d9\u05d4\u05d9\u05d4 \u05d4\u05d3\u05d9\u05df \u05d0\u05d1\u05dc \u05d6\u05d4 \u05e8\u05e6\u05d5\u05e0\u05d5 \u05e9\u05db\u05db\u05d4 \u05d6\u05d4 \u05d9\u05d4\u05d9\u05d4",
 "CAP_A_05": "\u05d0\u05d6 \u05d1\u05e8\u05d2\u05e2 \u05e9\u05e0\u05d3\u05d1\u05e7\u05ea \u05d1\u05e8\u05e6\u05d5\u05e0\u05d5 \u05d0\u05d6 \u05d0\u05ea\u05d4 \u05e2\u05d5\u05d3 \u05d9\u05d5\u05ea\u05e8 \u05d3\u05d1\u05d5\u05e7 \u05dc\u05d0 \u05e9\u05d6\u05d4 \u05d9\u05d4\u05d9\u05d4 \u05de\u05e9\u05d4\u05d5 \u05dc\u05de\u05e2\u05e9\u05d4 \u05d1\u05e2\u05d5\u05dc\u05dd \u05d4\u05d6\u05d4",
 "CAP_A_06": "\u05d0\u05d1\u05dc \u05e8\u05e6\u05d5\u05e0\u05d5 \u05db\u05db\u05d4 \u05d9\u05d4\u05d9\u05d4 \u05d0\u05d6 \u05d0\u05ea\u05d4 \u05d3\u05d1\u05d5\u05e7 \u05d1\u05e8\u05e6\u05d5\u05e0\u05d5 \u05d1\u05d6\u05d4 \u05e9\u05d0\u05ea\u05d4 \u05d4\u05d1\u05e0\u05ea \u05d0\u05ea \u05d4\u05e1\u05d5\u05d2\u05d9\u05d4 \u05d4\u05d6\u05d0\u05ea",
 "CAP_A_07": "\u05db\u05db\u05d4 \u05d4\u05d5\u05d0 \u05db\u05d5\u05ea\u05d1 \u05e9\u05de\u05d4 \u05dc\u05db\u05df \u05d9\u05e9 \u05d4\u05de\u05d5\u05df \u05de\u05e7\u05e8\u05d9\u05dd \u05de\u05e9\u05d5\u05e0\u05d9\u05dd \u05d1\u05e9\"\u05e1 \u05db\u05d9 \u05d6\u05d4 \u05dc\u05d0 \u05de\u05e2\u05e0\u05d9\u05d9\u05df \u05d0\u05d5\u05ea\u05e0\u05d5",
 "CAP_A_08": "\u05d0\u05e0\u05d9 \u05e8\u05d5\u05e6\u05d4 \u05e9\u05ea\u05d1\u05d9\u05df \u05de\u05d4 \u05e8\u05e6\u05d5\u05e0\u05d9 \u05d5\u05ea\u05ea\u05d9\u05d9\u05d2\u05e2 \u05de\u05d4 \u05d4\u05d9\u05d4 \u05dc\u05d5 \u05d1\u05db\u05d6\u05d4 \u05de\u05e7\u05e8\u05d4",
 "CAP_A_09": "\u05d5\u05db\u05e9\u05d0\u05e0\u05d9 \u05d0\u05d3\u05d1\u05e7 \u05d1\u05e8\u05e6\u05d5\u05df \u05d4\u05e9\u05dd \u05d1\u05d3\u05d1\u05e8 \u05d4\u05d6\u05d4 \u05d3\u05d1\u05e7\u05ea\u05d9 \u05d1\u05e7\u05d3\u05d5\u05e9 \u05d1\u05e8\u05d5\u05da \u05d4\u05d5\u05d0",
 "CAP_A_10": "\u05d1\u05e2\u05d5\u05d3 \u05e7\u05d8\u05e2 \u05e2\u05d5\u05d3 \u05e7\u05d8\u05e2 \u05e2\u05d5\u05d3 \u05e7\u05d8\u05e2 \u05d0\u05d6 \u05d1\u05e8\u05d2\u05e2 \u05e9\u05d3\u05d1\u05d5\u05e7 \u05d1\u05db\u05dc \u05e8\u05e6\u05d5\u05e0\u05d5",
 "CAP_A_11": "\u05de\u05d9\u05e9\u05d4\u05d5 \u05d9\u05d5\u05d3\u05e2 \u05d0\u05ea \u05db\u05dc \u05d4\u05ea\u05d5\u05e8\u05d4 \u05db\u05d5\u05dc\u05d4 \u05d4\u05d5\u05d0 \u05d6\u05d4 \u05d3\u05d1\u05d5\u05e7 \u05d1\u05e7\u05d3\u05d5\u05e9 \u05d1\u05e8\u05d5\u05da \u05d4\u05d5\u05d0 \u05d1\u05dc\u05d9 \u05e9\u05d5\u05dd \u05d0\u05d9\u05df \u05e9\u05d5\u05dd \u05db\u05d0\u05d9\u05dc\u05d5 \u05e0\u05e7\u05d5\u05d3\u05d4 \u05e9\u05dc\u05d0 \u05d3\u05d1\u05d5\u05e7 \u05d1\u05d5"
}
