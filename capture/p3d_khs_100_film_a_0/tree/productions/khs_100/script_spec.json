   "shots": [
    {
     "id": "s01",
     "dur": 5.1,
     "captions": [
      {
       "id": "G_CAP_01",
       "text": "הוא מלך, לא צריך אף אחד, אשר מלך בטרם כל יציר נברא, אבל הוא העמיד"
      }
     ]
    },
    {
     "id": "s02",
     "dur": 5.33,
     "captions": [
      {
       "id": "G_CAP_04",
       "text": "את הבריאה בצורה כזאת שהוא זקוק לנו. אין מלך בלא עם."
      }
     ]
    },
    {
     "id": "s03",
     "dur": 3.86,
     "captions": [
      {
       "id": "G_CAP_07",
       "text": "אני רוצה יצורים בעלי בחירה,"
      }
     ]
    },
    {
     "id": "s04",
     "dur": 5.16,
     "captions": [
      {
       "id": "G_CAP_08",
       "text": "בעלי צד מרידה. אם הם לא יכולים למרוד בי, אין שום משמעות"
      }
     ]
    },
    {
     "id": "s05",
     "dur": 4.71,
     "captions": [
      {
       "id": "G_CAP_11",
       "text": "לזה שממליכים אותו. אם הם רובוטים, לא צריך אותם. כל הבעלי"
      }
     ]
    },
    {
     "id": "s06",
     "dur": 3.73,
     "captions": [
      {
       "id": "G_CAP_14",
       "text": "חיים וכל הדומם, הם לא זזים מילימטר מהתפקיד שלהם."
      }
     ]
    },
    {
     "id": "s07",
     "dur": 5.01,
     "captions": [
      {
       "id": "G_CAP_17",
       "text": "אני רוצה יצור שיכול להיות שקרן. שאני יכול לסובב את המציאות"
      }
     ]
    },
    {
     "id": "s08",
     "dur": 3.24,
     "captions": [
      {
       "id": "G_CAP_20",
       "text": "לפי מה שאני רוצה שזה יהיה, למרות שזה לא המציאות האמיתית."
      }
     ]
    },
    {
     "id": "s09",
     "dur": 3.32,
     "captions": [
      {
       "id": "G_CAP_23",
       "text": "אני יכול לראות את הקדוש ברוך הוא בעולם, בבריאה, אני יכול לראות טבע"
      }
     ]
    },
    {
     "id": "s10",
     "dur": 3.15,
     "captions": [
      {
       "id": "G_CAP_26",
       "text": "נפלא, ולהגיד: מקרה."
      }
     ]
    }
   ]
  }
 ]
}