{
 "TITLE": "\u05d0\u05d5\u05ea\u05d5 \u05d5\u05d0\u05ea \u05d1\u05e0\u05d5",
 "CAP_S01": "\u05d0\u05d5\u05ea\u05d5 \u05d5\u05d0\u05ea \u05d1\u05e0\u05d5 - \u05dc\u05d0 \u05d1\u05d9\u05d5\u05dd \u05d0\u05d7\u05d3",
 "LBL_TITLE": "\u05d0\u05d5\u05ea\u05d5 \u05d5\u05d0\u05ea \u05d1\u05e0\u05d5",
