 "CAP_S02": "\u05d0\u05de\u05d0 \u05d5\u05d1\u05e0\u05d4 \u2014 \u05dc\u05d0 \u05d1\u05d0\u05d5\u05ea\u05d5 \u05d9\u05d5\u05dd",
 "LBL_S02_KICK": "\u05d4\u05de\u05d5\u05e9\u05d2",
 "LBL_S02_SUB": "\u05d0\u05d9\u05e1\u05d5\u05e8 \u05d1\u05e9\u05d7\u05d9\u05d8\u05ea \u05d1\u05d4\u05de\u05d4",
 "CAP_S03": "\u05d5\u05e9\u05d5\u05e8 \u05d0\u05d5 \u05e9\u05d4, \u05d0\u05ea\u05d5 \u05d5\u05d0\u05ea \u05d1\u05e0\u05d5 \u05dc\u05d0 \u05ea\u05e9\u05d7\u05d8\u05d5 \u05d1\u05d9\u05d5\u05dd \u05d0\u05d7\u05d3",
 "LBL_S03_REF": "\u05d5\u05d9\u05e7\u05e8\u05d0 \u05db\u05d1, \u05db\u05d7",
 "CAP_S04_01": "\u05d0\u05de\u05d0 \u05e4\u05e8\u05d4 \u2014 \u05d5\u05d4\u05e2\u05d2\u05dc\u05d9\u05dd \u05e9\u05dc\u05d4 \u05de\u05e9\u05ea\u05d5\u05dc\u05dc\u05d9\u05dd",
 "CAP_S04_02": "\u05d4\u05d0\u05de\u05d0 \u05e2\u05d9\u05d9\u05e4\u05d4 \u05de\u05d0\u05d5\u05d3",
 "CAP_S04_03": "\u05de\u05d2\u05d9\u05e2 \u05d4\u05e9\u05d5\u05d7\u05d8",
 "CAP_S04_04": "\u05d5\u05d4\u05d0\u05de\u05d0 \u05d4\u05d5\u05dc\u05db\u05ea \u05d0\u05d9\u05ea\u05d5 \u05dc\u05de\u05e9\u05d7\u05d8\u05d4",
 "CAP_S04_05": "\u05d4\u05d9\u05d5\u05dd \u2014 \u05e8\u05e7 \u05d4\u05d0\u05de\u05d0",
 "CAP_S04_06": "\u05d5\u05d4\u05d9\u05d0 \u05e2\u05d5\u05dc\u05d4 \u05dc\u05d2\u05df \u05e2\u05d3\u05df \u05d5\u05e0\u05d7\u05d4 \u05e1\u05d5\u05e3 \u05e1\u05d5\u05e3",
 "CAP_S04_07": "\u05d9\u05d5\u05dd \u05d0\u05d7\u05e8 \u05db\u05da...",
 "CAP_S04_08": "\u05de\u05d2\u05d9\u05e2\u05d9\u05dd \u05d0\u05dc\u05d9\u05d4 \u05d2\u05dd \u05d4\u05e2\u05d2\u05dc\u05d9\u05dd",
 "CAP_S04_09": "\u05d4\u05dd \u05e0\u05e9\u05d7\u05d8\u05d5 \u05e8\u05e7 \u05dc\u05de\u05d7\u05e8\u05ea \u2014 \u05d5\u05d6\u05d4 \u05de\u05d5\u05ea\u05e8",
 "CAP_S05_Q": "\u05e9\u05d7\u05d8\u05d5 \u05e4\u05e8\u05d4 \u05d1\u05d1\u05d5\u05e7\u05e8, \u05d5\u05d0\u05ea \u05d4\u05e2\u05d2\u05dc \u05e9\u05dc\u05d4 \u05d1\u05e6\u05d4\u05e8\u05d9\u05d9\u05dd. \u05de\u05d5\u05ea\u05e8?",
 "CAP_S05_A": "\u05dc\u05d0. \u05d6\u05d4 \u05d0\u05d5\u05ea\u05d5 \u05d9\u05d5\u05dd \u2014 \u05d5\u05d0\u05e1\u05d5\u05e8 \u05dc\u05e9\u05d7\u05d5\u05d8 \u05d0\u05d5\u05ea\u05d5 \u05d5\u05d0\u05ea \u05d1\u05e0\u05d5 \u05d1\u05d9\u05d5\u05dd \u05d0\u05d7\u05d3",
 "LBL_S05_ANS": "\u05ea\u05e9\u05d5\u05d1\u05d4",
 "CAP_S06_Q": "\u05e9\u05d7\u05d8\u05d5 \u05e4\u05e8\u05d4 \u05d4\u05d9\u05d5\u05dd, \u05d5\u05d0\u05ea \u05d4\u05e2\u05d2\u05dc \u05e9\u05dc\u05d4 \u05de\u05d7\u05e8. \u05de\u05d5\u05ea\u05e8?",
 "CAP_S06_A": "\u05db\u05df. \u05d4\u05d0\u05d9\u05e1\u05d5\u05e8 \u05d4\u05d5\u05d0 \u05e8\u05e7 \u05d1\u05d9\u05d5\u05dd \u05d0\u05d7\u05d3",
 "LBL_S06_ANS": "\u05ea\u05e9\u05d5\u05d1\u05d4",
 "CAP_S07_Q": "\u05d5\u05d0\u05dd \u05e9\u05d7\u05d8\u05d5 \u05e7\u05d5\u05d3\u05dd \u05d0\u05ea \u05d4\u05e2\u05d2\u05dc, \u05d5\u05d0\u05d7\u05e8 \u05db\u05da \u05d0\u05ea \u05d0\u05de\u05d5 \u2014 \u05d1\u05d0\u05d5\u05ea\u05d5 \u05d9\u05d5\u05dd?",
 "CAP_S07_A": "\u05d2\u05dd \u05d0\u05e1\u05d5\u05e8. \u05dc\u05d0 \u05de\u05e9\u05e0\u05d4 \u05de\u05d9 \u05e0\u05e9\u05d7\u05d8 \u05e8\u05d0\u05e9\u05d5\u05df",
 "LBL_S07_ANS": "\u05ea\u05e9\u05d5\u05d1\u05d4",
 "CAP_S08": "\u05d4\u05d0\u05d9\u05e1\u05d5\u05e8 \u2014 \u05d1\u05d0\u05de\u05d0 \u05d5\u05d1\u05e0\u05d4",
 "LBL_S08_KICK": "\u05d5\u05de\u05d4 \u05e2\u05dd \u05d4\u05d0\u05d1\u05d0?",
 "LBL_S08_SUB": "\u05dc\u05d4\u05dc\u05db\u05d4: \u05dc\u05d0 \u05d1\u05d0\u05d1\u05d0",
 "CAP_S09_01": "\u05d4\u05d0\u05d1\u05d0 \u05e9\u05d5\u05d0\u05dc: \u05de\u05d4 \u05e9\u05de\u05da?",
 "CAP_S09_02": "\u05d5\u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05e8\u05e6\u05d9\u05dd \u2014 \u05dc\u05d0\u05de\u05d0",
 "CAP_S09_03": "\u05d0\u05e6\u05dc \u05d1\u05d4\u05de\u05d5\u05ea, \u05d4\u05e7\u05e9\u05e8 \u05d4\u05d5\u05d0 \u05dc\u05d0\u05de\u05d0",
 "CAP_S10": "\"\u05d0\u05ea \u05d0\u05de\u05d4 \u05de\u05db\u05e8\u05ea\u05d9 \u05dc\u05e9\u05d7\u05d5\u05d8\"",
 "LBL_S10_KICK": "\u05d1\u05de\u05e9\u05e0\u05d4",
 "LBL_S10_SUB": "\u05d0\u05e8\u05d1\u05e2 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05e0\u05d4",
 "CAP_S11": "\u05d1\u05d0\u05e8\u05d1\u05e2\u05d4 \u05e4\u05e8\u05e7\u05d9\u05dd \u05d1\u05e9\u05e0\u05d4, \u05d4\u05de\u05d5\u05db\u05e8 \u05d1\u05d4\u05de\u05d4 \u05dc\u05d7\u05d1\u05d9\u05e8\u05d5 \u05e6\u05e8\u05d9\u05da \u05dc\u05d4\u05d5\u05d3\u05d9\u05e2\u05d5: \u05d0\u05de\u05d4 \u05de\u05db\u05e8\u05ea\u05d9 \u05dc\u05e9\u05d7\u05d5\u05d8",
 "LBL_S11_REF": "\u05de\u05e9\u05e0\u05d4 \u05d7\u05d5\u05dc\u05d9\u05df \u05d4, \u05d2",
 "CAP_S12": "\u05d1\u05e2\u05e8\u05d1\u05d9 \u05d7\u05d2\u05d9\u05dd \u05db\u05d5\u05dc\u05dd \u05e9\u05d5\u05d7\u05d8\u05d9\u05dd",
 "LBL_S12_KICK": "\u05dc\u05de\u05d4 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d0\u05d6?",
 "LBL_S12_SUB": "\u05dc\u05e4\u05e0\u05d9 \u05e4\u05e1\u05d7, \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea, \u05e8\u05d0\u05e9 \u05d4\u05e9\u05e0\u05d4 \u05d5\u05e9\u05de\u05d9\u05e0\u05d9 \u05e2\u05e6\u05e8\u05ea",
 "CAP_S13_01": "\u05d0\u05e1\u05d5\u05e8 \u05dc\u05e9\u05d7\u05d5\u05d8 \u05d0\u05de\u05d0 \u05d5\u05d1\u05e0\u05d4 \u05d1\u05d9\u05d5\u05dd \u05d0\u05d7\u05d3",
 "CAP_S13_02": "\u05dc\u05de\u05d7\u05e8\u05ea \u2014 \u05de\u05d5\u05ea\u05e8",
 "CAP_S13_03": "\u05dc\u05d0 \u05de\u05e9\u05e0\u05d4 \u05de\u05d9 \u05e0\u05e9\u05d7\u05d8 \u05e8\u05d0\u05e9\u05d5\u05df",
 "CAP_S13_04": "\u05d4\u05d0\u05d9\u05e1\u05d5\u05e8 \u05d4\u05d5\u05d0 \u05d1\u05d0\u05de\u05d0 \u2014 \u05dc\u05d0 \u05d1\u05d0\u05d1\u05d0",
 "CAP_S13_05": "\u05d1\u05e2\u05e8\u05d1\u05d9 \u05d7\u05d2\u05d9\u05dd \u2014 \u05d4\u05de\u05d5\u05db\u05e8 \u05e6\u05e8\u05d9\u05da \u05dc\u05d4\u05d5\u05d3\u05d9\u05e2",
 "LBL_SUMMARY": "\u05de\u05d4 \u05dc\u05de\u05d3\u05e0\u05d5?",
 "CAP_S14_01": "\u05e7\u05d8\u05e2\u05d9 \u05d4\u05d4\u05e0\u05e4\u05e9\u05d4: \u05e8\u05f3 \u05d0\u05dc\u05d9 \u05e1\u05d8\u05e4\u05e0\u05e1\u05e7\u05d9 \u00b7 \u05de\u05e8\u05db\u05d6 \u05d3\u05e3 \u05d9\u05d5\u05de\u05d9 \u00b7 MDY",
 "CAP_S14_02": "\u05de\u05e0\u05d2\u05d9\u05e0\u05d4 \u05de\u05e7\u05d5\u05e8\u05d9\u05ea \u00b7 \u05e2\u05e8\u05d9\u05db\u05d4: \u05de\u05db\u05d9\u05e0\u05ea \u05d1\u05d9\u05ea \u05d4\u05ea\u05dc\u05de\u05d5\u05d3"
