{
 "G_CAP_01": "\u05d4\u05e7\u05d3\u05d5\u05e9 \u05d1\u05e8\u05d5\u05da \u05d4\u05d5\u05d0 \u05de\u05db\u05e0\u05d9\u05e1 \u05d0\u05ea \u05d4\u05d2\u05d5\u05e3 \u05d1\u05ea\u05d5\u05da \u05d4\u05d0\u05d3\u05de\u05d4, \u05de\u05d5\u05e6\u05d9\u05d0 \u05de\u05de\u05e0\u05d5 \u05e2\u05dc \u05d9\u05d3\u05d9",
 "G_CAP_04": "\u05d4\u05de\u05d9\u05ea\u05d4 \u05d0\u05ea \u05d6\u05d5\u05d4\u05de\u05ea \u05d4\u05e0\u05d7\u05e9. \u05dc\u05db\u05df \u05d7\u05d9\u05d9\u05d1 \u05e9\u05d0\u05d3\u05dd \u05d9\u05de\u05d5\u05ea, \u05d6\u05d4 \u05dc\u05d0 \u05e2\u05d5\u05e0\u05e9.",
 "G_CAP_07": "\u05d6\u05d4 \u05dc\u05d0 \u05e2\u05d5\u05e0\u05e9, \u05d6\u05d4 \u05de\u05ea\u05e0\u05d4. \u05d5\u05d0\u05d6 \u05d4\u05d2\u05d5\u05e3 \u05d9\u05e7\u05d5\u05dd \u05d6\u05da \u05d9\u05d5\u05ea\u05e8,",
 "G_CAP_10": "\u05d5\u05d0\u05d6 \u05d4\u05e0\u05e9\u05de\u05d4 \u05ea\u05d5\u05db\u05dc \u05dc\u05d4\u05d9\u05db\u05e0\u05e1 \u05d1\u05d5 \u05d7\u05d6\u05e8\u05d4, \u05d5\u05d1\u05d9\u05d7\u05d3 \u05d4\u05dd \u05d9\u05d6\u05db\u05d5 \u05dc\u05db\u05dc \u05d4\u05e0\u05d5\u05e2\u05dd.",
 "CAP_01": "\u05d4\u05e7\u05d3\u05d5\u05e9 \u05d1\u05e8\u05d5\u05da \u05d4\u05d5\u05d0 \u05de\u05db\u05e0\u05d9\u05e1",
 "CAP_02": "\u05d0\u05ea \u05d4\u05d2\u05d5\u05e3 \u05d1\u05ea\u05d5\u05da \u05d4\u05d0\u05d3\u05de\u05d4,",
 "CAP_03": "\u05de\u05d5\u05e6\u05d9\u05d0 \u05de\u05de\u05e0\u05d5 \u05e2\u05dc \u05d9\u05d3\u05d9",
 "CAP_04": "\u05d4\u05de\u05d9\u05ea\u05d4 \u05d0\u05ea \u05d6\u05d5\u05d4\u05de\u05ea \u05d4\u05e0\u05d7\u05e9.",
 "CAP_05": "\u05dc\u05db\u05df \u05d7\u05d9\u05d9\u05d1 \u05e9\u05d0\u05d3\u05dd \u05d9\u05de\u05d5\u05ea,",
 "CAP_06": "\u05d6\u05d4 \u05dc\u05d0 \u05e2\u05d5\u05e0\u05e9.",
 "CAP_07": "\u05d6\u05d4 \u05dc\u05d0 \u05e2\u05d5\u05e0\u05e9,",
 "CAP_08": "\u05d6\u05d4 \u05de\u05ea\u05e0\u05d4.",
 "CAP_09": "\u05d5\u05d0\u05d6 \u05d4\u05d2\u05d5\u05e3 \u05d9\u05e7\u05d5\u05dd \u05d6\u05da \u05d9\u05d5\u05ea\u05e8,",
 "CAP_10": "\u05d5\u05d0\u05d6 \u05d4\u05e0\u05e9\u05de\u05d4 \u05ea\u05d5\u05db\u05dc",
 "CAP_11": "\u05dc\u05d4\u05d9\u05db\u05e0\u05e1 \u05d1\u05d5 \u05d7\u05d6\u05e8\u05d4,",
 "CAP_12": "\u05d5\u05d1\u05d9\u05d7\u05d3 \u05d4\u05dd \u05d9\u05d6\u05db\u05d5 \u05dc\u05db\u05dc \u05d4\u05e0\u05d5\u05e2\u05dd.",
