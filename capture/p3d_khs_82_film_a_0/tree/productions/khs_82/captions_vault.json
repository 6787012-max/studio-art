{
 "CAP_A_01": "\u05d4\u05ea\u05d5\u05e8\u05d4 \u05db\u05d1\u05e8 \u05e0\u05de\u05e6\u05d0\u05ea \u05d7\u05e7\u05d5\u05e7\u05d4 \u05d1\u05ea\u05d5\u05db\u05e0\u05d5 \u05db\u05de\u05d5 \u05e9\u05d0\u05d1\u05e8\u05d4\u05dd \u05d0\u05d1\u05d9\u05e0\u05d5 \u05d9\u05d3\u05e2 \u05d0\u05ea \u05db\u05dc \u05d4\u05ea\u05d5\u05e8\u05d4 \u05d1\u05ea\u05d5\u05da \u05e2\u05e6\u05de\u05d5",
 "CAP_A_02": "\u05db\u05ea\u05d5\u05d1 \u05db\u05dc\u05d9\u05d5\u05ea\u05d9\u05d5 \u05e0\u05e2\u05e9\u05d5 \u05dc\u05d5 \u05e9\u05e0\u05d9 \u05e8\u05d1\u05e0\u05d9\u05dd \u05d0\u05d3\u05dd \u05de\u05ea\u05d5\u05da \u05e2\u05e6\u05de\u05d5 \u05d9\u05e9 \u05d0\u05ea \u05d4\u05db\u05dc. \u05dc\u05de\u05d4 \u05d9\u05e9 \u05dc\u05d5 \u05d0\u05ea \u05d4\u05db\u05dc?",
 "CAP_A_03": "\u05db\u05d9 \u05d0\u05d3\u05dd \u05d9\u05e9 \u05dc\u05d5 \u05e0\u05e9\u05de\u05d4. \u05d5\u05d4\u05e0\u05e9\u05de\u05d4 \u05d4\u05d6\u05d0\u05ea \u05d4\u05d9\u05d0 \u05de\u05d7\u05d5\u05d1\u05e8\u05ea \u05dc\u05e7\u05d3\u05d5\u05e9 \u05d1\u05e8\u05d5\u05da \u05d4\u05d5\u05d0 \u05d0\u05d6 \u05de\u05de\u05d9\u05dc\u05d0 \u05d0\u05d3\u05dd \u05de\u05e6\u05d3 \u05e0\u05e9\u05de\u05ea\u05d5 \u05d9\u05d5\u05d3\u05e2 \u05d0\u05ea \u05d4\u05db\u05dc.",
 "CAP_A_04": "\u05d0\u05dc\u05d0 \u05de\u05d4? \u05d9\u05e9 \u05dc\u05e0\u05d5 \u05d4\u05e8\u05d1\u05d4 \u05d4\u05e8\u05d1\u05d4 \u05d4\u05e1\u05ea\u05e8\u05d9\u05dd. \u05d0\u05d6 \u05d0\u05e0\u05d7\u05e0\u05d5 \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05dc\u05dc\u05de\u05d5\u05d3 \u05d0\u05ea \u05d6\u05d4 \u05de\u05d1\u05d7\u05d5\u05e5.",
 "CAP_A_05": "\u05dc\u05e9\u05d7\u05d6\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05d7\u05d5\u05e5 \u05d0\u05ea \u05de\u05d4 \u05e9\u05d9\u05e9 \u05dc\u05e0\u05d5 \u05d1\u05e4\u05e0\u05d9\u05dd. \u05e9\u05d0\u05d3\u05dd \u05dc\u05d5\u05de\u05d3\u05d9\u05dd \u05d0\u05d9\u05ea\u05d5 \u05d0\u05ea \u05db\u05dc \u05d4\u05ea\u05d5\u05e8\u05d4",
 "CAP_A_06": "\u05d1\u05d1\u05d8\u05df \u05d0\u05de\u05d5 \u05d5\u05de\u05e9\u05db\u05d7\u05d9\u05dd \u05d0\u05d5\u05ea\u05d5. \u05dc\u05de\u05d4? \u05db\u05d3\u05d9 \u05e9\u05d4\u05d5\u05d0 \u05d9\u05d7\u05d6\u05d5\u05e8 \u05dc\u05de\u05d4 \u05e9\u05d4\u05d5\u05d0 \u05db\u05d1\u05e8 \u05dc\u05de\u05d3.",
 "CAP_A_07": "\u05d0\u05e3 \u05d0\u05d7\u05d3 \u05dc\u05d0 \u05dc\u05d5\u05de\u05d3 \u05d3\u05d1\u05e8 \u05d7\u05d3\u05e9. \u05e9\u05d0\u05dd \u05d0\u05d3\u05dd \u05dc\u05d0 \u05d4\u05d9\u05d4 \u05dc\u05d5\u05de\u05d3 \u05d1\u05d1\u05d8\u05df \u05d0\u05de\u05d5 \u05d0\u05ea \u05db\u05dc \u05d4\u05ea\u05d5\u05e8\u05d4 \u05db\u05d5\u05dc\u05d4",
 "CAP_A_08": "\u05dc\u05d0 \u05d9\u05e9 \u05dc\u05da \u05d1\u05db\u05dc\u05dc \u05dc\u05dc\u05de\u05d5\u05d3 \u05d0\u05ea \u05d6\u05d4 \u05d0\u05d9 \u05d0\u05e4\u05e9\u05e8 \u05d0\u05dd \u05d6\u05d5 \u05e4\u05e2\u05dd \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e7\u05d5\u05d3\u05dd \u05db\u05dc \u05e6\u05e8\u05d9\u05da \u05e9\u05de\u05dc\u05d0\u05da \u05d9\u05dc\u05de\u05d3 \u05d0\u05d5\u05ea\u05da",
 "CAP_A_09": "\u05d0\u05d7\u05e8\u05d9 \u05d6\u05d4 \u05e9\u05db\u05d7\u05ea \u05d0\u05d6 \u05d9\u05e9 \u05dc\u05da \u05d0\u05ea \u05d6\u05d4 \u05d1\u05e4\u05e0\u05d9\u05dd \u05e7\u05d5\u05e8\u05d0\u05d9\u05dd \u05dc\u05d6\u05d4 \u05db\u05de\u05d5 \u05d0\u05d9\u05d6\u05d4 \u05e8\u05e9\u05d9\u05de\u05d5 \u05de\u05e9\u05d4\u05d5 \u05de\u05d5\u05db\u05e8 \u05dc\u05da",
 "CAP_A_10": "\u05d5\u05d6\u05d4 \u05e9\u05e2\u05db\u05e9\u05d9\u05d5 \u05d0\u05ea\u05d4 \u05d1\u05e2\u05d5\u05dc\u05dd \u05d4\u05d6\u05d4 \u05d0\u05ea\u05d4 \u05de\u05e0\u05e1\u05d4 \u05dc\u05dc\u05de\u05d5\u05d3 \u05d7\u05d6\u05e8\u05d4 \u05d0\u05ea \u05d6\u05d4",
 "CAP_A_11": "\u05d6\u05d4 \u05db\u05db\u05d4 \u05d0\u05e0\u05d7\u05e0\u05d5 \u05dc\u05d5\u05de\u05d3\u05d9\u05dd \u05ea\u05d5\u05e8\u05d4. \u05dc\u05d5\u05e7\u05d7 \u05d2\u05d9\u05dc \u05e2\u05d3 \u05e9\u05d0\u05d3\u05dd \u05ea\u05d5\u05e4\u05e1 \u05d0\u05d9\u05e4\u05d4 \u05d4\u05e0\u05e7\u05d5\u05d3\u05d4 \u05e9\u05dc\u05d5",
 "CAP_A_12": "\u05db\u05dc \u05d0\u05d7\u05d3 \u05e8\u05d5\u05d0\u05d4 \u05d0\u05ea \u05d4\u05d7\u05dc\u05e7 \u05d4\u05de\u05d9\u05d5\u05d7\u05d3 \u05e9\u05dc\u05d5 \u05d1\u05ea\u05d5\u05e8\u05d4 \u05de\u05d0\u05d9\u05e4\u05d4 \u05d6\u05d4 \u05d4\u05d7\u05dc\u05e7 \u05d4\u05d6\u05d4",
 "CAP_A_13": "\u05d6\u05d4 \u05d7\u05dc\u05e7 \u05e9\u05db\u05d1\u05e8 \u05e9\u05d9\u05d9\u05da \u05dc\u05d5 \u05de\u05e7\u05d5\u05d3\u05dd \u05dc\u05d0 \u05e9\u05e2\u05db\u05e9\u05d9\u05d5 \u05d4\u05d5\u05d0 \u05de\u05d2\u05dc\u05d4 \u05d0\u05ea \u05d6\u05d4 \u05de\u05de\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d0\u05de\u05e8\u05d9\u05e7\u05d4"
}
