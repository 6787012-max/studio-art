{
 "G_CAP_01": "\u05db\u05dc \u05d4\u05d7\u05d9\u05d9\u05dd \u05d0\u05e0\u05d7\u05e0\u05d5 \u05de\u05ea\u05e7\u05d3\u05de\u05d9\u05dd, \u05d0\u05de\u05d5\u05e8\u05d9\u05dd \u05dc\u05d4\u05ea\u05e7\u05d3\u05dd. \u05de\u05d9 \u05e9\u05db\u05dc \u05d4\u05d6\u05de\u05df \u05de\u05ea\u05d1\u05d5\u05e0\u05df, \u05db\u05dc \u05d4\u05d6\u05de\u05df \u05de\u05ea\u05e7\u05d3\u05dd.",
 "G_CAP_05": "\u05db\u05dc \u05d4\u05d6\u05de\u05df \u05d9\u05e9 \u05dc\u05d5 \u05d4\u05e9\u05d2\u05d5\u05ea \u05d7\u05d3\u05e9\u05d5\u05ea, \u05ea\u05e4\u05d9\u05e1\u05d4 \u05d7\u05d3\u05e9\u05d4. \u05d4\u05d5\u05d0 \u05dc\u05d0 \u05e0\u05e9\u05d0\u05e8 \u05d1\u05d2\u05d9\u05dc \u05e9\u05d4\u05d5\u05d0 \u05d4\u05d9\u05d4 \u05d1\u05d1\u05e8 \u05de\u05e6\u05d5\u05d5\u05d4.",
 "G_CAP_09": "\u05d0\u05d1\u05dc \u05d4\u05d4\u05e9\u05d2\u05d4 \u05e9\u05dc\u05da \u05de\u05e9\u05ea\u05e0\u05d4, \u05d4\u05d4\u05e9\u05d2\u05d4 \u05de\u05e9\u05ea\u05e0\u05d4.",
 "G_CAP_11": "\u05de\u05d9 \u05e9\u05de\u05ea\u05e4\u05dc\u05dc \u05d1\u05d2\u05d9\u05dc \u05e9\u05dc\u05d5\u05e9 \u05e2\u05e9\u05e8\u05d4 \u05d5\u05d1\u05d2\u05d9\u05dc \u05e9\u05d1\u05e2\u05d9\u05dd \u05d0\u05d5\u05ea\u05d4 \u05ea\u05e4\u05d9\u05dc\u05d4, \u05d0\u05d6 \u05d4\u05d5\u05d0 \u05e0\u05e9\u05d0\u05e8 \u05d9\u05dc\u05d3 \u05e7\u05d8\u05df.",
 "G_CAP_14": "\u05d4\u05d5\u05d0 \u05e6\u05e8\u05d9\u05da \u05dc\u05d4\u05ea\u05e4\u05dc\u05dc \u05ea\u05e4\u05d9\u05dc\u05d4 \u05d0\u05d7\u05e8\u05ea \u05dc\u05d2\u05de\u05e8\u05d9, \u05d0\u05dd \u05d4\u05d5\u05d0 \u05d9\u05ea\u05e7\u05d3\u05dd \u05d1\u05de\u05d1\u05d8",
 "G_CAP_16": "\u05d4\u05e8\u05d5\u05d7\u05e0\u05d9 \u05e9\u05dc\u05d5 \u05e2\u05dc \u05d4\u05d1\u05e8\u05d9\u05d0\u05d4. \u05dc\u05d0 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d9\u05d5\u05ea \u05e9\u05d4\u05d5\u05d0 \u05d9\u05ea\u05e4\u05dc\u05dc \u05db\u05de\u05d5 \u05d9\u05dc\u05d3 \u05d1\u05d1\u05e8 \u05de\u05e6\u05d5\u05d5\u05d4. \u05e0\u05db\u05d5\u05df? \u05d1\u05d1\u05e8 \u05de\u05e6\u05d5\u05d5\u05d4 \u05de\u05d4 \u05d4\u05d5\u05d0",
 "G_CAP_20": "\u05de\u05ea\u05e4\u05dc\u05dc? \u05de\u05ea\u05e4\u05dc\u05dc \u05db\u05d9 \u05db\u05d5\u05dc\u05dd \u05de\u05ea\u05e4\u05dc\u05dc\u05d9\u05dd. \u05d4\u05d5\u05d0 \u05dc\u05d0 \u05de\u05de\u05e9 \u05de\u05ea\u05e4\u05dc\u05dc. \u05d0\u05d1\u05dc \u05e2\u05dd \u05d4\u05d7\u05d9\u05d9\u05dd,",
 "G_CAP_23": "\u05d0\u05d3\u05dd \u05d0\u05de\u05d5\u05e8 \u05e9\u05d4\u05ea\u05e4\u05d9\u05dc\u05d4 \u05ea\u05d4\u05e4\u05d5\u05da \u05d9\u05d5\u05ea\u05e8 \u05d5\u05d9\u05d5\u05ea\u05e8 \u05d7\u05dc\u05e7 \u05de\u05d4\u05d7\u05d9\u05d9\u05dd \u05e9\u05dc\u05d5, \u05db\u05d9 \u05d4\u05d5\u05d0 \u05d7\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05d0\u05ea",
 "G_CAP_26": "\u05d4\u05e7\u05d3\u05d5\u05e9 \u05d1\u05e8\u05d5\u05da \u05d4\u05d5\u05d0, \u05d0\u05d6 \u05d4\u05d5\u05d0 \u05d9\u05d5\u05ea\u05e8 \u05de\u05e7\u05d5\u05e9\u05e8 \u05d0\u05dc\u05d9\u05d5. \u05ea\u05e4\u05d9\u05dc\u05d4 \u05d0\u05d7\u05e8\u05ea \u05dc\u05d2\u05de\u05e8\u05d9.",
 "LBL_A": "\u05d4\u05e9\u05d2\u05d4 \u05d7\u05d3\u05e9\u05d4",
 "LBL_B": "13",
 "LBL_C": "70",
 "LBL_D": "\u05d0\u05d5\u05ea\u05d4 \u05ea\u05e4\u05d9\u05dc\u05d4?",
 "LBL_E": "\u05ea\u05e4\u05d9\u05dc\u05d4 \u05d0\u05d7\u05e8\u05ea \u05dc\u05d2\u05de\u05e8\u05d9",
 "LBL_F": "\u05db\u05d9 \u05db\u05d5\u05dc\u05dd \u05de\u05ea\u05e4\u05dc\u05dc\u05d9\u05dd",
 "LBL_G": "\u05de\u05e7\u05d5\u05e9\u05e8"
}