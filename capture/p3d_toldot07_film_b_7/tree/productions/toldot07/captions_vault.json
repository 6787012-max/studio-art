{
 "TITLE": "\u05d2\u05dc\u05d9\u05dd: \u05de\u05d9 \u05de\u05d6\u05d9\u05d6 \u05d0\u05ea \u05d4\u05d9\u05dd?",
 "KICKER": "\u05e1\u05e8\u05d8\u05d5\u05df 2",
 "RECAP_1": "\u05d4\u05e8\u05d5\u05d7 \u05de\u05e8\u05d9\u05de\u05d4 \u05d0\u05ea \u05d4\u05d2\u05dc\u05d9\u05dd.",
 "RECAP_2": "\u05d1\u05d9\u05dd \u05d4\u05e4\u05ea\u05d5\u05d7 \u05d4\u05d2\u05dc \u05e8\u05e5, \u05d5\u05d4\u05de\u05d9\u05dd \u05e0\u05e9\u05d0\u05e8\u05d9\u05dd \u05d1\u05de\u05e7\u05d5\u05de\u05dd.",
 "RECAP_3": "\u05d4\u05d7\u05d5\u05dc \u05d4\u05d5\u05d0 \u05d4\u05d2\u05d1\u05d5\u05dc, \u05d5\u05d4\u05d9\u05dd \u05e9\u05d5\u05de\u05e8 \u05e2\u05dc\u05d9\u05d5.",
 "CAP_B_01": "\u05d1\u05d9\u05d5\u05dd \u05e9\u05e7\u05d8 \u05d4\u05d9\u05dd \u05d7\u05dc\u05e7 \u05db\u05de\u05e2\u05d8 \u05db\u05de\u05d5 \u05e8\u05d0\u05d9.",
 "CAP_B_02": "\u05d5\u05d1\u05d9\u05d5\u05dd \u05e9\u05dc \u05e8\u05d5\u05d7 \u05d4\u05d5\u05d0 \u05de\u05dc\u05d0 \u05d2\u05dc\u05d9\u05dd. \u05de\u05d9 \u05de\u05d6\u05d9\u05d6 \u05d0\u05d5\u05ea\u05d5?",
 "CAP_B_03": "\u05de\u05de\u05dc\u05d0\u05d9\u05dd \u05e7\u05e2\u05e8\u05d4 \u05d1\u05de\u05d9\u05dd \u05d5\u05e0\u05d5\u05e9\u05e4\u05d9\u05dd \u05e2\u05dc \u05e4\u05e0\u05d9\u05d4\u05dd.",
 "CAP_B_04": "\u05de\u05d9\u05d3 \u05e0\u05d5\u05dc\u05d3\u05d9\u05dd \u05d2\u05dc\u05d9\u05dd \u05e7\u05d8\u05e0\u05d9\u05dd, \u05d5\u05d4\u05dd \u05e8\u05e6\u05d9\u05dd \u05de\u05e6\u05d3 \u05dc\u05e6\u05d3.",
 "CAP_B_05": "\u05db\u05da \u05d2\u05dd \u05d1\u05d9\u05dd: \u05d4\u05e8\u05d5\u05d7 \u05d3\u05d5\u05d7\u05e4\u05ea \u05d0\u05ea \u05d4\u05de\u05d9\u05dd \u05d5\u05de\u05e8\u05d9\u05de\u05d4 \u05d0\u05d5\u05ea\u05dd \u05dc\u05d2\u05dc\u05d9\u05dd.",
 "LBL_B_01": "\u05e8\u05d5\u05d7",
 "CAP_B_06": "\u05db\u05db\u05dc \u05e9\u05d4\u05e8\u05d5\u05d7 \u05d7\u05d6\u05e7\u05d4 \u05d9\u05d5\u05ea\u05e8, \u05e0\u05d5\u05e9\u05d1\u05ea \u05d6\u05de\u05df \u05e8\u05d1 \u05d9\u05d5\u05ea\u05e8,",
 "CAP_B_07": "\u05d5\u05e2\u05d5\u05d1\u05e8\u05ea \u05d3\u05e8\u05da \u05d0\u05e8\u05d5\u05db\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05e2\u05dc \u05d4\u05d9\u05dd \u2014 \u05d4\u05d2\u05dc\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8.",
 "CAP_B_08": "\u05db\u05da \u05e0\u05d0\u05de\u05e8 \u05e2\u05dc \u05d9\u05d5\u05e8\u05d3\u05d9 \u05d4\u05d9\u05dd: \u05f3\u05d5\u05d9\u05e2\u05de\u05d3 \u05e8\u05d5\u05d7 \u05e1\u05e2\u05e8\u05d4 \u05d5\u05ea\u05e8\u05d5\u05de\u05dd \u05d2\u05dc\u05d9\u05d5\u05f3 (\u05ea\u05d4\u05dc\u05d9\u05dd \u05e7\u05d6, \u05db\u05d4).",
 "LBL_B_02": "\u05e8\u05d5\u05d7 \u05d7\u05d6\u05e7\u05d4",
 "LBL_B_03": "\u05d6\u05de\u05df \u05e8\u05d1",
 "LBL_B_04": "\u05d3\u05e8\u05da \u05d0\u05e8\u05d5\u05db\u05d4",
 "CAP_B_09": "\u05d5\u05d9\u05e9 \u05d2\u05dc\u05d9\u05dd \u05d1\u05d7\u05d5\u05e3 \u05d2\u05dd \u05db\u05e9\u05d4\u05d0\u05d5\u05d5\u05d9\u05e8 \u05e2\u05d5\u05de\u05d3?",
 "CAP_B_10": "\u05d4\u05dd \u05e0\u05d5\u05dc\u05d3\u05d5 \u05de\u05e8\u05d5\u05d7 \u05e9\u05e0\u05e9\u05d1\u05d4 \u05e8\u05d7\u05d5\u05e7 \u05d1\u05d9\u05dd, \u05d0\u05d5\u05dc\u05d9 \u05d0\u05ea\u05de\u05d5\u05dc,",
 "CAP_B_11": "\u05d5\u05e8\u05e6\u05d5 \u05de\u05d0\u05d5\u05ea \u05e7\u05d9\u05dc\u05d5\u05de\u05d8\u05e8\u05d9\u05dd \u05e2\u05d3 \u05d0\u05dc\u05d9\u05e0\u05d5.",
 "LBL_B_05": "\u05d0\u05ea\u05de\u05d5\u05dc",
 "CAP_B_12": "\u05d4\u05d0\u05dd \u05d4\u05d2\u05dc \u05de\u05d1\u05d9\u05d0 \u05d0\u05d9\u05ea\u05d5 \u05de\u05d9\u05dd \u05de\u05e8\u05d7\u05d5\u05e7?",
 "CAP_B_13": "\u05d1\u05e7\u05d1\u05d5\u05e7 \u05e8\u05d9\u05e7 \u05e6\u05e3 \u05d1\u05d9\u05dd \u05e4\u05ea\u05d5\u05d7. \u05d2\u05dc \u05de\u05d2\u05d9\u05e2 \u2014 \u05d5\u05d4\u05d1\u05e7\u05d1\u05d5\u05e7 \u05e2\u05d5\u05dc\u05d4.",
 "CAP_B_14": "\u05d4\u05d2\u05dc \u05e2\u05d5\u05d1\u05e8 \u2014 \u05d5\u05d4\u05d1\u05e7\u05d1\u05d5\u05e7 \u05d9\u05d5\u05e8\u05d3, \u05d5\u05db\u05de\u05e2\u05d8 \u05dc\u05d0 \u05d6\u05d6 \u05de\u05de\u05e7\u05d5\u05de\u05d5.",
 "LBL_B_06": "\u05d2\u05dc",
 "CAP_B_15": "\u05d4\u05d2\u05dc \u05e2\u05d5\u05d1\u05e8 \u05de\u05d1\u05e7\u05d1\u05d5\u05e7 \u05dc\u05d1\u05e7\u05d1\u05d5\u05e7,",
 "CAP_B_16": "\u05d5\u05d4\u05de\u05d9\u05dd \u05e2\u05e6\u05de\u05dd \u05e0\u05e9\u05d0\u05e8\u05d9\u05dd \u05db\u05de\u05e2\u05d8 \u05d1\u05de\u05e7\u05d5\u05de\u05dd \u2014",
 "CAP_B_17": "\u05e8\u05e7 \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4 \u05e2\u05d5\u05d1\u05e8\u05ea \u05d1\u05d4\u05dd \u05d4\u05dc\u05d0\u05d4.",
 "CAP_B_18": "\u05e8\u05d1\u05df \u05d2\u05de\u05dc\u05d9\u05d0\u05dc \u05e8\u05d0\u05d4 \u05e1\u05e4\u05d9\u05e0\u05d4 \u05e0\u05e9\u05d1\u05e8\u05ea \u05d1\u05d9\u05dd \u05d5\u05d4\u05e6\u05d8\u05e2\u05e8 \u05e2\u05dc \u05e8\u05d1\u05d9 \u05e2\u05e7\u05d9\u05d1\u05d0 \u05e9\u05d4\u05d9\u05d4 \u05d1\u05d4.",
 "CAP_B_19": "\u05db\u05e9\u05e2\u05dc\u05d4 \u05dc\u05d7\u05d5\u05e3 \u05e1\u05d9\u05e4\u05e8 \u05e8\u05d1\u05d9 \u05e2\u05e7\u05d9\u05d1\u05d0: \u05f3\u05d3\u05e3 \u05e9\u05dc \u05e1\u05e4\u05d9\u05e0\u05d4 \u05e0\u05d6\u05d3\u05de\u05df \u05dc\u05d9,\u05f3",
 "CAP_B_20": "\u05f3\u05d5\u05db\u05dc \u05d2\u05dc \u05d5\u05d2\u05dc \u05e9\u05d1\u05d0 \u05e2\u05dc\u05d9 \u2014 \u05e0\u05e2\u05e0\u05e2\u05ea\u05d9 \u05dc\u05d5 \u05e8\u05d0\u05e9\u05d9\u05f3 (\u05d9\u05d1\u05de\u05d5\u05ea \u05e7\u05db\u05d0 \u05e2\u05f4\u05d0).",
 "CAP_B_21": "\u05d4\u05d2\u05dc \u05e2\u05d1\u05e8 \u2014 \u05d5\u05d4\u05d5\u05d0 \u05e0\u05e9\u05d0\u05e8, \u05db\u05de\u05d5 \u05d4\u05d1\u05e7\u05d1\u05d5\u05e7.",
 "CAP_B_22": "\u05dc\u05d9\u05d3 \u05d4\u05d7\u05d5\u05e3 \u05d4\u05de\u05d9\u05dd \u05e8\u05d3\u05d5\u05d3\u05d9\u05dd,",
 "CAP_B_23": "\u05ea\u05d7\u05ea\u05d9\u05ea \u05d4\u05d2\u05dc \u05de\u05ea\u05d7\u05db\u05db\u05ea \u05d1\u05e7\u05e8\u05e7\u05e2\u05d9\u05ea \u05d5\u05de\u05d0\u05d8\u05d4,",
 "CAP_B_24": "\u05d5\u05e8\u05d0\u05e9\u05d5 \u05de\u05de\u05e9\u05d9\u05da \u05e7\u05d3\u05d9\u05de\u05d4, \u05de\u05ea\u05e2\u05d2\u05dc, \u05e0\u05d5\u05e4\u05dc \u05d5\u05de\u05ea\u05e0\u05e4\u05e5 \u05dc\u05e7\u05e6\u05e3 \u05dc\u05d1\u05df.",
 "CAP_B_25": "\u05dc\u05d2\u05dc \u05e9\u05e0\u05e9\u05d1\u05e8 \u05db\u05da \u05e7\u05d5\u05e8\u05d0\u05d9\u05dd \u05de\u05b4\u05e9\u05b0\u05c1\u05d1\u05b8\u05bc\u05e8: \u05f3\u05de\u05e9\u05d1\u05e8\u05d9 \u05d9\u05dd\u05f3 (\u05ea\u05d4\u05dc\u05d9\u05dd \u05e6\u05d2, \u05d3).",
 "LBL_B_07": "\u05de\u05b4\u05e9\u05b0\u05c1\u05d1\u05b8\u05bc\u05e8",
 "CAP_B_26": "\u05de\u05d4 \u05e2\u05d5\u05e6\u05e8 \u05d0\u05ea \u05d4\u05d2\u05dc\u05d9\u05dd \u05d1\u05d7\u05d5\u05e3, \u05d2\u05dd \u05d0\u05ea \u05d4\u05d2\u05d3\u05d5\u05dc\u05d9\u05dd \u05e9\u05d1\u05d4\u05dd?",
 "CAP_B_27": "\u05d0\u05d9\u05df \u05e9\u05dd \u05d7\u05d5\u05de\u05d4 \u05d5\u05d0\u05d9\u05df \u05e9\u05dd \u05e7\u05d9\u05e8 \u2014 \u05e8\u05e7 \u05d2\u05e8\u05d2\u05d9\u05e8\u05d9 \u05d7\u05d5\u05dc \u05e7\u05d8\u05e0\u05d9\u05dd.",
 "CAP_B_28": "\u05d4\u05d2\u05dc \u05de\u05d0\u05d1\u05d3 \u05db\u05d5\u05d7, \u05de\u05d9\u05de\u05d9\u05d5 \u05e0\u05e1\u05e4\u05d2\u05d9\u05dd \u05d1\u05d7\u05d5\u05dc, \u05d5\u05d4\u05d9\u05dd \u05e0\u05e1\u05d5\u05d2.",
 "LBL_B_08": "\u05d7\u05d5\u05dc",
 "CAP_B_29": "\u05f3\u05d0\u05e9\u05e8 \u05e9\u05de\u05ea\u05d9 \u05d7\u05d5\u05dc \u05d2\u05d1\u05d5\u05dc \u05dc\u05d9\u05dd... \u05d5\u05d4\u05de\u05d5 \u05d2\u05dc\u05d9\u05d5 \u05d5\u05dc\u05d0 \u05d9\u05e2\u05d1\u05e8\u05e0\u05d4\u05d5\u05f3 (\u05d9\u05e8\u05de\u05d9\u05d4\u05d5 \u05d4, \u05db\u05d1).",
 "CAP_B_30": "\u05d4\u05d7\u05d5\u05dc \u05d4\u05e8\u05da \u05d4\u05d5\u05d0 \u05d4\u05d2\u05d1\u05d5\u05dc, \u05d5\u05d4\u05d9\u05dd \u05d4\u05d2\u05d3\u05d5\u05dc \u05e9\u05d5\u05de\u05e8 \u05e2\u05dc\u05d9\u05d5.",
 "CAP_B_31": "\u05e8\u05e9\u05f4\u05d9 \u05de\u05e1\u05d1\u05d9\u05e8 \u05e9\u05d4\u05d9\u05dd \u05d0\u05d9\u05df \u05dc\u05d5 \u05e9\u05db\u05e8 \u05d5\u05d0\u05d9\u05df \u05dc\u05d5 \u05e2\u05d5\u05e0\u05e9, \u05d5\u05d1\u05db\u05dc \u05d6\u05d0\u05ea \u05d4\u05d5\u05d0 \u05d9\u05e8\u05d0 \u05de\u05d4\u05f3 \u2014 \u05e7\u05dc \u05d5\u05d7\u05d5\u05de\u05e8 \u05d4\u05d0\u05d3\u05dd.",
 "CAP_B_32": "\u05d7\u05d6\u05f4\u05dc \u05de\u05e1\u05e4\u05e8\u05d9\u05dd \u05e2\u05dc \u05d2\u05dc \u05e9\u05e8\u05e6\u05d4 \u05dc\u05e9\u05d8\u05d5\u05e3 \u05d0\u05ea \u05d4\u05e2\u05d5\u05dc\u05dd,",
 "CAP_B_33": "\u05d5\u05d2\u05dc \u05d0\u05d7\u05e8 \u05e2\u05e0\u05d4 \u05dc\u05d5: \u05f3\u05e6\u05d0 \u05d5\u05e8\u05d0\u05d4 \u05d0\u05ea \u05d2\u05d1\u05d5\u05e8\u05ea \u05d0\u05d3\u05d5\u05e0\u05da \u2014",
 "CAP_B_34": "\u05d0\u05e4\u05d9\u05dc\u05d5 \u05db\u05e8\u05d5\u05d7\u05d1 \u05d7\u05d5\u05d8 \u05d0\u05d7\u05d3 \u05d0\u05d9\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e2\u05d1\u05d5\u05e8 \u05d0\u05ea \u05d4\u05d7\u05d5\u05dc\u05f3 (\u05d1\u05d1\u05d0 \u05d1\u05ea\u05e8\u05d0 \u05e2\u05d2 \u05e2\u05f4\u05d0).",
 "CAP_B_35": "\u05d4\u05d0\u05dd \u05d4\u05d2\u05dc\u05d9\u05dd \u05ea\u05de\u05d9\u05d3 \u05d1\u05d0\u05d5\u05ea\u05d5 \u05d2\u05d5\u05d1\u05d4?",
 "CAP_B_36": "\u05d1\u05e7\u05d9\u05e5 \u05d4\u05e8\u05d5\u05d7 \u05e7\u05dc\u05d4 \u05d5\u05d4\u05d2\u05dc\u05d9\u05dd \u05e0\u05de\u05d5\u05db\u05d9\u05dd: \u05d7\u05e6\u05d9 \u05de\u05d8\u05e8, \u05dc\u05e4\u05e2\u05de\u05d9\u05dd \u05de\u05d8\u05e8.",
 "LBL_B_09": "\u05e7\u05d9\u05e5",
 "LBL_B_10": "\u05d7\u05e6\u05d9 \u05de\u05d8\u05e8",
 "CAP_B_37": "\u05d1\u05d7\u05d5\u05e8\u05e3 \u05d1\u05d0\u05d5\u05ea \u05de\u05df \u05d4\u05d9\u05dd \u05e1\u05e2\u05e8\u05d5\u05ea \u2014 \u05d0\u05d5\u05ea\u05df \u05e1\u05e2\u05e8\u05d5\u05ea \u05e9\u05de\u05d1\u05d9\u05d0\u05d5\u05ea \u05dc\u05e0\u05d5 \u05d2\u05e9\u05dd.",
 "CAP_B_38": "\u05d4\u05e8\u05d5\u05d7 \u05e0\u05d5\u05e9\u05d1\u05ea \u05de\u05e2\u05dc \u05de\u05d0\u05d5\u05ea \u05e7\u05d9\u05dc\u05d5\u05de\u05d8\u05e8\u05d9\u05dd \u05e9\u05dc \u05d9\u05dd \u05e4\u05ea\u05d5\u05d7, \u05d5\u05d4\u05d2\u05dc\u05d9\u05dd \u05d2\u05d3\u05dc\u05d9\u05dd \u05dc\u05e9\u05dc\u05d5\u05e9\u05d4 \u05d5\u05dc\u05d0\u05e8\u05d1\u05e2\u05d4 \u05de\u05d8\u05e8\u05d9\u05dd.",
 "CAP_B_39": "\u05d1\u05e1\u05e2\u05e8\u05d5\u05ea \u05d4\u05d7\u05d6\u05e7\u05d5\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05de\u05d3\u05d3\u05d5 \u05de\u05e6\u05d5\u05e4\u05d9\u05dd \u05de\u05d5\u05dc \u05d0\u05e9\u05d3\u05d5\u05d3 \u05d5\u05de\u05d5\u05dc \u05d7\u05d9\u05e4\u05d4 \u05d2\u05dc\u05d9\u05dd \u05e9\u05d2\u05d5\u05d1\u05d4\u05dd \u05d4\u05e8\u05d2\u05d9\u05dc \u05d9\u05d5\u05ea\u05e8 \u05de\u05e9\u05d9\u05e9\u05d4 \u05de\u05d8\u05e8\u05d9\u05dd \u2014 \u05db\u05d1\u05d9\u05ea \u05d1\u05df \u05e9\u05ea\u05d9 \u05e7\u05d5\u05de\u05d5\u05ea.",
 "CAP_B_40": "\u05d5\u05d2\u05dc \u05d1\u05d5\u05d3\u05d3 \u05d1\u05d9\u05e0\u05d9\u05d4\u05dd \u05d2\u05d1\u05d5\u05d4 \u05d0\u05e3 \u05db\u05de\u05e2\u05d8 \u05e4\u05d9 \u05e9\u05e0\u05d9\u05d9\u05dd.",
 "LBL_B_11": "\u05d7\u05d5\u05e8\u05e3",
 "CAP_B_41": "\u05d1\u05e1\u05e2\u05e8\u05d4 \u05db\u05d6\u05d0\u05ea, \u05d1\u05d7\u05d5\u05d3\u05e9 \u05d8\u05d1\u05ea \u05ea\u05e9\u05e2\u05f4\u05d0, \u05e9\u05d1\u05e8\u05d5 \u05d4\u05d2\u05dc\u05d9\u05dd \u05d7\u05dc\u05e7 \u05de\u05e7\u05d9\u05e8 \u05d0\u05d1\u05df \u05e2\u05d1\u05d4 \u05d1\u05d7\u05d5\u05e3 \u05e7\u05d9\u05e1\u05e8\u05d9\u05d4.",
 "CAP_B_42": "\u05dc\u05db\u05df \u05d1\u05d9\u05de\u05d9 \u05e1\u05e2\u05e8\u05d4 \u05dc\u05d0 \u05de\u05ea\u05e7\u05e8\u05d1\u05d9\u05dd \u05d0\u05dc \u05e7\u05d5 \u05d4\u05de\u05d9\u05dd.",
 "CAP_B_43": "\u05d3\u05d2\u05dc \u05e9\u05d7\u05d5\u05e8 \u05d1\u05d7\u05d5\u05e3 \u05e4\u05d9\u05e8\u05d5\u05e9\u05d5: \u05d0\u05d9\u05df \u05e0\u05db\u05e0\u05e1\u05d9\u05dd \u05dc\u05de\u05d9\u05dd.",
 "CAP_B_44": "\u05d5\u05d0\u05dd \u05e0\u05ea\u05e4\u05e1\u05d9\u05dd \u05d1\u05d6\u05e8\u05dd \u05e9\u05de\u05d5\u05e9\u05da \u05d4\u05d7\u05d5\u05e6\u05d4 \u2014 \u05e9\u05d5\u05d7\u05d9\u05dd \u05d4\u05e6\u05d9\u05d3\u05d4, \u05d1\u05de\u05e7\u05d1\u05d9\u05dc \u05dc\u05d7\u05d5\u05e3, \u05d5\u05dc\u05d0 \u05e0\u05d2\u05d3 \u05d4\u05d6\u05e8\u05dd.",
 "CAP_B_45": "\u05d1\u05d1\u05d5\u05e7\u05e8 \u05e9\u05dc \u05d9\u05d5\u05dd \u05e7\u05d9\u05e5 \u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05dc\u05e0\u05e9\u05d5\u05d1 \u05de\u05df \u05d4\u05d9\u05dd \u05e8\u05d5\u05d7 \u05e7\u05e8\u05d9\u05e8\u05d4 \u2014 \u05e8\u05d5\u05d7 \u05d4\u05d9\u05dd.",
 "CAP_B_46": "\u05dc\u05e7\u05e8\u05d0\u05ea \u05d4\u05e6\u05d4\u05e8\u05d9\u05d9\u05dd \u05d4\u05d9\u05d0 \u05de\u05d2\u05d9\u05e2\u05d4 \u05d0\u05dc \u05d1\u05d9\u05ea \u05e9\u05de\u05e9, \u05d5\u05d0\u05d7\u05e8 \u05d4\u05e6\u05d4\u05e8\u05d9\u05d9\u05dd \u05d2\u05dd \u05d0\u05dc \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd, \u05d5\u05de\u05e7\u05dc\u05d4 \u05e2\u05dc \u05d4\u05d7\u05d5\u05dd.",
 "LBL_B_12": "\u05d0\u05e9\u05d3\u05d5\u05d3",
 "LBL_B_13": "\u05d1\u05d9\u05ea \u05e9\u05de\u05e9",
 "LBL_B_14": "\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd",
 "LBL_TXT_01": "\u05de\u05e1\u05d1\u05d9\u05e8"
}
